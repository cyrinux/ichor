{
  "items": [
    {
      "metadata": {"name": "external-dns", "namespace": "external-dns"},
      "spec": {
        "replicas": 1,
        "template": {"spec": {"containers": [
          {"name": "external-dns", "image": "registry.k8s.io/external-dns/external-dns:v0.14.0",
           "args": ["--provider=cloudflare", "--policy=sync", "--registry=txt", "--txt-owner-id=homelab",
                    "--domain-filter=example.com", "--source=ingress", "--source=service",
                    "--source=crd", "--source=gateway-httproute", "--interval=30s"]}
        ]}}
      },
      "status": {"readyReplicas": 1}
    },
    {
      "metadata": {"name": "external-dns-legacy", "namespace": "dns-2"},
      "spec": {
        "replicas": 2,
        "template": {"spec": {"containers": [
          {"name": "external-dns", "image": "registry.k8s.io/external-dns/external-dns:v0.13.0",
           "args": ["--provider", "inmemory", "--dry-run", "--txt-owner-id", "legacy",
                    "--domain-filter", "example.org", "--annotation-filter", "app.kubernetes.io/managed-by=legacy"]}
        ]}}
      },
      "status": {"readyReplicas": 0}
    },
    {
      "metadata": {"name": "coredns", "namespace": "kube-system"},
      "spec": {
        "template": {"spec": {"containers": [
          {"name": "coredns", "image": "registry.k8s.io/coredns/coredns:v1.11.1", "args": ["-conf", "/etc/coredns/Corefile"]}
        ]}}
      },
      "status": {"readyReplicas": 1}
    }
  ]
}
