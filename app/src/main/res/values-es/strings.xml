    <!-- Help: creating a talosconfig -->
    <string name="help_title">Crear un talosconfig para este teléfono</string>
    <string name="help_intro">Genera una identidad dedicada en lugar de copiar tu ~/.talos/config de administrador: si pierdes el teléfono, su certificado solo concede lo que hayas elegido y caduca por sí solo.</string>
    <string name="help_role_reader">Solo lectura</string>
    <string name="help_role_reader_desc">Solo supervisión: resumen, servicios, recursos, registros, etcd, KubeSpan, gráficos en directo y alertas. Recomendado para un teléfono.</string>
    <string name="help_role_operator">Operador</string>
    <string name="help_role_operator_desc">Todo lo de solo lectura, además de reiniciar y apagar.</string>
    <string name="help_role_admin">Administrador</string>
    <string name="help_role_admin_desc">Todo, incluida la comprobación de estado del clúster, la exportación de kubeconfig y las shells de depuración. Trata el teléfono como un portátil.</string>
