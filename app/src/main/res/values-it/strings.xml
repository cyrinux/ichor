    <!-- Help: creating a talosconfig -->
    <string name="help_title">Crea un talosconfig per questo telefono</string>
    <string name="help_intro">Genera un\'identità dedicata invece di copiare il tuo ~/.talos/config amministratore: se perdi il telefono, il suo certificato concede solo ciò che hai scelto e scade da solo.</string>
    <string name="help_role_reader">Sola lettura</string>
    <string name="help_role_reader_desc">Solo monitoraggio: panoramica, servizi, risorse, log, etcd, KubeSpan, grafici live, avvisi. Consigliato per un telefono.</string>
    <string name="help_role_operator">Operatore</string>
    <string name="help_role_operator_desc">Tutto ciò che offre la sola lettura, più riavvio e spegnimento.</string>
    <string name="help_role_admin">Amministratore</string>
    <string name="help_role_admin_desc">Tutto, inclusi il controllo integrità del cluster, l\'esportazione del kubeconfig e le shell di debug. Tratta il telefono come un portatile.</string>
    <string name="help_step1">1. Sulla tua workstation, firma un certificato su un nodo control plane:</string>
    <string name="help_step2">2. Elenca tutti i nodi che l\'app deve mostrare:</string>
    <string name="help_step3">3. Trasferiscilo sul telefono, poi importalo qui:</string>
