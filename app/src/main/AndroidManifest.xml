<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake-on-LAN: find the Wi-Fi/Ethernet network to broadcast the magic packet on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: reach nodes on the Wi-Fi/Ethernet network (not needed over a VPN), and
         search it for a cluster's nodes. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps a debug shell open while the user is elsewhere, until they exit it, and follows
         a Talos upgrade to its end while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Self-update from GitHub releases (the user still confirms each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (API 30+) for the "Open kubenav" button. -->
    <queries>
        <package android:name="io.kubenav.kubenav" />
    </queries>

    <application
        android:name=".TalosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ichor">

        <!-- A browser sign-in coming back (ichor://signin, from a Web OAuth client's redirect
             page): handed to the sign-in in progress, which checks its state. -->
        <activity
            android:name=".SignInCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="signin" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="demo" />
            </intent-filter>
            <!-- A share link (see ui/share): the app's own scheme, and the website page that
                 forwards to it. The page is not a verified App Link (a project page cannot
                 serve /.well-known): Android 12+ opens it in the browser, whose page then
                 forwards to ichor://; older versions may offer the app directly. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="open" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cyrinux.github.io" android:pathPrefix="/ichor/open" />
            </intent-filter>
            <!-- A backup (.ichorbackup) opened from a file manager. Android knows no type for the
                 extension: providers give it as a generic binary, or name it in the path. The
                 file's header tells a backup from any other file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\..*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ichorbackup" />
            </intent-filter>
            <!-- A kubeconfig or talosconfig opened with the app or shared to it (mail, file
                 manager): it lands in the import preview. YAML types only, never all text: a
                 file named config or *.kubeconfig comes as a generic binary (above). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kubeconfig" />
                <data android:pathPattern=".*\\..*\\.kubeconfig" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
            </intent-filter>
            <!-- Shared: the file comes as EXTRA_STREAM, not as the intent's data, so no scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Shares saved packet captures with the app the user picks. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- A debug shell is an interactive terminal on a node: no other foreground service
             type fits it, and it runs only while the user keeps a shell open. -->
        <service
            android:name=".ui.debug.DebugShellService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an interactive debug shell (a remote terminal on a Talos node) open while the user switches screens or apps, until they exit it from the app or its notification." />
        </service>

        <!-- Following a Talos upgrade keeps the app talking to the node (install, reboot, wait
             for it to come back) for up to 30 minutes: no data is synced, so dataSync does not
             fit (and it is time-limited from API 35); it runs only while the upgrade does. -->
        <service
            android:name=".ui.upgrade.UpgradeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a Talos OS upgrade the user started on one of their nodes (install, reboot, wait for the node to come back) while they switch apps, so the upgrade is not cut off mid-install; it stops when the upgrade ends." />
        </service>

        <!-- Following a node maintenance (cordon, drain, reboot, wait for the node) keeps the app
             talking to the cluster while a drain waits for PodDisruptionBudgets; same reasons as
             the upgrade service, and it runs only while the maintenance does. -->
        <service
            android:name=".ui.maintenance.MaintenanceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a node maintenance the user started on one of their Talos nodes (cordon, drain its pods, reboot, wait for the node to come back) while they switch apps, so it is not cut off midway; it stops when the maintenance ends." />
        </service>

        <!-- A machine config tried on a node reverts by itself after 1 to 10 minutes unless the
             user keeps it: following the try keeps its countdown and the Keep button alive while
             they switch apps, and it runs only until the try is kept or reverted. -->
        <service
            android:name=".ui.machineconfig.ConfigTryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a machine configuration change the user is trying on one of their Talos nodes, which the node reverts by itself after 1 to 10 minutes unless kept, so the user can keep it from the notification after switching apps; it stops when the try is kept or reverted." />
        </service>

        <!-- Applying a machine config change to several nodes one after the other waits for each
             node to reboot in reboot mode, minutes per node; same reasons as the maintenance
             service, and it runs only while the rollout does. -->
        <service
            android:name=".ui.machineconfig.ConfigMultiService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a machine configuration change the user is applying to several of their Talos nodes one after the other (each may reboot and is waited for) while they switch apps, so the rollout is not cut off halfway; it stops when the rollout ends." />
        </service>

        <!-- A rolling upgrade of every node takes many minutes per node (drain, install, reboot,
             health gate); same reasons as the upgrade service, and it runs only while the roll
             does. -->
        <service
            android:name=".ui.upgrade.ClusterUpgradeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a Talos OS upgrade the user started on every node of their cluster, one node after the other (drain, install, reboot, health checks), while they switch apps, so the roll is not cut off halfway; it stops when the roll ends." />
        </service>

        <!-- A Kubernetes upgrade changes each control plane, then each node's kubelet, waiting for
             each one; same reasons as the upgrade service, and it runs only while it does. -->
        <service
            android:name=".ui.upgrade.K8sUpgradeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a Kubernetes version upgrade the user started on their Talos cluster (each control plane's components, then each node's kubelet, waited for one after the other) while they switch apps, so it is not cut off halfway; it stops when the upgrade ends." />
        </service>

        <!-- Pulling an image on every node before an upgrade keeps the app talking to the nodes
             for minutes on a slow link; same reasons as the maintenance service, and it runs
             only while the pull does. -->
        <service
            android:name=".ui.images.ImagePullService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a container image pull the user started on their Talos nodes (ahead of an upgrade) while they switch apps, so the download is not cut off midway; it stops when the pull ends." />
        </service>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- "+1 h" on the reminder before an Argo CD freeze ends. -->
        <receiver
            android:name=".monitor.FreezeExtendReceiver"
            android:exported="false" />

        <!-- Keep and Revert now on a machine config try's notification. -->
        <receiver
            android:name=".ui.machineconfig.ConfigTryActionReceiver"
            android:exported="false" />

        <!-- Snooze and Wake on an alert's notification. -->
        <receiver
            android:name=".monitor.AlertActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ClusterWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cluster_widget_info" />
        </receiver>

        <!-- Picks the cluster a widget shows (launched by the home screen only). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
