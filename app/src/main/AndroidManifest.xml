<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake-on-LAN: find the Wi-Fi/Ethernet network to broadcast the magic packet on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: reach nodes on the Wi-Fi/Ethernet network (not needed over a VPN), and
         search it for a cluster's nodes. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps a debug shell open while the user is elsewhere, until they exit it, and follows
         a Talos upgrade to its end while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Self-update from GitHub releases (the user still confirms each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- openInBrowser finds the default browser, so a GitHub issue form opens there rather
         than in the GitHub app, which drops the form. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".TalosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ichor">

        <!-- A browser sign-in coming back (ichor://signin, from a Web OAuth client's redirect
             page): handed to the sign-in in progress, which checks its state. -->
        <activity
            android:name=".SignInCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="signin" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="demo" />
            </intent-filter>
            <!-- A share link (see ui/share): the app's own scheme, and the website page that
                 forwards to it. The page is not a verified App Link (a project page cannot
                 serve /.well-known): Android 12+ opens it in the browser, whose page then
                 forwards to ichor://; older versions may offer the app directly. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ichor" android:host="open" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cyrinux.github.io" android:pathPrefix="/ichor/open" />
            </intent-filter>
            <!-- A backup (.ichorbackup) opened from a file manager. Android knows no type for the
                 extension: providers give it as a generic binary, or name it in the path. The
                 file's header tells a backup from any other file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\..*\\.ichorbackup" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ichorbackup" />
            </intent-filter>
            <!-- A kubeconfig or talosconfig opened with the app or shared to it (mail, file
                 manager): it lands in the import preview. YAML types only, never all text: a
                 file named config or *.kubeconfig comes as a generic binary (above). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kubeconfig" />
                <data android:pathPattern=".*\\..*\\.kubeconfig" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
            </intent-filter>
            <!-- Shared: the file comes as EXTRA_STREAM, not as the intent's data, so no scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- The static "Search clusters" launcher shortcut (one per build's applicationId). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Shares saved packet captures with the app the user picks. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- A debug shell is an interactive terminal on a node: no other foreground service
             type fits it, and it runs only while the user keeps a shell open. -->
        <service
            android:name=".ui.debug.DebugShellService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an interactive debug shell (a remote terminal on a Talos node) open while the user switches screens or apps, until they exit it from the app or its notification." />
        </service>

        <!-- Following a run the user started (a Talos or Kubernetes upgrade, a rolling cluster
             upgrade, a node maintenance, a node join, a machine config try or rollout, an image
             pull or vulnerability scan) keeps the app talking to the nodes or the cluster for
             minutes to half an hour: no data is synced, so dataSync does not fit (and it is
             time-limited from API 35). One service follows them all, one notification each, and
             runs only while one of them does. -->
        <service
            android:name=".ui.OperationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows the long operations the user started on their Talos or Kubernetes cluster while they switch apps or lock the screen, so they are not cut off midway: a Talos OS upgrade of one node or of every node one after the other (drain, install, reboot, wait for the node), a Kubernetes version upgrade, a node maintenance (cordon, drain, reboot), a new node joining the cluster, a machine configuration change tried on a node (which the node reverts by itself after 1 to 10 minutes unless kept from the notification) or applied to several nodes, a container image pull on the nodes, and a vulnerability scan of images in the cluster. Each shows its progress with Stop where possible; the service stops when they all end." />
        </service>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- "+1 h" on the reminder before an Argo CD freeze ends. -->
        <receiver
            android:name=".monitor.FreezeExtendReceiver"
            android:exported="false" />

        <!-- The buttons of a followed run's notification: Stop, Pause, Resume, Abort, Keep, Revert now. -->
        <receiver
            android:name=".ui.operations.OperationActionReceiver"
            android:exported="false" />

        <!-- Snooze and Wake on an alert's notification. -->
        <receiver
            android:name=".monitor.AlertActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ClusterWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cluster_widget_info" />
        </receiver>

        <!-- Picks the cluster a widget shows (launched by the home screen only). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
