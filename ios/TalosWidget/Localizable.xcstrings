{
  "sourceLanguage" : "en",
  "strings" : {
    "Says what Ichor's last background check saw on a cluster. None chosen: the one open in the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique ce que la dernière vérification en arrière-plan d’Ichor a vu sur un cluster. Aucun choisi : celui ouvert dans l’app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice lo que vio la última comprobación en segundo plano de Ichor en un clúster. Si no eliges ninguno: el que está abierto en la app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt, was Ichors letzte Hintergrundprüfung auf einem Cluster gesehen hat. Keiner gewählt: der in der App geöffnete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice cosa ha visto l’ultimo controllo in background di Ichor su un cluster. Nessuno scelto: quello aperto nell’app."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє, що побачила остання фонова перевірка Ichor у кластері. Якщо не вибрано: той, що відкритий у застосунку."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "告知 Ichor 上次后台检查在集群上看到的情况。未选择时：使用应用中打开的集群。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor の最新のバックグラウンドチェックでクラスターがどう見えたかを伝えます。未選択の場合：アプリで開いているクラスター。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Informa o que a última verificação em segundo plano do Ichor viu em um cluster. Nenhum escolhido: o que está aberto no app." } }
      }
    },
