    "Runs the image as a privileged container on %@, with host access, and opens a terminal in it. Talos pulls the image first if the node does not have it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet das Image als privilegierten Container auf %@ mit Host-Zugriff und öffnet darin ein Terminal. Talos lädt das Image zuerst, falls der Node es nicht hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta la imagen como contenedor privilegiado en %@, con acceso al host, y abre un terminal en él. Talos descarga primero la imagen si el nodo no la tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance l'image comme conteneur privilégié sur %@, avec accès à l'hôte, et y ouvre un terminal. Talos télécharge d'abord l'image si le nœud ne l'a pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue l'immagine come container privilegiato su %@, con accesso all'host, e vi apre un terminale. Talos scarica prima l'immagine se il nodo non ce l'ha."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускає образ як привілейований контейнер на %@ з доступом до хоста й відкриває в ньому термінал. Talos спершу завантажує образ, якщо на вузлі його немає."
          }
        }
      }
    },
