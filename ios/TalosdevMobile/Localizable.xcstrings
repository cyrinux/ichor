    "Secrets are shown in clear: CA keys and tokens give full control of the cluster. Don't share screenshots." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les secrets sont affichés en clair : les clés de CA et les jetons donnent le contrôle total du cluster. Ne partagez pas de captures d'écran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los secretos se muestran en claro: las claves de CA y los tokens dan control total del clúster. No compartas capturas de pantalla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секрети показано відкритим текстом: ключі CA та токени дають повний контроль над кластером. Не діліться знімками екрана."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse werden im Klartext angezeigt: CA-Schlüssel und Tokens geben volle Kontrolle über den Cluster. Teile keine Bildschirmfotos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segreti sono mostrati in chiaro: le chiavi della CA e i token danno il pieno controllo del cluster. Non condividere screenshot."
          }
        }
      }
    },
