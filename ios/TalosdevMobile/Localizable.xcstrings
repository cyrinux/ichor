    "It is free and open source. If it saves you time, you can support its development." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist kostenlos und quelloffen. Wenn sie dir Zeit spart, kannst du ihre Entwicklung unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es libre y gratuita. Si te ahorra tiempo, puedes apoyar su desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est libre et gratuite. Si elle vous fait gagner du temps, vous pouvez soutenir son développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È gratuita e open source. Se ti fa risparmiare tempo, puoi sostenerne lo sviluppo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він безкоштовний і з відкритим кодом. Якщо він заощаджує вам час, ви можете підтримати його розробку."
          }
        }
      }
    },
    "It stays off until someone powers it on (Wake-on-LAN, IPMI or physically)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt aus, bis ihn jemand einschaltet (Wake-on-LAN, IPMI oder vor Ort)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanece apagado hasta que alguien lo encienda (Wake-on-LAN, IPMI o físicamente)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste éteint jusqu'à ce que quelqu'un le rallume (Wake-on-LAN, IPMI ou physiquement)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta spento finché qualcuno non lo riaccende (Wake-on-LAN, IPMI o fisicamente)."
