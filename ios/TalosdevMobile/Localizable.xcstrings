    "Disarm etcd alarms?" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désarmer les alarmes etcd ?"
          }
        },
        "es" : {
          "stringUnit" : {
