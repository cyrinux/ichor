    "Delete other copies afterwards: the file contains the private key. The app encrypts it with a Secure Enclave key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche danach andere Kopien: Die Datei enthält den privaten Schlüssel. Die App verschlüsselt sie mit einem Secure-Enclave-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después borra las demás copias: el archivo contiene la clave privada. La app lo cifra con una clave del Secure Enclave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez ensuite les autres copies : le fichier contient la clé privée. L'app le chiffre avec une clé du Secure Enclave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi elimina le altre copie: il file contiene la chiave privata. L'app lo cifra con una chiave del Secure Enclave."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потім видаліть інші копії: файл містить приватний ключ. Застосунок шифрує його ключем Secure Enclave."
          }
        }
      }
    },
