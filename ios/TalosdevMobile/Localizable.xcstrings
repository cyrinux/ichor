        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una instantánea de la base de datos de etcd en el archivo que elijas, para recuperar el clúster con talosctl bootstrap --recover-from."
          }
        },
        "uk" : {
