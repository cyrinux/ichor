    "Each member is busy while it is defragmented. Members are done one at a time, never together, so the cluster keeps quorum." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Mitglied ist während der Defragmentierung ausgelastet. Die Mitglieder werden einzeln bearbeitet, nie gleichzeitig, damit der Cluster das Quorum behält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada miembro está ocupado mientras se desfragmenta. Los miembros se procesan de uno en uno, nunca a la vez, para que el clúster mantenga el quórum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque membre est occupé pendant sa défragmentation. Les membres sont traités un par un, jamais ensemble, pour que le cluster garde le quorum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni membro è occupato durante la deframmentazione. I membri vengono elaborati uno alla volta, mai insieme, così il cluster mantiene il quorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен член зайнятий під час дефрагментації. Члени обробляються по одному, ніколи разом, тож кластер зберігає кворум."
          }
        }
      }
    },
