    "Refreshed every 2s. CPU is a percentage of one core; tap a process to see its full command line." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualisé toutes les 2 s. Le CPU est un pourcentage d'un cœur ; touchez un processus pour voir sa ligne de commande complète."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualiza cada 2 s. La CPU es un porcentaje de un núcleo; toca un proceso para ver su línea de comandos completa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлюється кожні 2 с. CPU — це відсоток одного ядра; торкніться процесу, щоб побачити повний командний рядок."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 2 s aktualisiert. CPU ist ein Prozentsatz eines Kerns; tippe auf einen Prozess, um die vollständige Befehlszeile zu sehen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornato ogni 2 s. La CPU è una percentuale di un core; tocca un processo per vederne la riga di comando completa."
