{
  "sourceLanguage": "en",
  "strings": {
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "完成" } },
        "ja": { "stringUnit": { "state": "translated", "value": "完了" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Concluído" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Готово" } }
      }
    },
    "Ichor takes Talos and Kubernetes configs and Ichor backups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichor nimmt Talos- und Kubernetes-Konfigurationen und Ichor-Sicherungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichor acepta configuraciones de Talos y Kubernetes y copias de Ichor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichor accepte les configurations Talos et Kubernetes et les sauvegardes Ichor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichor accetta configurazioni Talos e Kubernetes e backup di Ichor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichor приймає конфігурації Talos і Kubernetes та резервні копії Ichor."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Ichor 接受 Talos 和 Kubernetes 配置以及 Ichor 备份。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Ichor は Talos と Kubernetes の構成ファイル、および Ichor のバックアップを受け付けます。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O Ichor aceita configurações do Talos e do Kubernetes e backups do Ichor." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ichor принимает конфигурации Talos и Kubernetes и резервные копии Ichor." } }
      }
    },
    "Saved. Open Ichor to import it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Öffne Ichor, um die Datei zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Abre Ichor para importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Ouvrez Ichor pour l’importer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato. Apri Ichor per importarlo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено. Відкрийте Ichor, щоб імпортувати."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保存。打开 Ichor 即可导入。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "保存しました。Ichor を開いてインポートしてください。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Salvo. Abra o Ichor para importá-lo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сохранено. Откройте Ichor, чтобы импортировать." } }
      }
    },
    "Send to Ichor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Ichor senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a Ichor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer à Ichor"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia a Ichor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати в Ichor"
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "发送到 Ichor" } },
        "ja": { "stringUnit": { "state": "translated", "value": "Ichor に送信" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Enviar para o Ichor" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отправить в Ichor" } }
      }
    },
    "The file could not be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il file."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти файл."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存该文件。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ファイルを保存できませんでした。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não foi possível salvar o arquivo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось сохранить файл." } }
      }
    },
    "The file could not be protected, so it was not saved.": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Die Datei konnte nicht geschützt werden und wurde daher nicht gespeichert." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo proteger el archivo, así que no se ha guardado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le fichier n’a pas pu être protégé : il n’a donc pas été enregistré." } },
        "it": { "stringUnit": { "state": "translated", "value": "Impossibile proteggere il file, quindi non è stato salvato." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Не вдалося захистити файл, тому його не збережено." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保护该文件,因此未保存。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ファイルを保護できなかったため、保存しませんでした。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não foi possível proteger o arquivo, por isso ele não foi salvo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось защитить файл, поэтому он не сохранён." } }
      }
    },
    "This file is too large for a config or a backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist zu groß für eine Konfiguration oder eine Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es demasiado grande para una configuración o una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est trop volumineux pour une configuration ou une sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è troppo grande per una configurazione o un backup."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл завеликий для конфігурації чи резервної копії."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此文件过大，不可能是配置或备份。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このファイルは構成ファイルやバックアップとしては大きすぎます。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Este arquivo é grande demais para uma configuração ou um backup." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Этот файл слишком велик для конфигурации или резервной копии." } }
      }
    }
  },
  "version": "1.0"
}
