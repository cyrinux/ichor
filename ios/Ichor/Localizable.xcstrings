    "About %@ reclaimable. Members are done one at a time, followers first and the leader last." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ freizugeben. Die Mitglieder werden einzeln bearbeitet, zuerst die Follower, der Leader zuletzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %@ recuperables. Los miembros se procesan de uno en uno, primero los seguidores y el líder al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %@ récupérables. Les membres sont traités un par un, les suiveurs d'abord et le leader en dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %@ recuperabili. I membri vengono elaborati uno alla volta, prima i follower e il leader per ultimo."
          }
