          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro censurado de los eventos de la app y de los informes de fallos del sistema, sin nombres de clúster. Solo sale de este dispositivo si lo compartes."
          }
        },
        "fr" : {
