        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "镜像仓库拒绝了拉取：为该 Pod 添加或更新拉取 Secret（imagePullSecrets）。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レジストリがプルを拒否しました。Pod のプルシークレット（imagePullSecrets）を追加または更新してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O registry recusou o pull: adicione ou renove o pull secret do pod (imagePullSecrets) para ele." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Реестр отклонил загрузку: добавьте или обновите pull secret пода (imagePullSecrets) для него." } }
      }
    },
    "The registry's pull limit is reached: add a registry mirror (pull-through cache) or registry credentials to the nodes' machine config." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Pull-Limit der Registry ist erreicht: Registry-Mirror (Pull-Through-Cache) oder Zugangsdaten zur Maschinenkonfiguration der Knoten hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de descargas del registro: añade un espejo (caché) o credenciales del registro a la configuración de máquina de los nodos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de téléchargement du registre est atteinte : ajoutez un miroir de registre (cache) ou des identifiants à la configuration machine des nœuds."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite di pull del registro è raggiunto: aggiungi un mirror (cache pull-through) o le credenziali alla configurazione macchina dei nodi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досягнуто ліміт завантажень реєстру: додайте дзеркало (кеш) або облікові дані до конфігурації машини вузлів."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已达到镜像仓库的拉取限制：在节点的机器配置中添加仓库镜像（pull-through 缓存）或仓库凭据。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レジストリのプル上限に達しました。ノードのマシン構成にレジストリミラー（プルスルーキャッシュ）またはレジストリの認証情報を追加してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O limite de pulls do registry foi atingido: adicione um mirror de registry (cache pull-through) ou credenciais do registry à configuração da máquina dos nós." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Достигнут лимит загрузок реестра: добавьте зеркало реестра (pull-through cache) или учётные данные реестра в конфигурацию машины узлов." } }
      }
    },
