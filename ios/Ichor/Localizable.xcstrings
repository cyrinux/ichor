    "The snapshot from %@ contains every Kubernetes Secret. Encrypt it with age: it can then be restored from any Unix machine with the age and talosctl commands." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Snapshot von %@ enthält alle Kubernetes-Secrets. Verschlüssele ihn mit age: Er lässt sich dann auf jedem Unix-Rechner mit den Befehlen age und talosctl wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de %@ contiene todos los Secrets de Kubernetes. Cífrala con age: podrás restaurarla desde cualquier máquina Unix con los comandos age y talosctl."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde prise sur %@ contient tous les Secrets Kubernetes. Chiffrez-la avec age : elle pourra être restaurée depuis n’importe quelle machine Unix avec les commandes age et talosctl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo snapshot di %@ contiene tutti i Secret di Kubernetes. Cifralo con age: potrai ripristinarlo da qualsiasi macchina Unix con i comandi age e talosctl."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімок з %@ містить усі Secrets Kubernetes. Зашифруйте його за допомогою age: тоді його можна відновити на будь-якій Unix-машині командами age і talosctl."
          }
        }
      }
    },
    "Encrypted for: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselt für: %@"
