    "Anyone holding the file or the QR code can use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die Datei oder den QR-Code hat, kann sie verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga el archivo o el código QR puede usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne qui détient le fichier ou le QR code peut l'utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia il file o il codice QR può usarlo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто, хто має файл або QR-код, може ним скористатися."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任何持有该文件或 QR 码的人都可以使用它。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルまたは QR コードを持つ人は誰でも使用できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Qualquer pessoa com o arquivo ou o código QR pode usá-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Любой, у кого есть файл или QR-код, может его использовать." } }
      }
    },
    "Anyone with this file has full access to the Kubernetes cluster: keep it private. Use it with kubectl or any Kubernetes client." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer diese Datei hat, hat vollen Zugriff auf den Kubernetes-Cluster: Halte sie privat. Verwende sie mit kubectl oder einem anderen Kubernetes-Client."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga este archivo tiene acceso total al clúster de Kubernetes: mantenlo privado. Úsalo con kubectl o cualquier cliente de Kubernetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant de ce fichier a un accès complet au cluster Kubernetes : gardez-le privé. Utilisez-le avec kubectl ou tout client Kubernetes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia questo file ha accesso completo al cluster Kubernetes: tienilo privato. Usalo con kubectl o con qualsiasi client Kubernetes."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто з цим файлом має повний доступ до кластера Kubernetes: зберігайте його приватно. Використовуйте його з kubectl або будь-яким клієнтом Kubernetes."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任何拥有此文件的人都可完全访问该 Kubernetes 集群：请妥善保管。可配合 kubectl 或任何 Kubernetes 客户端使用。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このファイルを持つ人は Kubernetes クラスターにフルアクセスできます：他人に渡さないでください。kubectl または任意の Kubernetes クライアントで使用できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Qualquer pessoa com este arquivo tem acesso total ao cluster Kubernetes: mantenha-o privado. Use-o com kubectl ou qualquer cliente Kubernetes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Любой, у кого есть этот файл, получает полный доступ к кластеру Kubernetes: не передавайте его. Используйте его с kubectl или любым клиентом Kubernetes." } }
      }
    },
