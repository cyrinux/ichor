    "The node reboots now into the Talos version it ran before its last upgrade, without draining its pods. For an upgrade that boots but misbehaves." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud redémarre maintenant sur la version de Talos d’avant sa dernière mise à niveau, sans vider ses pods. Pour une mise à niveau qui démarre mais se comporte mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo se reinicia ahora en la versión de Talos anterior a su última actualización, sin vaciar sus pods. Para una actualización que arranca pero funciona mal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node startet jetzt in die Talos-Version vor seinem letzten Upgrade neu, ohne seine Pods zu leeren. Für ein Upgrade, das startet, sich aber falsch verhält."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo si riavvia ora nella versione di Talos precedente all’ultimo aggiornamento, senza svuotare i suoi pod. Per un aggiornamento che parte ma funziona male."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол зараз перезавантажиться у версію Talos, що була до останнього оновлення, без виселення подів. Для оновлення, яке завантажується, але працює неправильно."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点会立即重启到上次升级前运行的 Talos 版本，且不会排空其 Pod。适用于能启动但运行异常的升级。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードは Pod をドレインせずに、直前のアップグレード前に実行していた Talos バージョンで今すぐ再起動します。起動はするものの正常に動作しないアップグレード向けです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó reinicia agora na versão do Talos que executava antes da última atualização, sem drenar os pods. Para uma atualização que inicializa, mas se comporta mal." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел сейчас перезагрузится в версию Talos, которая работала до последнего обновления, без освобождения подов. Для обновления, которое загружается, но работает неправильно." } }
      }
    },
