        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕录制或镜像期间隐藏。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "画面の収録中またはミラーリング中は非表示になります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Oculto enquanto a tela é gravada ou espelhada." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скрыто во время записи или трансляции экрана." } }
      }
    },
    "Identical consecutive events are shown once with a count." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiche aufeinanderfolgende Ereignisse werden einmal mit Anzahl angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
