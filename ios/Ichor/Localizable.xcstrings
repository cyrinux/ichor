        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo no alcanza el registro: revisa su DNS y salida, o usa un espejo accesible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud ne joint pas le registre : vérifiez son DNS et sa sortie, ou utilisez un miroir joignable."
          }
        },
        "it" : {
          "stringUnit" : {
