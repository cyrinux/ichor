    "%@ is a critical system service: stopping or restarting it can make the node unreachable or disrupt the cluster." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein kritischer Systemdienst: Ihn zu stoppen oder neu zu starten kann den Knoten unerreichbar machen oder den Cluster stören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un servicio crítico del sistema: detenerlo o reiniciarlo puede dejar el nodo inaccesible o afectar al clúster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un service système critique : l’arrêter ou le redémarrer peut rendre le nœud injoignable ou perturber le cluster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un servizio di sistema critico: fermarlo o riavviarlo può rendere il nodo irraggiungibile o disturbare il cluster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — критична системна служба: її зупинка або перезапуск може зробити вузол недоступним або порушити роботу кластера."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 是关键系统服务：停止或重启它可能导致节点无法访问或干扰集群。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ は重要なシステムサービスです：停止または再起動すると、ノードが到達不能になったりクラスターに障害が発生したりする可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ é um serviço crítico do sistema: pará-lo ou reiniciá-lo pode deixar o nó inacessível ou afetar o cluster." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ — критический системный сервис: его остановка или перезапуск может сделать узел недоступным или нарушить работу кластера." } }
      }
    },
