        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このキーが作成した認証情報を Ichor は検証できません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta chave gerou uma credencial que o Ichor não consegue verificar." } },
