        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортований плагін читає лише ресурси, які оголошує, з вашим власним доступом до Kubernetes, і не звертається ні до чого, крім API Kubernetes."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入的插件只会使用你自己的 Kubernetes 访问权限读取其声明的资源，且只与 Kubernetes API 通信。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "インポートしたプラグインは、宣言したリソースのみを、あなた自身の Kubernetes アクセス権で読み取り、Kubernetes API 以外とは通信しません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um plugin importado lê apenas os recursos que declara, com o seu próprio acesso ao Kubernetes, e não se comunica com nada além da API do Kubernetes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импортированный плагин читает только объявленные им ресурсы, с вашим собственным доступом к Kubernetes, и не обращается ни к чему, кроме API Kubernetes." } }
