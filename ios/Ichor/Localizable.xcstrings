        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "转发会持续监听：每个连接都会重新尝试。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "転送は待ち受けを続け、接続ごとに再試行されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O encaminhamento continua escutando: cada conexão é tentada novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перенаправление продолжает слушать: каждое соединение пробуется заново." } }
