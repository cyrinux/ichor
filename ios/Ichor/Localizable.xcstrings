            "value" : "Déjalo vacío para buscar en todos los proyectos que ve tu cuenta; indica ID de proyecto para ir más rápido en una organización grande."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um alle Projekte zu durchsuchen, die dein Konto sieht; gib Projekt-IDs an, um in einer großen Organisation schneller zu sein."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per cercare in tutti i progetti visibili al tuo account; elenca gli ID dei progetti per fare prima in una grande organizzazione."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залиште порожнім, щоб шукати в усіх проєктах, які бачить ваш обліковий запис; укажіть ID проєктів, щоб швидше працювати у великій організації."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空则搜索你的账号可见的所有项目；在大型组织中列出项目 ID 可加快速度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "空欄の場合、アカウントから見えるすべてのプロジェクトを検索します。大規模な組織では、プロジェクト ID を指定すると高速になります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Deixe em branco para pesquisar em todos os projetos que sua conta vê; informe IDs de projeto para ir mais rápido em uma organização grande." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Оставьте пустым, чтобы искать во всех проектах, видимых вашему аккаунту; перечислите ID проектов, чтобы ускорить поиск в большой организации." } }
      }
