        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "稳定版本将收回流量，新的 Pod 会被缩容。重试会重新开始更新。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "安定版がトラフィックを引き戻し、新しい Pod はスケールダウンされます。再試行すると更新が再開されます。" } },
