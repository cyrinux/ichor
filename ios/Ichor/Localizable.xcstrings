      }
    },
    "This key only makes new credentials with its FIDO PIN. It is used once here; unlocking never asks for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel erstellt neue Anmeldedaten nur mit seiner FIDO-PIN. Sie wird hier einmal verwendet; das Entsperren fragt nie danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta llave solo crea credenciales nuevas con su PIN FIDO. Se usa una vez aquí; el desbloqueo nunca lo pide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé ne crée de nouveaux identifiants qu'avec son code FIDO. Il sert une fois ici ; le déverrouillage ne le demande jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chiave crea nuove credenziali solo con il suo PIN FIDO. Si usa una volta qui; lo sblocco non lo chiede mai."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей ключ створює нові облікові дані лише зі своїм FIDO PIN. Він використовується тут один раз; розблокування його ніколи не запитує."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此密钥只有在输入 FIDO PIN 码后才能创建新凭据。PIN 码仅在此处使用一次；解锁时从不要求输入。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このキーは FIDO PIN がないと新しい認証情報を作成できません。PIN はここで一度だけ使用され、ロック解除時には求められません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta chave só cria novas credenciais com o PIN FIDO dela. Ele é usado uma vez aqui; o desbloqueio nunca o pede." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Этот ключ создаёт новые учётные данные только с FIDO PIN. Он нужен здесь один раз; при разблокировке он не запрашивается." } }
      }
    },
    "This key was added before the key requirement. Tap another enrolled key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel wurde vor der Schlüsselpflicht hinzugefügt. Tippe mit einem anderen registrierten Schlüssel an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta llave se añadió antes de exigir la llave. Acerca otra llave registrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé a été ajoutée avant l'exigence de clé. Approchez une autre clé enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
