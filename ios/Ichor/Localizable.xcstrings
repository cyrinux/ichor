        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元すると、このデバイスのすべてのクラスターと設定がバックアップの内容に置き換えられます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A restauração substitui todos os clusters e configurações deste dispositivo pelos do backup." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Восстановление заменит все кластеры и настройки на этом устройстве данными из резервной копии." } }
