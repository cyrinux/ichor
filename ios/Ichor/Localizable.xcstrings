        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードのアーキテクチャ向けのイメージビルドがありません。マルチアーキテクチャのイメージを使うか、対応するノードに Pod をスケジュールしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não há build da imagem para a arquitetura do nó: use uma imagem multi-arch ou agende o pod em nós compatíveis." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет сборки образа для архитектуры узла: используйте multi-arch-образ или планируйте под на подходящие узлы." } }
