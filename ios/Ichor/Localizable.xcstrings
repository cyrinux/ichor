    "Check the router: its address and AS numbers, that it accepts this node, and that nothing filters TCP 179 between them." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le routeur : son adresse et ses numéros d’AS, qu’il accepte ce nœud, et que rien ne filtre le TCP 179 entre eux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el router: su dirección y números de AS, que acepte este nodo, y que nada filtre el TCP 179 entre ellos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfen Sie den Router: seine Adresse und AS-Nummern, dass er diesen Knoten akzeptiert und dass nichts TCP 179 dazwischen filtert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il router: il suo indirizzo e i numeri di AS, che accetti questo nodo, e che nulla filtri il TCP 179 tra loro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте маршрутизатор: його адресу й номери AS, що він приймає цей вузол і що ніщо не фільтрує TCP 179 між ними."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查路由器：其地址和 AS 号、是否接受此节点，以及两者之间是否有过滤 TCP 179 的规则。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ルーターを確認してください：アドレスと AS 番号、このノードを受け入れているか、両者の間で TCP 179 がフィルタリングされていないか。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verifique o roteador: o endereço e os números de AS, se ele aceita este nó e se nada filtra a porta TCP 179 entre eles." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверьте маршрутизатор: его адрес и номера AS, что он принимает этот узел и что ничто не фильтрует TCP 179 между ними." } }
      }
    },
