    "Restarting the primary interrupts connections. CloudNativePG restarts PostgreSQL in place and preserves its PVCs." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarting the primary interrupts connections. CloudNativePG restarts PostgreSQL in place and preserves its PVCs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le redémarrage du primaire interrompt les connexions. CloudNativePG redémarre PostgreSQL sur place et conserve ses PVC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiniciar el primario interrumpe las conexiones. CloudNativePG reinicia PostgreSQL en su lugar y conserva sus PVC."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапуск основного екземпляра перериває з’єднання. CloudNativePG перезапускає PostgreSQL на місці та зберігає його PVC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Neustart des Primärknotens unterbricht Verbindungen. CloudNativePG startet PostgreSQL an Ort und Stelle neu und behält seine PVCs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riavvio del primario interrompe le connessioni. CloudNativePG riavvia PostgreSQL sul posto e conserva i suoi PVC."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重启主库会中断连接。CloudNativePG 会原地重启 PostgreSQL 并保留其 PVC。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライマリを再起動すると接続が中断されます。CloudNativePG は PostgreSQL をその場で再起動し、PVC を保持します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reiniciar o primário interrompe as conexões. O CloudNativePG reinicia o PostgreSQL no lugar e preserva os PVCs." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перезапуск primary прерывает соединения. CloudNativePG перезапускает PostgreSQL на месте и сохраняет его PVC." } }
      }
    },
    "Hibernation stops the cluster and interrupts all connections. Its PVCs are preserved until you wake the cluster." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hibernation stops the cluster and interrupts all connections. Its PVCs are preserved until you wake the cluster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise en veille arrête le cluster et interrompt toutes les connexions. Ses PVC sont conservés jusqu’au réveil du cluster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hibernación detiene el clúster e interrumpe todas las conexiones. Sus PVC se conservan hasta que active el clúster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присипляння зупиняє кластер і перериває всі з’єднання. Його PVC зберігаються до пробудження кластера."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ruhezustand stoppt den Cluster und unterbricht alle Verbindungen. Seine PVCs bleiben bis zum Aufwecken erhalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ibernazione arresta il cluster e interrompe tutte le connessioni. I suoi PVC vengono conservati fino alla riattivazione."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休眠会停止集群并中断所有连接。其 PVC 会保留，直到你唤醒集群。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "休止するとクラスターが停止し、すべての接続が中断されます。PVC はクラスターを起動するまで保持されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A hibernação para o cluster e interrompe todas as conexões. Os PVCs são preservados até você acordar o cluster." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Спящий режим останавливает кластер и прерывает все соединения. Его PVC сохраняются, пока вы не разбудите кластер." } }
      }
    },
    "CloudNativePG starts the cluster using its preserved PVCs. Connections remain unavailable until the instances are ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG starts the cluster using its preserved PVCs. Connections remain unavailable until the instances are ready."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG démarre le cluster avec ses PVC conservés. Les connexions restent indisponibles jusqu’à ce que les instances soient prêtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG inicia el clúster usando sus PVC conservados. Las conexiones siguen sin estar disponibles hasta que las instancias estén listas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG запускає кластер зі збереженими PVC. З’єднання недоступні, доки екземпляри не будуть готові."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG startet den Cluster mit seinen erhaltenen PVCs. Verbindungen sind erst verfügbar, wenn die Instanzen bereit sind."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudNativePG avvia il cluster usando i PVC conservati. Le connessioni restano indisponibili finché le istanze non sono pronte."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "CloudNativePG 使用保留的 PVC 启动集群。在实例就绪之前连接仍不可用。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "CloudNativePG は保持された PVC を使ってクラスターを起動します。インスタンスが準備完了になるまで接続はできません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O CloudNativePG inicia o cluster usando os PVCs preservados. As conexões ficam indisponíveis até que as instâncias estejam prontas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "CloudNativePG запускает кластер на сохранённых PVC. Соединения недоступны, пока экземпляры не будут готовы." } }
      }
    },
