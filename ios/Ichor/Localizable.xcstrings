    "Refresh CPU and memory on the overview every few seconds while it is open. Turn off to save mobile data and battery." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refresh CPU and memory on the overview every few seconds while it is open. Turn off to save mobile data and battery."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualise le CPU et la mémoire de la vue d'ensemble toutes les quelques secondes tant qu'elle est ouverte. Désactivez pour économiser données mobiles et batterie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza la CPU y la memoria de la vista general cada pocos segundos mientras está abierta. Desactívalo para ahorrar datos móviles y batería."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлює CPU і пам'ять в огляді кожні кілька секунд, поки він відкритий. Вимкніть, щоб заощадити мобільні дані й батарею."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiert CPU und Speicher in der Übersicht alle paar Sekunden, solange sie geöffnet ist. Ausschalten spart mobile Daten und Akku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna CPU e memoria della panoramica ogni pochi secondi mentre è aperta. Disattiva per risparmiare dati mobili e batteria."
          }
        }
      }
    },
