            "value" : "Жоден учасник не відповідає: конфігурацію нового вузла створюють з конфігурації учасника."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有成员响应：新节点的配置需要基于某个成员的配置生成。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "応答するメンバーがありません。新しいノードの構成はメンバーの構成から作成されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum membro responde: a configuração do novo nó é feita a partir da de um membro." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ни один участник не отвечает: конфигурация нового узла создаётся на основе конфигурации участника." } }
