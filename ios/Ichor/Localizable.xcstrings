            "value" : "Le parti che il ruolo del tuo talosconfig non può leggere vengono omesse e segnalate nel bundle (la configurazione della macchina richiede os:admin, lo stato di etcd os:operator)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частини, які роль вашого talosconfig не може прочитати, пропускаються, і це зазначається в пакеті (конфігурація машини потребує os:admin, стан etcd — os:operator)."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "talosconfig 角色无法读取的部分会被省略并在支持包中注明（机器配置需要 os:admin，etcd 状态需要 os:operator）。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "talosconfig のロールで読み取れない部分は除外され、バンドル内に記録されます（マシン構成には os:admin、etcd ステータスには os:operator が必要です）。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As partes que o papel do seu talosconfig não pode ler ficam de fora e são indicadas no pacote (a configuração da máquina requer os:admin, o status do etcd os:operator)." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Части, которые роль вашего talosconfig не может прочитать, пропускаются и отмечаются в пакете (конфигурации машины нужна роль os:admin, состоянию etcd — os:operator)." } }
