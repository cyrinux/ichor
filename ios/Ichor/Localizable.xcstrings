    "Capture on a second node at the same time, such as both ends of a link: one file, each packet marked with its node." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturer en même temps sur un second nœud, comme les deux bouts d'un lien : un seul fichier, chaque paquet marqué de son nœud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturar a la vez en un segundo nodo, como los dos extremos de un enlace: un solo archivo, cada paquete marcado con su nodo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichzeitig auf einem zweiten Node mitschneiden, etwa an beiden Enden einer Verbindung: eine Datei, jedes Paket mit seinem Node markiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cattura contemporaneamente su un secondo nodo, come i due capi di un collegamento: un unico file, ogni pacchetto marcato con il suo nodo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоплювати одночасно на другому вузлі, наприклад на обох кінцях з'єднання: один файл, кожен пакет позначено його вузлом."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同时在第二个节点上抓包，例如链路的两端：生成一个文件，每个数据包都标有其所属节点。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リンクの両端など、2 つ目のノードでも同時にキャプチャします。1 つのファイルにまとめられ、各パケットにノードが記録されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Captura em um segundo nó ao mesmo tempo, como as duas pontas de um link: um único arquivo, com cada pacote marcado com seu nó." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Одновременно захватывать на втором узле, например на обоих концах связи: один файл, каждый пакет помечен своим узлом." } }
