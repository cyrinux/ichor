          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点无法访问镜像仓库：检查其 DNS 和出站流量，或使用它能访问的镜像。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードがレジストリに到達できません。DNS とエグレスを確認するか、到達可能なミラーを使用してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó não consegue acessar o registry: verifique o DNS e a saída dele, ou use um mirror que ele consiga acessar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел не может подключиться к реестру: проверьте его DNS и исходящий трафик или используйте доступное ему зеркало." } }
      }
    },
