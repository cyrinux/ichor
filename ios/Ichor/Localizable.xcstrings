    "Kubernetes API address" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse de l’API Kubernetes"
          }
        },
        "es" : {
