          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "受保护：%@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保護中：%@" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Protegido: %@" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Защищено: %@" } }
      }
    },
    "Its deletion is already pending: the finalizers below hold it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa suppression est déjà en attente : les finaliseurs ci-dessous la retiennent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su eliminación ya está pendiente: la retienen los finalizadores de abajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen steht schon an: Die Finalizer unten halten es auf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua eliminazione è già in attesa: la trattengono i finalizzatori qui sotto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його видалення вже очікує: його тримають фіналізатори нижче."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其删除已在等待中：被下方的 finalizer 阻止。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "すでに削除待ちです。以下のファイナライザーが削除を保留しています。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A exclusão dele já está pendente: os finalizers abaixo a retêm." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удаление уже ожидает: его удерживают finalizers ниже." } }
      }
    },
    "The object stays until their controllers remove them." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'objet reste tant que leurs contrôleurs ne les ont pas retirés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objeto sigue hasta que sus controladores los quiten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Objekt bleibt, bis ihre Controller sie entfernen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'oggetto resta finché i loro controller non li rimuovono."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об'єкт лишається, доки їхні контролери їх не приберуть."
          }
        },
