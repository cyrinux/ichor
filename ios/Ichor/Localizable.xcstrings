          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与 helm rollback --force 相同：每个更改的对象会被完整写入，适用于补丁无法将其恢复的情况。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "helm rollback --force と同様に、変更された各オブジェクトを丸ごと書き込みます。パッチで元に戻せない場合に使用します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Como helm rollback --force: cada objeto alterado é gravado por inteiro, para quando um patch não consegue restaurá-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Как helm rollback --force: каждый изменённый объект записывается целиком — на случай, когда патч не может вернуть его." } }
      }
