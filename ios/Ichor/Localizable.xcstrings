    "History only goes back as far as Goldmane still keeps; flows are 15-second aggregates, not single packets." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf reicht nur so weit zurück, wie Goldmane noch vorhält; Flows sind 15-Sekunden-Aggregate, keine einzelnen Pakete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial solo llega hasta donde Goldmane aún conserva; los flujos son agregados de 15 segundos, no paquetes sueltos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique ne remonte que jusqu’à ce que Goldmane conserve encore ; les flux sont des agrégats de 15 secondes, pas des paquets isolés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia risale solo fino a quanto Goldmane conserva ancora; i flussi sono aggregati di 15 secondi, non singoli pacchetti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія сягає лише того, що Goldmane ще зберігає; потоки — це агрегати за 15 секунд, а не окремі пакети."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史记录仅覆盖 Goldmane 仍保留的范围；流量是 15 秒聚合，而非单个数据包。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "履歴は Goldmane が保持している範囲までしか遡れません。フローは単一のパケットではなく、15秒ごとの集計です。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O histórico só vai até onde o Goldmane ainda guarda; os fluxos são agregados de 15 segundos, não pacotes individuais." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "История доступна лишь настолько, насколько её ещё хранит Goldmane; потоки — это 15-секундные агрегаты, а не отдельные пакеты." } }
      }
    },
