    },
    "The app switcher shows a blank cover, and alerts hide cluster details on the lock screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App-Umschalter zeigt eine leere Abdeckung, und Warnungen verbergen Cluster-Details auf dem Sperrbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app switcher shows a blank cover, and alerts hide cluster details on the lock screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El selector de apps muestra una pantalla en blanco, y las alertas ocultan los detalles del clúster en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sélecteur d'apps affiche un écran vide, et les alertes masquent les détails du cluster sur l'écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il selettore di app mostra una copertina vuota, e gli avvisi nascondono i dettagli del cluster nella schermata di blocco."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикач застосунків показує порожній екран, а сповіщення приховують деталі кластера на екрані блокування."
