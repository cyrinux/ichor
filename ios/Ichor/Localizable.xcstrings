          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以离开此页面：通知会在一段时间内提供“保留”选项。如果 Ichor 被挂起或连接中断，节点会自动回滚。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この画面を離れても構いません：しばらくの間、通知から「保持」を選べます。Ichor が一時停止されるか接続が失われると、ノードは自動的に元に戻ります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você pode sair desta tela: uma notificação oferece Manter por um tempo. Se o Ichor for suspenso ou a conexão cair, o nó reverte sozinho." } },
