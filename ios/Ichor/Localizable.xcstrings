      }
    },
    "Ichor defragments every etcd member, one at a time (%@), disarms the alarm, then reads etcd again. Each member is busy while it is defragmented." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor défragmente chaque membre etcd, un par un (%@), désarme l'alarme, puis relit etcd. Chaque membre est occupé pendant sa défragmentation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor desfragmenta cada miembro de etcd, uno a uno (%@), desactiva la alarma y vuelve a leer etcd. Cada miembro está ocupado mientras se desfragmenta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor defragmentiert jedes etcd-Mitglied nacheinander (%@), deaktiviert den Alarm und liest etcd dann erneut. Jedes Mitglied ist während der Defragmentierung beschäftigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor deframmenta ogni membro etcd, uno alla volta (%@), disattiva l'allarme, poi rilegge etcd. Ogni membro è occupato durante la deframmentazione."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor дефрагментує кожного учасника etcd по черзі (%@), вимикає тривогу, потім знову читає etcd. Під час дефрагментації учасник зайнятий."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Ichor 会逐个对每个 etcd 成员进行碎片整理（%@），解除告警，然后重新读取 etcd。碎片整理期间各成员处于繁忙状态。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor はすべての etcd メンバーを1つずつデフラグし（%@）、アラームを解除してから etcd を再度読み込みます。デフラグ中の各メンバーはビジー状態になります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Ichor desfragmenta cada membro do etcd, um por vez (%@), desarma o alarme e depois lê o etcd novamente. Cada membro fica ocupado enquanto é desfragmentado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ichor дефрагментирует каждого участника etcd по очереди (%@), снимает сигнал, затем заново читает etcd. Во время дефрагментации участник занят." } }
      }
    },
