        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ встановлює %@ і перезавантажується: його поди виселяються, і він недоступний кілька хвилин."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 将安装 %@ 并重启：其 Pod 会被排空，节点将有数分钟不可用。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ は %@ をインストールして再起動します：Pod はドレインされ、数分間利用できなくなります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ instala %@ e reinicia: seus pods são drenados e ele fica indisponível por vários minutos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ устанавливает %@ и перезагружается: его поды вытесняются, и он недоступен несколько минут." } }
