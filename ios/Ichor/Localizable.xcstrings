    "The Kubernetes upgrade stops while Ichor is in the background. Open it until every node is done." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour de Kubernetes s'arrête tant qu'Ichor est en arrière-plan. Ouvrez-le jusqu'à ce que tous les nœuds soient faits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización de Kubernetes se detiene mientras Ichor está en segundo plano. Ábrelo hasta que todos los nodos terminen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kubernetes-Update hält an, solange Ichor im Hintergrund ist. Öffne es, bis alle Nodes fertig sind."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
