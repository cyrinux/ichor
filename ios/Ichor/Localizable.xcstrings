        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次检查涵盖所有集群。要排除某个集群，在“集群”下其菜单中关闭“后台监视”。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "各チェックはすべてのクラスターを対象とします。除外するには、「クラスター」でそのメニューの「バックグラウンドで監視」をオフにしてください。" } },
