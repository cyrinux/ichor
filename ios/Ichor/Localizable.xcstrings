    "Everything read-only, plus reboot and shutdown." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles mit Lesezugriff, dazu Neustart und Herunterfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en solo lectura, más reinicio y apagado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout en lecture seule, plus le redémarrage et l'arrêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto in sola lettura, più riavvio e spegnimento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе для читання, а також перезавантаження й вимкнення."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "包含只读的全部功能，外加重启和关机。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取り専用のすべてに加え、再起動とシャットダウン。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tudo do somente leitura, mais reiniciar e desligar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё, что даёт «только чтение», плюс перезагрузка и выключение." } }
      }
    },
    "Everything, including the cluster health check. Treat the phone like a laptop." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, einschließlich der Cluster-Zustandsprüfung. Behandle das Telefon wie einen Laptop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo, incluida la comprobación del estado del clúster. Trata el teléfono como un portátil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout, y compris la vérification de l'état du cluster. Traitez le téléphone comme un ordinateur portable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto, incluso il controllo dello stato del cluster. Tratta il telefono come un portatile."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, включно з перевіркою стану кластера. Ставтеся до телефона як до ноутбука."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全部权限，包括集群健康检查。请像对待笔记本电脑一样对待这部手机。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラスターのヘルスチェックを含むすべて。スマートフォンをノート PC と同様に扱ってください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tudo, incluindo a verificação de integridade do cluster. Trate o telefone como um notebook." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё, включая проверку состояния кластера. Относитесь к телефону как к ноутбуку." } }
      }
    },
