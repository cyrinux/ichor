    "Cluster discovery knows these nodes, but the talosconfig does not list them. Add the ones to show and manage here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cluster-Discovery kennt diese Nodes, aber die talosconfig führt sie nicht auf. Füge diejenigen hinzu, die du hier sehen und verwalten willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El descubrimiento del clúster conoce estos nodos, pero el talosconfig no los incluye. Añade los que quieras ver y gestionar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La découverte du cluster connaît ces nœuds, mais le talosconfig ne les liste pas. Ajoutez ceux à afficher et gérer ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rilevamento del cluster conosce questi nodi, ma il talosconfig non li elenca. Aggiungi quelli da mostrare e gestire qui."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виявлення кластера знає ці вузли, але talosconfig їх не містить. Додайте ті, які потрібно бачити й керувати тут."
          }
        }
      }
    },
