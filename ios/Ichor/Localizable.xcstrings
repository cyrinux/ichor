    "%@ deploys this workload with self-heal on: within minutes it puts the replicas back as Git has them. Freeze %@ first to keep your change for a while." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stellt diese Workload mit aktiver Selbstheilung bereit: Innerhalb von Minuten setzt es die Replikas auf den Stand in Git zurück. Friere %@ zuerst ein, um deine Änderung eine Weile zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deploys this workload with self-heal on: within minutes it puts the replicas back as Git has them. Freeze %@ first to keep your change for a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ despliega esta carga con la autorreparación activada: en minutos devuelve las réplicas a como están en Git. Congela %@ antes para conservar tu cambio un tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ déploie cette charge avec l'auto-réparation active : en quelques minutes, il remet les réplicas comme dans Git. Gelez %@ d'abord pour garder votre changement un moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ distribuisce questo carico con l'auto-riparazione attiva: in pochi minuti riporta le repliche come sono in Git. Congela prima %@ per mantenere la modifica per un po'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ розгортає це навантаження з увімкненим самовідновленням: за кілька хвилин воно поверне репліки до стану в Git. Спершу заморозьте %@, щоб зберегти зміну на якийсь час."
          }
        }
      }
    },
