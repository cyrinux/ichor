        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O kubeconfig deste cluster, como foi importado. Quem tiver este arquivo tem o acesso que ele concede: mantenha-o privado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "kubeconfig этого кластера в том виде, в каком он был импортирован. Любой, у кого есть этот файл, получает предоставляемый им доступ: храните его в тайне." } }
