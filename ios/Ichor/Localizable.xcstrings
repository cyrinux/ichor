          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 上的 root Shell" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@の root シェル" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Shell root em %@" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Root-оболочка на %@" } }
      }
    },
    "A privileged pod runs on %@ in namespace %@, in the node’s own namespaces, and nsenter opens a root shell on the node. The pod is deleted when the shell ends. The namespace must admit privileged pods." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A privileged pod runs on %1$@ in namespace %2$@, in the node’s own namespaces, and nsenter opens a root shell on the node. The pod is deleted when the shell ends. The namespace must admit privileged pods."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pod privilégié s’exécute sur %1$@ dans le namespace %2$@, dans les namespaces du nœud lui-même, et nsenter ouvre un shell root sur le nœud. Le pod est supprimé à la fin du shell. Le namespace doit admettre les pods privilégiés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pod privilegiado se ejecuta en %1$@ en el namespace %2$@, en los namespaces del propio nodo, y nsenter abre una shell root en el nodo. El pod se borra al terminar la shell. El namespace debe admitir pods privilegiados."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привілейований под запускається на %1$@ у просторі імен %2$@, у власних просторах імен вузла, і nsenter відкриває root-оболонку на вузлі. Под видаляється, коли оболонка завершується. Простір імен має допускати привілейовані поди."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein privilegierter Pod läuft auf %1$@ im Namespace %2$@, in den eigenen Namespaces des Knotens, und nsenter öffnet eine Root-Shell auf dem Knoten. Der Pod wird gelöscht, wenn die Shell endet. Der Namespace muss privilegierte Pods zulassen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pod privilegiato gira su %1$@ nel namespace %2$@, nei namespace del nodo stesso, e nsenter apre una shell root sul nodo. Il pod viene eliminato quando la shell termina. Il namespace deve ammettere pod privilegiati."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一个特权 Pod 会在 %1$@ 上的命名空间 %2$@ 中运行，并使用节点自身的命名空间，nsenter 会在节点上打开 root Shell。Shell 结束时 Pod 会被删除。该命名空间必须允许特权 Pod。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "特権 Pod が%1$@上の名前空間%2$@で、ノード自身の名前空間内で実行され、nsenter がノード上の root シェルを開きます。Pod はシェルの終了時に削除されます。名前空間が特権 Pod を許可している必要があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um pod privilegiado roda em %1$@ no namespace %2$@, nos próprios namespaces do nó, e o nsenter abre um shell root no nó. O pod é excluído quando o shell termina. O namespace precisa admitir pods privilegiados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Привилегированный под запускается на %1$@ в пространстве имён %2$@, в собственных пространствах имён узла, и nsenter открывает root-оболочку на узле. Под удаляется по завершении оболочки. Пространство имён должно допускать привилегированные поды." } }
      }
    },
