    "Pods update when deleted (OnDelete): a rollback changes the template, then delete the pods to apply it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les pods se mettent à jour quand on les supprime (OnDelete) : le retour en arrière change le modèle, supprimez ensuite les pods pour l’appliquer." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los pods se actualizan al eliminarlos (OnDelete): la reversión cambia la plantilla; después elimina los pods para aplicarla." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Поди оновлюються після видалення (OnDelete): відкат змінює шаблон, потім видаліть поди, щоб застосувати його." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pods werden beim Löschen aktualisiert (OnDelete): Das Zurückrollen ändert das Template, lösche danach die Pods, um es anzuwenden." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I pod si aggiornano quando li elimini (OnDelete): il ripristino cambia il template, poi elimina i pod per applicarlo." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Pod 在被删除时才会更新（OnDelete）：回滚会更改模板，然后删除 Pod 以应用它。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Pod は削除されたときに更新されます（OnDelete）。ロールバックでテンプレートが変わるので、適用するには Pod を削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os pods são atualizados quando excluídos (OnDelete): a reversão altera o template; depois exclua os pods para aplicá-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Поды обновляются при удалении (OnDelete): откат меняет шаблон, затем удалите поды, чтобы применить его." } }
      }
    },
    "The rollout is paused: resume it before rolling back." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le déploiement est en pause : reprenez-le avant de revenir en arrière." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El despliegue está en pausa: reanúdalo antes de revertir." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Розгортання призупинено: відновіть його перед відкатом." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Rollout ist pausiert: Setze ihn fort, bevor du zurückrollst." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il rollout è in pausa: riprendilo prima di ripristinare." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发布已暂停：请先恢复，再回滚。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロールアウトは一時停止中です。ロールバックする前に再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O rollout está pausado: retome-o antes de reverter." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Развёртывание приостановлено: возобновите его перед откатом." } }
      }
