          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "监视 Alertmanager 告警" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Alertmanager のアラートを監視" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Monitorar os alertas do Alertmanager" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Следить за оповещениями Alertmanager" } }
      }
    },
    "Critical alerts at once, warnings seen on two checks in a row, and when they resolve; silenced, inhibited and info alerts never notify. Each check asks the cluster's Alertmanager through the Kubernetes API or its URL." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritische Alerts sofort, Warnungen nach zwei Prüfungen in Folge, und wenn sie behoben sind; stummgeschaltete, unterdrückte und Info-Alerts benachrichtigen nie. Jede Prüfung fragt den Alertmanager des Clusters über die Kubernetes-API oder seine URL ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas críticas al momento, las advertencias vistas en dos comprobaciones seguidas, y cuando se resuelven; las silenciadas, inhibidas o info nunca notifican. Cada comprobación consulta el Alertmanager del clúster por la API de Kubernetes o su URL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes critiques tout de suite, les avertissements vus deux vérifications de suite, et leur résolution ; les alertes en silence, inhibées ou info ne notifient jamais. Chaque vérification interroge l'Alertmanager du cluster via l'API Kubernetes ou son URL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi critici subito, quelli di avviso visti in due controlli di fila, e quando si risolvono; quelli silenziati, inibiti o info non notificano mai. Ogni controllo interroga l'Alertmanager del cluster tramite l'API Kubernetes o il suo URL."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Критичні сповіщення одразу, попередження — після двох перевірок поспіль, а також їх вирішення; приглушені, пригнічені та інформаційні ніколи не сповіщають. Кожна перевірка звертається до Alertmanager кластера через Kubernetes API або його URL."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "严重告警立即通知，警告在连续两次检查中出现时通知，解决时也会通知；已静默、已抑制和信息级告警从不通知。每次检查通过 Kubernetes API 或其 URL 查询集群的 Alertmanager。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "critical のアラートは即座に、warning は2回連続のチェックで検出されたときに、また解決時にも通知します。サイレンス中、抑制中、info のアラートは通知しません。各チェックで Kubernetes API または URL を通じてクラスターの Alertmanager に問い合わせます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Alertas críticos imediatamente, avisos vistos em duas verificações seguidas, e quando são resolvidos; alertas silenciados, inibidos e info nunca notificam. Cada verificação consulta o Alertmanager do cluster pela API do Kubernetes ou pela URL dele." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Критичные оповещения — сразу, предупреждения — если замечены в двух проверках подряд, а также их разрешение; заглушённые, подавленные и информационные оповещения не уведомляют никогда. Каждая проверка опрашивает Alertmanager кластера через API Kubernetes или по его URL." } }
      }
    },
