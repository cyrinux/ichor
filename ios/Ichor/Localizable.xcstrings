    "For a machine that takes the place of %@ while cluster discovery still lists the old one. Its old addresses are never followed." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une machine qui prend la place de %@ alors que la découverte du cluster liste encore l'ancienne. Ses anciennes adresses ne sont jamais suivies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una máquina que ocupa el lugar de %@ mientras el descubrimiento del clúster aún lista la antigua. Sus direcciones antiguas nunca se siguen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine Maschine, die %@ ersetzt, während die Cluster-Erkennung die alte noch auflistet. Ihre alten Adressen werden nie verfolgt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una macchina che prende il posto di %@ mentre la scoperta del cluster elenca ancora quella vecchia. I suoi vecchi indirizzi non vengono mai seguiti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для машини, що заміняє %@, поки виявлення кластера ще показує стару. Її старі адреси ніколи не відстежуються."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于替代 %@ 的机器，此时集群发现仍列出旧机器。不会再访问其旧地址。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラスターディスカバリーに古いマシンがまだ表示されている状態で %@ を置き換えるマシン向けです。古いアドレスは追跡されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para uma máquina que toma o lugar de %@ enquanto a descoberta do cluster ainda lista a antiga. Os endereços antigos dela nunca são seguidos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для машины, которая занимает место %@, пока обнаружение кластера ещё показывает старую. Её старые адреса никогда не используются." } }
