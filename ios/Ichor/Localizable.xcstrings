    "Save your clusters and settings to a file encrypted with a passphrase, to restore them on a new phone (iOS or Android). Without the passphrase the file cannot be opened." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your clusters and settings to a file encrypted with a passphrase, to restore them on a new phone (iOS or Android). Without the passphrase the file cannot be opened."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos clusters et réglages dans un fichier chiffré par une phrase secrète, pour les restaurer sur un nouveau téléphone (iOS ou Android). Sans la phrase secrète, le fichier ne peut pas être ouvert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus clústeres y ajustes en un archivo cifrado con una frase de contraseña para restaurarlos en un teléfono nuevo (iOS o Android). Sin la frase de contraseña no se puede abrir el archivo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть кластери та налаштування у файл, зашифрований парольною фразою, щоб відновити їх на новому телефоні (iOS або Android). Без парольної фрази файл не відкрити."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deine Cluster und Einstellungen in einer mit einer Passphrase verschlüsselten Datei, um sie auf einem neuen Telefon (iOS oder Android) wiederherzustellen. Ohne die Passphrase lässt sich die Datei nicht öffnen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i tuoi cluster e le impostazioni in un file cifrato con una passphrase, per ripristinarli su un nuovo telefono (iOS o Android). Senza la passphrase il file non può essere aperto."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将集群和设置保存到用密码短语加密的文件中，以便在新手机（iOS 或 Android）上恢复。没有密码短语则无法打开该文件。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラスターと設定をパスフレーズで暗号化したファイルに保存し、新しいスマートフォン（iOS または Android）で復元できます。パスフレーズがないとファイルは開けません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Salve seus clusters e configurações em um arquivo criptografado com uma senha, para restaurá-los em um novo telefone (iOS ou Android). Sem a senha, o arquivo não pode ser aberto." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохраните кластеры и настройки в файл, зашифрованный парольной фразой, чтобы восстановить их на новом телефоне (iOS или Android). Без парольной фразы файл открыть невозможно." } }
      }
    },
    "Backup saved. Keep the passphrase somewhere safe." : {
