    "The stable version takes the traffic back and the new pods are scaled down. Retry starts the update again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die stabile Version übernimmt den Verkehr wieder, die neuen Pods werden herunterskaliert. Erneut versuchen startet das Update neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión estable recupera el tráfico y los nuevos pods se reducen. Reintentar vuelve a iniciar la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version stable reprend le trafic et les nouveaux pods sont réduits. Réessayer relance la mise à jour."
