          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请求在队列中等待，或部分响应为服务器错误。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リクエストがキューで待機しているか、応答の一部がサーバーエラーです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Requisições aguardam em filas, ou parte das respostas são erros do servidor." } },
