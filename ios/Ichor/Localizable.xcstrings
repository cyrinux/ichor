    "Ichor follows the iPhone language. To use another one for this app only, open its page in the Settings app and choose Language." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor folgt der Sprache des iPhone. Um nur für diese App eine andere zu nutzen, öffne ihre Seite in der App Einstellungen und wähle Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor usa el idioma del iPhone. Para usar otro solo en esta app, abre su página en la app Ajustes y elige Idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor suit la langue de l'iPhone. Pour en utiliser une autre pour cette app seulement, ouvrez sa page dans l'app Réglages et choisissez Langue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor segue la lingua dell'iPhone. Per usarne un'altra solo per questa app, apri la sua pagina nell'app Impostazioni e scegli Lingua."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor використовує мову iPhone. Щоб вибрати іншу лише для цього застосунку, відкрийте його сторінку в застосунку Параметри й виберіть Мова."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Ichor 跟随 iPhone 的语言。若只想为此应用使用其他语言，请在“设置”应用中打开其页面并选择“语言”。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor は iPhone の言語に従います。このアプリだけ別の言語を使うには、設定アプリで Ichor のページを開き「言語」を選択してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Ichor segue o idioma do iPhone. Para usar outro somente neste app, abra a página dele no app Ajustes e escolha Idioma." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ichor использует язык iPhone. Чтобы выбрать другой язык только для этого приложения, откройте его страницу в приложении «Настройки» и выберите «Язык»." } }
      }
    },
