    },
    "It keeps the VolumeSnapshot %@: delete that one instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il porte le VolumeSnapshot %@ : supprimez plutôt celui-ci."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene el VolumeSnapshot %@: elimina ese en su lugar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er enthält den VolumeSnapshot %@: löschen Sie stattdessen diesen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene il VolumeSnapshot %@: elimina quello invece."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він зберігає VolumeSnapshot %@: видаліть натомість його."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "它承载着 VolumeSnapshot %@：请改为删除该 VolumeSnapshot。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これは VolumeSnapshot %@ を保持しています。代わりにそちらを削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ele mantém o VolumeSnapshot %@: exclua esse em vez disso." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Он хранит VolumeSnapshot %@: удалите лучше его." } }
      }
    },
    "Your account cannot read the VolumeSnapshots: if one was taken from this snapshot, it could no longer be restored. Check with kubectl get volumesnapshots -A first." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte ne peut pas lire les VolumeSnapshots : si l’un d’eux a été pris depuis ce snapshot, il ne pourra plus être restauré. Vérifiez d’abord avec kubectl get volumesnapshots -A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no puede leer los VolumeSnapshots: si se tomó uno desde este snapshot, ya no podrá restaurarse. Compruébalo antes con kubectl get volumesnapshots -A."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Konto kann die VolumeSnapshots nicht lesen: Wurde einer aus diesem Snapshot erstellt, lässt er sich nicht mehr wiederherstellen. Prüfen Sie zuerst mit kubectl get volumesnapshots -A."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non può leggere i VolumeSnapshot: se uno è stato creato da questo snapshot, non potrà più essere ripristinato. Controlla prima con kubectl get volumesnapshots -A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш обліковий запис не може читати VolumeSnapshot: якщо з цього знімка було створено VolumeSnapshot, його вже не вдасться відновити. Спершу перевірте за допомогою kubectl get volumesnapshots -A."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的账号无法读取 VolumeSnapshot：如果有基于此快照创建的 VolumeSnapshot，它将无法再被恢复。请先用 kubectl get volumesnapshots -A 检查。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このアカウントでは VolumeSnapshot を読み取れません。このスナップショットから作成されたものがあると、復元できなくなります。先に kubectl get volumesnapshots -A で確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sua conta não pode ler os VolumeSnapshots: se algum foi criado a partir deste snapshot, ele não poderá mais ser restaurado. Verifique antes com kubectl get volumesnapshots -A." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вашему аккаунту запрещено читать VolumeSnapshots: если какой-то из них создан из этого снимка, его больше нельзя будет восстановить. Сначала проверьте командой kubectl get volumesnapshots -A." } }
      }
    },
