    "Every check passes and requests run without waiting." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les contrôles passent et les requêtes s'exécutent sans attendre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las comprobaciones pasan y las peticiones se ejecutan sin esperar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Prüfungen bestehen, Anfragen laufen ohne Wartezeit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i controlli passano e le richieste vengono eseguite senza attesa."
