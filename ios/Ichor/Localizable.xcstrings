        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1. 将其保存为 ichor-phone.yaml（如需其他命名空间，请将所有 ichor 替换掉），然后应用：" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "1. ichor-phone.yaml として保存し（別の名前空間にする場合は ichor をすべて置き換え）、適用します：" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "1. Salve como ichor-phone.yaml (para outro namespace, substitua ichor em todo lugar) e aplique:" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "1. Сохраните это как ichor-phone.yaml (для другого пространства имён замените ichor везде), затем примените:" } }
