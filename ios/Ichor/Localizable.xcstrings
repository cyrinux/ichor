          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteint le nœud ; il reste cordonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegne il nodo; resta isolato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимикає вузол; він залишається закордонованим."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭节点电源；节点保持禁止调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードの電源を切ります。スケジュール停止のままです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desliga o nó; ele continua isolado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключает узел; планирование остаётся запрещённым." } }
      }
    },
    "Reboots, waits until the node is Ready again, then uncordons it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet neu, wartet, bis der Knoten wieder Ready ist, und gibt ihn dann frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia, espera a que el nodo vuelva a estar Ready y luego quita el cordón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarre, attend que le nœud soit de nouveau Ready, puis lève le cordon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvia, attende che il nodo torni Ready, poi rimuove l’isolamento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезавантажує, чекає, доки вузол знову стане Ready, потім знімає кордон."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重启，等待节点再次 Ready，然后恢复调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再起動し、ノードが再び Ready になるのを待ってから、スケジュールを再開します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reinicia, aguarda até o nó estar Ready novamente e depois o libera." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перезагружает узел, ждёт, пока он снова станет Ready, затем разрешает планирование." } }
      }
    },
