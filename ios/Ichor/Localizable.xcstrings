    "Collecting takes a few minutes per node. Keep the app open: the screen stays on meanwhile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sammeln dauert einige Minuten pro Knoten. Lass die App geöffnet: Der Bildschirm bleibt währenddessen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recopilación tarda unos minutos por nodo. Mantén la app abierta: la pantalla permanece encendida mientras tanto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La collecte prend quelques minutes par nœud. Gardez l'app ouverte : l'écran reste allumé pendant ce temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
