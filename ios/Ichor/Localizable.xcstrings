    "Until acknowledged or snoozed; iOS checks every 15 min at most, so 5 min means each check." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zur Bestätigung oder Pause; iOS prüft höchstens alle 15 Min., 5 Min. heißt also bei jeder Prüfung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta confirmarla o posponerla; iOS comprueba como mucho cada 15 min, así que 5 min significa en cada comprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à l’acquittement ou au report ; iOS vérifie au plus toutes les 15 min, donc 5 min signifie à chaque vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché non lo confermi o lo posticipi; iOS controlla al massimo ogni 15 min, quindi 5 min significa a ogni controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認またはスヌーズするまで。iOS のチェックは最短 15 分ごとなので、5 分は毎回のチェックを意味します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até confirmar ou adiar; o iOS verifica no máximo a cada 15 min, então 5 min significa a cada verificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока не подтвердите или не отложите; iOS проверяет не чаще чем раз в 15 мин, так что 5 мин значит при каждой проверке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доки не підтвердите або не відкладете; iOS перевіряє щонайбільше раз на 15 хв, тож 5 хв означає щоразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直到确认或暂停；iOS 最快每 15 分钟检查一次，因此 5 分钟即每次检查。"
          }
        }
      }
    },
