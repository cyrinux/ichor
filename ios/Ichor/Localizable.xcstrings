        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "控制平面会依次重启其组件，然后每个 kubelet 重启。回退到之前的版本需要再进行一次升级。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コントロールプレーンがコンポーネントを 1 つずつ再起動し、その後各 kubelet が再起動します。以前のバージョンに戻すには、別途アップグレードが必要です。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os control planes reiniciam seus componentes um após o outro, e depois cada kubelet reinicia. Voltar à versão anterior é outra atualização." } },
