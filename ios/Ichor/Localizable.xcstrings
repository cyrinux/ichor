          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备无法读取 NFC。请改为插入密钥。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このデバイスは NFC を読み取れません。代わりにキーを接続してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este dispositivo não lê NFC. Conecte a chave em vez disso." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это устройство не умеет читать NFC. Подключите ключ." } }
      }
    },
    "This key asks for its FIDO PIN, which Ichor does not use to unlock." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
