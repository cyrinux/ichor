    "%@ deploys this with self-heal on: within minutes it puts it back as Git has it. Freeze %@ first to keep your change for a while." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stellt dies mit aktiver Selbstheilung bereit: Innerhalb von Minuten setzt es das auf den Stand in Git zurück. Friere %@ zuerst ein, um deine Änderung eine Weile zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deploys this with self-heal on: within minutes it puts it back as Git has it. Freeze %@ first to keep your change for a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ despliega esto con la autorreparación activada: en minutos lo devuelve a como está en Git. Congela %@ antes para conservar tu cambio un tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ déploie ceci avec l'auto-réparation active : en quelques minutes, il le remet comme dans Git. Gelez %@ d'abord pour garder votre changement un moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ distribuisce questo con l'auto-riparazione attiva: in pochi minuti lo riporta come è in Git. Congela prima %@ per mantenere la modifica per un po'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ розгортає це з увімкненим самовідновленням: за кілька хвилин воно поверне це до стану в Git. Спершу заморозьте %@, щоб зберегти зміну на якийсь час."
          }
        }
      }
    },
