    "--force upgrades even though etcd is unhealthy or would lose quorum. The cluster can become unavailable and etcd data can be lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--force aktualisiert auch, wenn etcd fehlerhaft ist oder das Quorum verlieren würde. Der Cluster kann ausfallen und etcd-Daten können verloren gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--force actualiza aunque etcd no esté sano o pierda el quórum. El clúster puede quedar no disponible y se pueden perder datos de etcd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--force met à jour même si etcd est en mauvaise santé ou perdrait le quorum. Le cluster peut devenir indisponible et des données etcd peuvent être perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--force aggiorna anche se etcd non è integro o perderebbe il quorum. Il cluster può diventare non disponibile e i dati etcd possono andare persi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--force оновлює, навіть якщо etcd несправний або втратить кворум. Кластер може стати недоступним, а дані etcd можуть бути втрачені."
          }
        }
      }
    },
