    "Reads the failed checks, node readiness and recent events with the model on this phone. Nothing leaves it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Analyse les vérifications en échec, l’état des nœuds et les événements récents avec le modèle de ce téléphone. Rien n’en sort." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Analiza las comprobaciones fallidas, el estado de los nodos y los eventos recientes con el modelo de este teléfono. Nada sale de él." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Аналізує невдалі перевірки, стан вузлів і недавні події моделлю на цьому телефоні. Нічого не виходить за його межі." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wertet die fehlgeschlagenen Prüfungen, die Bereitschaft der Knoten und die letzten Ereignisse mit dem Modell auf diesem Telefon aus. Nichts verlässt es." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Analizza i controlli non riusciti, lo stato dei nodi e gli eventi recenti con il modello su questo telefono. Nulla esce dal telefono." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用此手机上的模型读取失败的检查项、节点就绪状态和最近事件。数据不会离开手机。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "失敗したチェック、ノードの準備状態、最近のイベントをこのスマートフォン上のモデルで読み取ります。外部には何も送信されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lê as verificações com falha, a prontidão dos nós e os eventos recentes com o modelo neste telefone. Nada sai dele." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Анализирует непройденные проверки, готовность узлов и недавние события с помощью модели на этом телефоне. Ничего не покидает устройство." } }
      }
    },
    "Your messages, the source’s metric names and the current panel stay on this phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos messages, les noms de métriques de la source et le panneau en cours restent sur ce téléphone." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus mensajes, los nombres de métricas de la fuente y el panel actual se quedan en este teléfono." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваші повідомлення, назви метрик джерела й поточна панель залишаються на цьому телефоні." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Nachrichten, die Metriknamen der Quelle und das aktuelle Panel bleiben auf diesem Telefon." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I tuoi messaggi, i nomi delle metriche della sorgente e il pannello corrente restano su questo telefono." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的消息、数据源的指标名称和当前面板都保留在此手机上。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メッセージ、ソースのメトリクス名、現在のパネルはこのスマートフォン上にとどまります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Suas mensagens, os nomes das métricas da origem e o painel atual ficam neste celular." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши сообщения, имена метрик источника и текущая панель остаются на этом телефоне." } }
