    "Velero starts a backup with this schedule's settings (namespaces: %@, storage location: %@). It runs next to the scheduled ones and expires like them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero startet eine Sicherung mit den Einstellungen dieses Zeitplans (Namespaces: %1$@, Speicherort: %2$@). Sie kommt zu den geplanten hinzu und läuft wie diese ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero starts a backup with this schedule's settings (namespaces: %1$@, storage location: %2$@). It runs next to the scheduled ones and expires like them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero inicia una copia con los ajustes de esta programación (namespaces: %1$@, ubicación de almacenamiento: %2$@). Se suma a las programadas y caduca como ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero lance une sauvegarde avec les réglages de cette planification (namespaces : %1$@, emplacement de stockage : %2$@). Elle s’ajoute aux sauvegardes planifiées et expire comme elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero avvia un backup con le impostazioni di questa pianificazione (namespace: %1$@, posizione di archiviazione: %2$@). Si aggiunge a quelli pianificati e scade come loro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero запускає копію з налаштуваннями цього розкладу (простори імен: %1$@, сховище: %2$@). Вона додається до запланованих і спливає так само."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Velero 会按此计划的设置启动一次备份（命名空间：%1$@，存储位置：%2$@）。它与计划备份并行运行，并以相同方式过期。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Velero はこのスケジュールの設定（名前空間：%1$@、ストレージロケーション：%2$@）でバックアップを開始します。スケジュールされたバックアップとは別に実行され、同様に期限切れになります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Velero inicia um backup com as configurações deste agendamento (namespaces: %1$@, local de armazenamento: %2$@). Ele roda junto com os agendados e expira como eles." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Velero запускает резервное копирование с настройками этого расписания (пространства имён: %1$@, место хранения: %2$@). Оно выполняется наряду с плановыми и истекает так же, как они." } }
      }
