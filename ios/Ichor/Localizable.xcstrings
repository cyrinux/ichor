    "The forward keeps listening: each connection is tried again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La redirection reste à l'écoute : chaque connexion est retentée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reenvío sigue escuchando: cada conexión se vuelve a intentar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Weiterleitung lauscht weiter: Jede Verbindung wird erneut versucht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inoltro resta in ascolto: ogni connessione viene ritentata."
