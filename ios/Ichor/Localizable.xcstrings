        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Полный контроль, включая секреты и выпуск сертификатов" } }
      }
    },
    "Generate a dedicated identity instead of copying your admin ~/.talos/config: if the phone is lost, its certificate only grants what you chose, and it expires on its own." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeuge eine eigene Identität, statt deine Admin-~/.talos/config zu kopieren: Geht das Telefon verloren, gewährt sein Zertifikat nur das Gewählte und läuft von selbst ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera una identidad dedicada en lugar de copiar tu ~/.talos/config de administrador: si pierdes el teléfono, su certificado solo concede lo que elegiste y caduca por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez une identité dédiée au lieu de copier votre ~/.talos/config admin : si le téléphone est perdu, son certificat n'accorde que ce que vous avez choisi, et il expire de lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera un'identità dedicata invece di copiare il tuo ~/.talos/config di amministratore: se perdi il telefono, il suo certificato concede solo ciò che hai scelto e scade da solo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть окрему ідентичність замість копіювання адміністраторського ~/.talos/config: якщо телефон загубиться, його сертифікат дає лише вибрані права й сам закінчиться."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "生成一个专用身份，而不是复制你的管理员 ~/.talos/config：如果手机丢失，其证书只授予你所选的权限，并且会自动过期。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "管理者用の ~/.talos/config をコピーするのではなく、専用の ID を生成してください。スマートフォンを紛失しても、その証明書には選択した権限しかなく、自動的に期限切れになります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gere uma identidade dedicada em vez de copiar seu ~/.talos/config de administrador: se o celular for perdido, o certificado dele só concede o que você escolheu, e ele expira sozinho." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создайте отдельную идентичность вместо копирования вашего ~/.talos/config администратора: если телефон потеряется, его сертификат даёт только выбранные вами права и истекает сам." } }
      }
    },
    "Give the least access needed: os:reader cannot change anything." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib nur den nötigsten Zugriff: os:reader kann nichts ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da el mínimo acceso necesario: os:reader no puede cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez le moins d'accès possible : os:reader ne peut rien modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi il minimo accesso necessario: os:reader non può modificare nulla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надавайте мінімально потрібний доступ: os:reader нічого не може змінити."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只授予所需的最小权限：os:reader 无法更改任何内容。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "必要最小限のアクセス権を付与してください：os:reader は何も変更できません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conceda o mínimo de acesso necessário: os:reader não pode alterar nada." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Давайте минимально необходимый доступ: os:reader ничего не может изменить." } }
      }
    },
    "Graceful" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulär"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinato"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正常" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "グレースフル" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Штатно" } }
      }
    },
    "Graceful stop, then a full firmware reboot instead of kexec." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguläres Stoppen, dann ein vollständiger Firmware-Neustart statt kexec."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parada ordenada y luego un reinicio completo del firmware en lugar de kexec."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt normal, puis redémarrage complet par le firmware au lieu de kexec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresto ordinato, poi un riavvio completo del firmware invece di kexec."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавна зупинка, потім повне перезавантаження через прошивку замість kexec."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正常停止后，由固件执行完整重启，而不是 kexec。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "グレースフルに停止し、kexec ではなくファームウェアからの完全な再起動を行います。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parada normal, depois um reinício completo pelo firmware em vez do kexec." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Штатная остановка, затем полная перезагрузка через прошивку вместо kexec." } }
      }
    },
    "Grants cluster access with these roles until it expires; it cannot be revoked short of rotating the cluster CA." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewährt bis zum Ablauf Zugriff auf den Cluster mit diesen Rollen; widerrufen lässt sie sich nur durch Austausch der Cluster-CA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da acceso al clúster con estos roles hasta que caduque; solo se puede revocar rotando la CA del clúster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne accès au cluster avec ces rôles jusqu'à son expiration ; il ne peut être révoqué qu'en renouvelant la CA du cluster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede l'accesso al cluster con questi ruoli fino alla scadenza; si può revocare solo ruotando la CA del cluster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надає доступ до кластера з цими ролями до спливу терміну; відкликати його можна лише заміною CA кластера."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在到期前以这些角色授予集群访问权限；除非轮换集群 CA，否则无法撤销。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "有効期限までこれらのロールでクラスターへのアクセスを許可します。クラスターの CA をローテーションしない限り失効させることはできません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Concede acesso ao cluster com esses papéis até expirar; não pode ser revogado sem rotacionar a CA do cluster." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Даёт доступ к кластеру с этими ролями до истечения срока; отозвать его можно только ротацией CA кластера." } }
      }
    },
