    "Salvage may lose data. Choose the replicas whose data you want to recover; their timestamps do not guarantee consistency." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvage may lose data. Choose the replicas whose data you want to recover; their timestamps do not guarantee consistency."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération peut perdre des données. Choisissez les répliques à récupérer ; leurs horodatages ne garantissent pas la cohérence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación puede perder datos. Elija las réplicas cuyos datos desea recuperar; sus marcas de tiempo no garantizan la coherencia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення може призвести до втрати даних. Виберіть репліки для відновлення; їхні часові мітки не гарантують узгодженості."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rettung kann Datenverlust verursachen. Wählen Sie die wiederherzustellenden Replikate; ihre Zeitstempel garantieren keine Konsistenz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero può perdere dati. Scegli le repliche da recuperare; i loro timestamp non garantiscono la coerenza."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "抢救可能丢失数据。选择要恢复其数据的副本；副本的时间戳并不保证一致性。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サルベージではデータが失われる可能性があります。データを復旧するレプリカを選択してください。タイムスタンプは整合性を保証しません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O salvamento pode perder dados. Escolha as réplicas cujos dados você quer recuperar; os timestamps delas não garantem consistência." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Спасение тома может привести к потере данных. Выберите реплики, данные которых нужно восстановить; их метки времени не гарантируют согласованность." } }
      }
    },
    "Choose replicas explicitly. No replica is selected automatically." : {
      "extractionState" : "manual",
      "localizations" : {
