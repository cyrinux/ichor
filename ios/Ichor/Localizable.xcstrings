    "Hidden while the screen is recorded or mirrored." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendet, während der Bildschirm aufgenommen oder gespiegelt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculto mientras se graba o duplica la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masqué pendant l'enregistrement ou la recopie de l'écran."
          }
