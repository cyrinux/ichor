    "Every pod of %@ stops: what it serves is down until it is scaled up again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Pods von %@ stoppen: Was er bereitstellt, ist nicht erreichbar, bis er wieder hochskaliert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los pods de %@ se detienen: lo que sirve queda caído hasta que se vuelva a escalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les pods de %@ s’arrêtent : ce qu’il sert est indisponible jusqu’à ce qu’il soit remis à l’échelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i pod di %@ si fermano: ciò che serve resta giù finché non viene scalato di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі поди %@ зупиняться: те, що він обслуговує, буде недоступне, доки його знову не масштабують."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 的所有 Pod 都会停止：在重新扩容之前，其提供的服务将中断。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のすべての Pod が停止します。再びスケールアップするまで、提供しているサービスはダウンします。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Todos os pods de %@ param: o que ele atende fica fora do ar até ser escalado novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Все поды %@ останавливаются: то, что он обслуживает, не работает, пока его снова не масштабируют." } }
      }
    },
    "From %lld to %lld replicas in %@, like kubectl scale." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
