    "An imported plugin reads only the resources it declares, with your own Kubernetes access, and talks to nothing but the Kubernetes API." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein importiertes Plugin liest nur die Ressourcen, die es angibt, mit deinem eigenen Kubernetes-Zugang, und spricht mit nichts außer der Kubernetes-API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plugin importado solo lee los recursos que declara, con tu propio acceso a Kubernetes, y no habla con nada más que la API de Kubernetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plugin importé ne lit que les ressources qu'il déclare, avec votre propre accès Kubernetes, et ne contacte rien d'autre que l'API Kubernetes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plugin importato legge solo le risorse che dichiara, con il tuo accesso Kubernetes, e non comunica con nient'altro che l'API Kubernetes."
          }
