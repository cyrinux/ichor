    },
    "Keep last known state" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzten bekannten Zustand behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar el último estado conocido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver le dernier état connu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva l'ultimo stato noto"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігати останній відомий стан"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留上次已知状态" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最後に確認した状態を保持" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Manter o último estado conhecido" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранять последнее известное состояние" } }
      }
    },
    "Save the last data fetched from each cluster on this phone, encrypted, so it still shows when the cluster can't be reached. Kept for 24 hours and never backed up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert die zuletzt von jedem Cluster abgerufenen Daten verschlüsselt auf diesem Telefon, damit sie auch angezeigt werden, wenn der Cluster nicht erreichbar ist. 24 Stunden lang aufbewahrt und nie gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda en este teléfono, cifrados, los últimos datos obtenidos de cada clúster, para que se sigan mostrando cuando no se pueda acceder al clúster. Se conservan 24 horas y nunca se incluyen en copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre sur ce téléphone, chiffrées, les dernières données récupérées de chaque cluster, pour qu'elles restent affichées quand le cluster est injoignable. Conservées 24 heures et jamais sauvegardées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva su questo telefono, cifrati, gli ultimi dati recuperati da ogni cluster, così restano visibili quando il cluster non è raggiungibile. Conservati per 24 ore e mai inclusi nei backup."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає на цьому телефоні в зашифрованому вигляді останні дані, отримані з кожного кластера, щоб їх було видно, коли кластер недоступний. Зберігаються 24 години й ніколи не потрапляють до резервних копій."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在此手机上加密保存从每个集群获取的最新数据，以便集群无法访问时仍可显示。保留 24 小时，且从不备份。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "各クラスターから最後に取得したデータをこのスマートフォンに暗号化して保存し、クラスターに到達できないときも表示します。24時間保持され、バックアップされることはありません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Salva neste telefone, criptografados, os últimos dados obtidos de cada cluster, para que continuem aparecendo quando o cluster estiver inacessível. Mantidos por 24 horas e nunca incluídos em backups." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранять на этом телефоне в зашифрованном виде последние полученные данные каждого кластера, чтобы показывать их, когда кластер недоступен. Хранятся 24 часа и никогда не попадают в резервные копии." } }
      }
    },
