          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La replica è indietro rispetto al primario. La promozione può causare perdita di dati."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "副本落后于主库。提升可能导致数据丢失。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レプリカがプライマリより遅れています。昇格するとデータが失われる可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A réplica está atrasada em relação ao primário. A promoção pode perder dados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Реплика отстаёт от primary. При повышении возможна потеря данных." } }
      }
    },
    "Replication lag could not be verified. Promotion may lose data." : {
      "extractionState" : "manual",
      "localizations" : {
