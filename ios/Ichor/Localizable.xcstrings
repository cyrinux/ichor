    "Only this phone can open the forwarded port, and only while Ichor stays open: nothing listens on the network the phone is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul ce téléphone peut ouvrir le port redirigé, et seulement tant qu'Ichor reste ouvert : rien n'écoute sur le réseau du téléphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo este teléfono puede abrir el puerto reenviado, y solo mientras Ichor siga abierto: nada escucha en la red del teléfono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieses Telefon kann den weitergeleiteten Port öffnen, und nur solange Ichor geöffnet bleibt: Im Netzwerk des Telefons lauscht nichts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo questo telefono può aprire la porta inoltrata, e solo finché Ichor resta aperta: nulla è in ascolto sulla rete del telefono."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише цей телефон може відкрити переадресований порт і лише поки Ichor відкритий: у мережі телефона ніщо не слухає."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有这台手机能访问转发的端口，且仅在 Ichor 保持打开时有效：手机所在网络上不会有任何监听。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "転送されたポートを開けるのはこのスマートフォンだけで、Ichor が開いている間に限られます。スマートフォンが接続しているネットワーク上では何も待ち受けません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Só este celular pode abrir a porta encaminhada, e apenas enquanto o Ichor estiver aberto: nada escuta na rede em que o celular está." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть перенаправленный порт может только этот телефон и только пока Ichor открыт: в сети телефона ничего не слушает." } }
      }
    },
