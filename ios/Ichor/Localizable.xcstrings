    "Each step asks for its own confirmation. The steps are read from the cluster: leave and come back at any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque étape demande sa propre confirmation. Les étapes sont lues depuis le cluster : vous pouvez quitter et revenir à tout moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada paso pide su propia confirmación. Los pasos se leen del clúster: puedes salir y volver en cualquier momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schritt verlangt eine eigene Bestätigung. Die Schritte werden aus dem Cluster gelesen: Sie können jederzeit gehen und zurückkehren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
