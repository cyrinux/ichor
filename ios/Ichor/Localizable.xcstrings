        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@？" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%2$@ を%1$@しますか？" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ %2$@?" } }
      }
    },
    "The guest is asked to shut down, then the instance is deleted after its grace period. The VM keeps its disks." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invité est prié de s’éteindre, puis l’instance est supprimée après son délai de grâce. La VM garde ses disques."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pide al invitado que se apague y la instancia se elimina tras su periodo de gracia. La VM conserva sus discos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гостьову систему просять вимкнутися, потім екземпляр видаляється після пільгового періоду. ВМ зберігає свої диски."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gast wird zum Herunterfahren aufgefordert, dann wird die Instanz nach ihrer Gnadenfrist gelöscht. Die VM behält ihre Disks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guest viene chiesto di spegnersi, poi l’istanza viene eliminata dopo il periodo di tolleranza. La VM conserva i suoi dischi."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会请求客户机关机，然后在宽限期后删除实例。虚拟机会保留其磁盘。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲストにシャットダウンを要求し、猶予期間の後にインスタンスを削除します。VM のディスクは保持されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O convidado é solicitado a desligar e a instância é excluída após o período de carência. A VM mantém os discos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Гостевой системе отправляется запрос на выключение, затем экземпляр удаляется после периода ожидания. VM сохраняет свои диски." } }
      }
    },
    "The instance is deleted and started again: the guest reboots and loses what is only in memory." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’instance est supprimée puis relancée : l’invité redémarre et perd ce qui n’est qu’en mémoire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instancia se elimina y se vuelve a iniciar: el invitado se reinicia y pierde lo que solo está en memoria."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екземпляр видаляється й запускається знову: гостьова система перезавантажується й втрачає те, що є лише в пам’яті."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Instanz wird gelöscht und neu gestartet: der Gast bootet neu und verliert, was nur im Speicher liegt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’istanza viene eliminata e riavviata: il guest si riavvia e perde ciò che è solo in memoria."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实例会被删除并重新启动：客户机将重启，并丢失仅存在于内存中的内容。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "インスタンスを削除して再起動します。ゲストは再起動し、メモリ上にしかないものは失われます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A instância é excluída e iniciada novamente: o convidado reinicia e perde o que está apenas na memória." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экземпляр удаляется и запускается заново: гостевая система перезагружается и теряет всё, что было только в памяти." } }
      }
    },
    "Its run strategy is Always: stopping sets it to Halted in the VM’s spec. A GitOps tool may set it back on its next sync." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa stratégie d’exécution est Always : l’arrêt la passe à Halted dans la spec de la VM. Un outil GitOps peut la rétablir à sa prochaine synchronisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su estrategia de ejecución es Always: detenerla la cambia a Halted en la spec de la VM. Una herramienta GitOps puede revertirlo en su próxima sincronización."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її стратегія запуску Always: зупинка змінює її на Halted у spec ВМ. Інструмент GitOps може повернути її під час наступної синхронізації."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Run-Strategie ist Always: Stoppen setzt sie in der Spec der VM auf Halted. Ein GitOps-Tool kann das beim nächsten Sync zurücksetzen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua strategia di esecuzione è Always: l’arresto la imposta su Halted nella spec della VM. Uno strumento GitOps può ripristinarla alla prossima sincronizzazione."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其运行策略为 Always：停止会在虚拟机的 spec 中将其设为 Halted。GitOps 工具可能会在下次同步时将其改回。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行戦略が Always のため、停止すると VM の spec で Halted に設定されます。GitOps ツールが次回の同期で元に戻す可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A estratégia de execução é Always: parar a define como Halted na spec da VM. Uma ferramenta de GitOps pode restaurá-la na próxima sincronização." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Её стратегия запуска — Always: остановка меняет её на Halted в spec VM. Инструмент GitOps может вернуть её при следующей синхронизации." } }
      }
    },
    "Force: no grace period" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer : sans délai de grâce"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar: sin periodo de gracia"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примусово: без пільгового періоду"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzwingen: ohne Gnadenfrist"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza: senza periodo di tolleranza"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强制：无宽限期" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "強制：猶予期間なし" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Forçar: sem período de carência" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Принудительно: без периода ожидания" } }
      }
    },
    "Live-migrates the running VM off %@ to a node the scheduler picks. The guest keeps running." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migre à chaud la VM depuis %@ vers un nœud choisi par l’ordonnanceur. L’invité continue de tourner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migra en caliente la VM desde %@ a un nodo que elige el planificador. El invitado sigue en ejecución."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Живо мігрує ВМ з %@ на вузол, який обере планувальник. Гостьова система продовжує працювати."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migriert die laufende VM live von %@ auf einen vom Scheduler gewählten Node. Der Gast läuft weiter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migra a caldo la VM da %@ a un nodo scelto dallo scheduler. Il guest continua a funzionare."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将运行中的虚拟机从 %@ 实时迁移到调度器选择的节点。客户机保持运行。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行中の VM を %@ からスケジューラーが選んだノードへライブマイグレーションします。ゲストは動作し続けます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Migra ao vivo a VM em execução de %@ para um nó escolhido pelo scheduler. O convidado continua em execução." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выполняет живую миграцию работающей ВМ с %@ на узел, выбранный планировщиком. Гостевая ОС продолжает работать." } }
      }
    },
    "The guest’s CPUs are frozen until it is unpaused; its memory stays." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les CPU de l’invité sont gelés jusqu’à la reprise ; sa mémoire est conservée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las CPU del invitado se congelan hasta reanudarlo; su memoria se conserva."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесори гостьової системи заморожено до відновлення; її пам’ять зберігається."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die CPUs des Gastes werden bis zum Fortsetzen eingefroren; sein Speicher bleibt erhalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le CPU del guest restano bloccate fino alla ripresa; la sua memoria resta."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机的 CPU 会被冻结，直到取消暂停；其内存保持不变。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再開されるまでゲストの CPU は凍結されます。メモリは保持されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As CPUs do convidado ficam congeladas até que ele seja retomado; a memória é mantida." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "CPU гостевой системы замораживаются до возобновления; её память сохраняется." } }
      }
    },
    "KubeVirt applies it in a few seconds; the list follows the new status." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KubeVirt l’applique en quelques secondes ; la liste suit le nouvel état."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KubeVirt lo aplica en unos segundos; la lista sigue el nuevo estado."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KubeVirt застосує це за кілька секунд; список покаже новий стан."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KubeVirt wendet es in wenigen Sekunden an; die Liste folgt dem neuen Status."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KubeVirt lo applica in pochi secondi; l’elenco segue il nuovo stato."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "KubeVirt 会在几秒内应用；列表会跟随新状态更新。" } },
