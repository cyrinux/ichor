        }
      }
    },
    "Rates use consecutive samples. Disk activity and average I/O time are evidence, not proof of saturation." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rates use consecutive samples. Disk activity and average I/O time are evidence, not proof of saturation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les débits utilisent des mesures consécutives. L’activité disque et le temps moyen des E/S sont des indices, pas une preuve de saturation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tasas usan muestras consecutivas. La actividad del disco y el tiempo medio de E/S son indicios, no pruebas de saturación."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкості обчислюються за послідовними вимірами. Активність диска та середній час вводу/виводу є ознаками, а не доказом насичення."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raten verwenden aufeinanderfolgende Messungen. Datenträgeraktivität und mittlere E/A-Zeit sind Hinweise, kein Beweis für Sättigung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le velocità usano campioni consecutivi. Attività del disco e tempo medio di I/O sono indizi, non prove di saturazione."
          }
        }
      }
    },
    "Compare selected effective settings: DNS, NTP, MTU, extensions, Secure Boot, UKI and Talos version. Differences may be intentional; unavailable fields are unknown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
