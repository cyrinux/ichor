        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@を削除しますか？" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Excluir %@?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить %@?" } }
      }
    },
    "Protected: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégé : %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protegido: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschützt: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protetto: %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
