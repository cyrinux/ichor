    "The Talos upgrade can stall while Ichor is in the background. Open it until the node reboots." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Talos-Upgrade kann hängen bleiben, während Ichor im Hintergrund ist. Öffne die App, bis der Knoten neu startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización de Talos puede detenerse mientras Ichor está en segundo plano. Ábrelo hasta que el nodo se reinicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour Talos peut se bloquer tant qu'Ichor est en arrière-plan. Ouvrez-le jusqu'au redémarrage du nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento di Talos può bloccarsi mentre Ichor è in background. Aprilo finché il nodo non si riavvia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення Talos може зупинитися, поки Ichor у фоні. Відкрийте його, доки вузол не перезавантажиться."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Ichor 在后台时 Talos 升级可能会停滞。在节点重启前保持其打开。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor がバックグラウンドにある間、Talos のアップグレードが停滞することがあります。ノードが再起動するまで開いておいてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A atualização do Talos pode travar enquanto o Ichor está em segundo plano. Mantenha-o aberto até o nó reiniciar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновление Talos может зависнуть, пока Ichor в фоне. Держите приложение открытым до перезагрузки узла." } }
      }
    },
    "Keep Ichor open until the node reboots: in the background iOS can pause the app, and the upgrade with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Ichor geöffnet, bis der Knoten neu startet: Im Hintergrund kann iOS die App pausieren und damit auch das Upgrade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Ichor abierto hasta que el nodo se reinicie: en segundo plano iOS puede pausar la app, y con ella la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Ichor ouvert jusqu'au redémarrage du nœud : en arrière-plan, iOS peut mettre l'app en pause, et la mise à jour avec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Ichor aperto finché il nodo non si riavvia: in background iOS può sospendere l'app, e con essa l'aggiornamento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривайте Ichor, доки вузол не перезавантажиться: у фоні iOS може призупинити застосунок, а разом з ним і оновлення."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在节点重启前保持 Ichor 打开：在后台时 iOS 可能会暂停应用，升级也会随之暂停。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードが再起動するまで Ichor を開いたままにしてください：バックグラウンドでは iOS によりアプリが一時停止され、アップグレードも止まる可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mantenha o Ichor aberto até o nó reiniciar: em segundo plano, o iOS pode pausar o app e, com ele, a atualização." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не закрывайте Ichor до перезагрузки узла: в фоне iOS может приостановить приложение, а вместе с ним и обновление." } }
      }
    },
    "Keep Ichor open until the node reboots" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
