      }
    },
    "Read the Synced condition’s message: credentials, quota or a conflicting external resource. Pause it if it flaps." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez le message de la condition Synced : identifiants, quota ou ressource externe en conflit. Mettez-la en pause si elle oscille."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lea el mensaje de la condición Synced: credenciales, cuota o un recurso externo en conflicto. Póngalo en pausa si oscila."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen Sie die Meldung der Bedingung Synced: Zugangsdaten, Kontingent oder eine kollidierende externe Ressource. Pausieren Sie sie, wenn sie schwankt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi il messaggio della condizione Synced: credenziali, quota o una risorsa esterna in conflitto. Mettila in pausa se oscilla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте повідомлення умови Synced: облікові дані, квота або конфліктний зовнішній ресурс. Призупиніть його, якщо стан коливається."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看 Synced 条件的消息：凭据、配额或冲突的外部资源。如果它反复变化，将其暂停。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Synced コンディションのメッセージを確認してください：認証情報、クォータ、または競合する外部リソース。状態が頻繁に変わる場合は一時停止してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Leia a mensagem da condição Synced: credenciais, cota ou um recurso externo em conflito. Pause-o se ele oscilar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прочитайте сообщение условия Synced: учётные данные, квота или конфликтующий внешний ресурс. Приостановите ресурс, если его состояние скачет." } }
      }
    },
    "Every resource of this package stops reconciling. Check that its image can be pulled (registry, tag, pull secret), then the logs of its pod." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus aucune ressource de ce paquet n’est réconciliée. Vérifiez que son image peut être tirée (registre, tag, secret de pull), puis les journaux de son pod."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún recurso de este paquete se reconcilia. Compruebe que su imagen se puede descargar (registro, etiqueta, secreto de pull) y luego los registros de su pod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Ressource dieses Pakets wird mehr abgeglichen. Prüfen Sie, ob sein Image geladen werden kann (Registry, Tag, Pull-Secret), dann die Logs seines Pods."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna risorsa di questo pacchetto viene più riconciliata. Controlla che la sua immagine si possa scaricare (registry, tag, pull secret), poi i log del suo pod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоден ресурс цього пакета більше не узгоджується. Перевірте, що його образ можна завантажити (реєстр, тег, pull secret), потім журнали його пода."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此包的所有资源都会停止协调。检查其镜像能否拉取（仓库、标签、拉取 Secret），然后查看其 Pod 的日志。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このパッケージのすべてのリソースの調整が止まります。イメージをプルできるか（レジストリ、タグ、プルシークレット）確認し、次に Pod のログを確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Todos os recursos deste pacote param de ser reconciliados. Verifique se a imagem dele pode ser baixada (registry, tag, pull secret) e depois os logs do pod dele." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Все ресурсы этого пакета перестают согласовываться. Проверьте, что его образ загружается (реестр, тег, pull secret), затем журналы его пода." } }
      }
    },
    "The provider has not finished creating it, or the external resource is unavailable. Check the object’s events and the resource on the provider’s side." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur n’a pas fini de la créer, ou la ressource externe est indisponible. Vérifiez les événements de l’objet et la ressource côté fournisseur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor no ha terminado de crearlo, o el recurso externo no está disponible. Revise los eventos del objeto y el recurso en el lado del proveedor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Provider hat sie noch nicht fertig erstellt, oder die externe Ressource ist nicht verfügbar. Prüfen Sie die Ereignisse des Objekts und die Ressource beim Provider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider non ha finito di crearla, oppure la risorsa esterna non è disponibile. Controlla gli eventi dell’oggetto e la risorsa dal lato del provider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер ще не завершив його створення, або зовнішній ресурс недоступний. Перевірте події об’єкта та ресурс на боці провайдера."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "provider 尚未完成创建，或外部资源不可用。检查该对象的事件以及 provider 侧的资源。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロバイダーが作成を完了していないか、外部リソースが利用できません。オブジェクトのイベントと、プロバイダー側のリソースを確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O provider ainda não terminou de criá-lo, ou o recurso externo está indisponível. Verifique os eventos do objeto e o recurso no lado do provider." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Провайдер ещё не закончил его создание или внешний ресурс недоступен. Проверьте события объекта и ресурс на стороне провайдера." } }
      }
    },
    "Its composite kind is not served, so nothing of that kind can be created. Look for a CRD that conflicts with it or an invalid schema." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son type composite n’est pas servi : rien de ce type ne peut être créé. Cherchez un CRD en conflit avec elle ou un schéma invalide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su tipo compuesto no se sirve, así que no se puede crear nada de ese tipo. Busque un CRD en conflicto con ella o un esquema no válido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Composite-Art wird nicht bereitgestellt, also kann nichts dieser Art erstellt werden. Suchen Sie nach einer kollidierenden CRD oder einem ungültigen Schema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo tipo composito non è servito, quindi non si può creare nulla di quel tipo. Cerca una CRD in conflitto o uno schema non valido."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її композитний тип не обслуговується, тож нічого цього типу не можна створити. Шукайте конфліктний CRD або недійсну схему."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其组合类型未被提供，因此无法创建该类型的任何对象。查找与之冲突的 CRD 或无效的 schema。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コンポジットの kind が提供されていないため、その kind のものは作成できません。競合する CRD や無効なスキーマがないか確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O kind composto dela não é servido, então nada desse kind pode ser criado. Procure uma CRD que conflite com ela ou um schema inválido." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Его composite kind не обслуживается, поэтому ничего этого вида создать нельзя. Поищите конфликтующий CRD или недопустимую схему." } }
      }
    },
    "Virtual machines" : {
