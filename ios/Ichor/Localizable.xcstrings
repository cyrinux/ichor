      }
    },
    "Cordon and drain it, upgrade, wait until it is back and Ready, then uncordon it. Without it, this Talos version stops the node's pods when it reboots." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'isoler et le vider, mettre à jour, attendre qu'il revienne prêt, puis lever l'isolement. Sans cela, cette version de Talos arrête les pods du nœud au redémarrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordonarlo y vaciarlo, actualizar, esperar a que vuelva y esté listo, y quitar el acordonamiento. Sin esto, esta versión de Talos detiene los pods del nodo al reiniciar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absperren und leeren, aktualisieren, warten, bis er wieder bereit ist, dann die Absperrung aufheben. Ohne diese Option stoppt diese Talos-Version die Pods des Nodes beim Neustart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolarlo e svuotarlo, aggiornare, attendere che torni pronto, poi rimuovere l'isolamento. Senza, questa versione di Talos ferma i pod del nodo al riavvio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ізолювати й звільнити його, оновити, дочекатися готовності, потім зняти ізоляцію. Без цього ця версія Talos зупиняє поди вузла під час перезавантаження."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对节点禁止调度并排空，执行升级，等待其恢复并变为 Ready，然后恢复调度。否则，此 Talos 版本会在重启时停止该节点的 Pod。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スケジュール停止してドレインし、アップグレードして、復帰して Ready になるのを待ってからスケジュールを再開します。これを行わない場合、この Talos バージョンでは再起動時にノードの Pod が停止します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Isola e drena o nó, atualiza, espera até ele voltar e ficar Ready e então o libera. Sem isso, esta versão do Talos para os pods do nó quando ele reinicia." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запретить планирование и освободить узел, обновить, дождаться возвращения в состояние Ready, затем разрешить планирование. Без этого данная версия Talos останавливает поды узла при перезагрузке." } }
      }
    },
    "Upgrade Talos, wait until the node runs the new version and is Ready, then uncordon it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour Talos, attendre que le nœud tourne sur la nouvelle version et soit prêt, puis lever l'isolement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar Talos, esperar a que el nodo ejecute la nueva versión y esté listo, y luego quitar el acordonamiento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos aktualisieren, warten, bis der Node die neue Version ausführt und bereit ist, dann die Absperrung aufheben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Talos, attendi che il nodo esegua la nuova versione e sia pronto, poi rimuovi l'isolamento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновити Talos, дочекатися, поки вузол працюватиме на новій версії й буде готовий, потім зняти ізоляцію."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "升级 Talos，等待节点运行新版本并变为 Ready，然后恢复调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Talos をアップグレードし、ノードが新しいバージョンで動作して Ready になるのを待ってから、スケジュールを再開します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Atualiza o Talos, espera até o nó executar a nova versão e ficar Ready e então o libera." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновить Talos, дождаться, пока узел заработает на новой версии и станет Ready, затем разрешить планирование." } }
      }
    },
