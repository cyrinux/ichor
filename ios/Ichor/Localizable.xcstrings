          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos bloques que fallan respaldan objetos vivos: comprueba esos objetos por S3 antes de dar por perdidos los datos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі проблемні блоки належать живим об’єктам: перевірте ці об’єкти через S3, перш ніж констатувати втрату даних."
          }
        },
