        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero supprime les données de cette sauvegarde de son emplacement de stockage, puis la sauvegarde elle-même. Elle ne pourra plus être restaurée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero rimuove i dati di questo backup dalla posizione di archiviazione, poi il backup stesso. Non potrà più essere ripristinato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velero видаляє дані цієї копії зі сховища, а потім саму копію. Відновити її після цього не вийде."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Velero 会先从存储位置删除此备份的数据，再删除备份本身。之后将无法恢复。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Velero はこのバックアップのデータをストレージの場所から削除し、その後バックアップ自体を削除します。削除後は復元できません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Velero remove os dados deste backup do local de armazenamento e depois o próprio backup. Não será possível restaurá-lo depois." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Velero удалит данные этой резервной копии из места хранения, а затем саму копию. Восстановить её после этого будет нельзя." } }
      }
    },
