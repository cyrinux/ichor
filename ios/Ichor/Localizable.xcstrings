        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该镜像没有适用于此节点架构的构建：选择多架构标签，或将 Pod 调度到匹配的节点。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このノードのアーキテクチャ向けのイメージビルドがありません。マルチアーキテクチャのタグを選ぶか、対応するノードに Pod をスケジュールしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A imagem não tem build para a arquitetura deste nó: escolha uma tag multi-arch ou agende o pod em nós compatíveis." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У образа нет сборки для архитектуры этого узла: выберите multi-arch-тег или планируйте под на подходящие узлы." } }
