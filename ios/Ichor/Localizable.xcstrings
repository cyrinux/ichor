        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна звільнити близько %@. Члени обробляються по одному: спершу послідовники, лідер останнім."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "约可回收 %@。成员逐个处理，先处理跟随者，最后处理领导者。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "約 %@ を回収できます。メンバーは1つずつ処理され、フォロワーが先、リーダーが最後です。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cerca de %@ recuperáveis. Os membros são processados um de cada vez, primeiro os seguidores e o líder por último." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Можно освободить около %@. Участники обрабатываются по одному: сначала ведомые, лидер последним." } }
