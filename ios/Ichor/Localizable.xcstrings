    "The old node does not answer, so it cannot be reset from here: power it off yourself if it still runs." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ancien nœud ne répond pas et ne peut donc pas être réinitialisé d'ici : éteignez-le vous-même s'il tourne encore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo antiguo no responde, así que no se puede restablecer desde aquí: apágalo tú mismo si sigue en marcha."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Node antwortet nicht und kann daher nicht von hier zurückgesetzt werden: Schalten Sie ihn selbst aus, falls er noch läuft."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
