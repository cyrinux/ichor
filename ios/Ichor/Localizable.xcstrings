        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneuere das Client-Zertifikat dieses Kontexts oder stelle eine eingeschränkte talosconfig für ein anderes Gerät aus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinnova il certificato client di questo contesto o emetti un talosconfig limitato per un altro dispositivo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновіть клієнтський сертифікат цього контексту або видайте обмежений talosconfig для іншого пристрою."
          }
