    "Reboot immediately: pods and services are NOT stopped. Only for a stuck node." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofortiger Neustart: Pods und Dienste werden NICHT gestoppt. Nur für einen hängenden Node."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia de inmediato: los pods y servicios NO se detienen. Solo para un nodo bloqueado."
