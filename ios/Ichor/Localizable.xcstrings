    "Choose a folder to measure, then tap a folder to open it. Large folders such as /var can take minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner zum Messen und tippe dann auf einen Ordner, um ihn zu öffnen. Große Ordner wie /var können Minuten dauern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta para medirla y toca una carpeta para abrirla. Las carpetas grandes como /var pueden tardar minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier à mesurer, puis touchez un dossier pour l'ouvrir. Les gros dossiers comme /var peuvent prendre plusieurs minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una cartella da misurare, poi tocca una cartella per aprirla. Le cartelle grandi come /var possono richiedere minuti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть папку для вимірювання, потім торкніться папки, щоб відкрити її. Великі папки, як-от /var, можуть вимірюватися кілька хвилин."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择要测量的文件夹，然后轻点文件夹将其打开。/var 等大文件夹可能需要几分钟。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "測定するフォルダーを選び、フォルダーをタップして開きます。/var などの大きなフォルダーは数分かかることがあります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha uma pasta para medir e toque em uma pasta para abri-la. Pastas grandes como /var podem levar minutos." } },
