        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA porta il carico a questo numero e smette di scalarlo finché non riprendi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA масштабує навантаження до цієї кількості й більше не змінює її, доки ви не відновите."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "KEDA 会将工作负载扩缩到此数量，并停止扩缩，直到你恢复。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "KEDA はワークロードをこの数にスケールし、再開するまでスケーリングを停止します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O KEDA escala a carga de trabalho para esta quantidade e para de escalá-la até você retomar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "KEDA масштабирует рабочую нагрузку до этого числа и перестаёт её масштабировать, пока вы не возобновите." } }
      }
    },
