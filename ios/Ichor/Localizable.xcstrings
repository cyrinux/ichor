    "This build gets its updates from the App Store, or from TestFlight for a beta." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version reçoit ses mises à jour de l'App Store, ou de TestFlight pour une bêta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión recibe sus actualizaciones de la App Store, o de TestFlight si es una beta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build erhält seine Updates über den App Store, bei einer Beta über TestFlight."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build riceve gli aggiornamenti dall'App Store, o da TestFlight se è una beta."
