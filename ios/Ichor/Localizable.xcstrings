        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "CPU como fração de um núcleo e E/S de disco desde a última atualização, a cada 10 s; pressão nos últimos 10 s. Toque em um grupo para abri-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "CPU как доля одного ядра и дисковый ввод-вывод с последнего обновления, каждые 10 с; нагрузка (PSI) за последние 10 с. Нажмите на группу, чтобы открыть её." } }
