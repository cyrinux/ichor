        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "至少选择一个要恢复的命名空间" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元する名前空間を少なくとも1つ選択してください" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha pelo menos um namespace para restaurar" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите хотя бы одно пространство имён для восстановления" } }
      }
    },
    "Managed resources that cannot sync, unhealthy packages, definitions not established" : {
