            "value" : "%@ звільнено, він залишається закордонованим"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已排空，并保持禁止调度" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ はドレイン済みで、スケジュール停止のままです" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ foi drenado e continua isolado" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ освобождён, планирование остаётся запрещённым" } }
      }
    },
    "%@ is shutting down and stays cordoned" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
