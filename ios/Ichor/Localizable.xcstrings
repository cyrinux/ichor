    "The node resyncs missing blocks without pausing between them: faster recovery, but more disk and network IO while it catches up." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud resynchronise les blocs manquants sans pause entre eux : récupération plus rapide, mais plus d’E/S disque et réseau le temps de rattraper son retard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo resincroniza los bloques que faltan sin pausas entre ellos: recuperación más rápida, pero más E/S de disco y red mientras se pone al día."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол ресинхронізує відсутні блоки без пауз між ними: швидше відновлення, але більше дискового й мережевого вводу-виводу, поки він наздоганяє."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Knoten synchronisiert fehlende Blöcke ohne Pause dazwischen: schnellere Wiederherstellung, aber mehr Festplatten- und Netzwerk-I/O, bis er aufgeholt hat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo risincronizza i blocchi mancanti senza pause tra uno e l’altro: recupero più rapido, ma più I/O su disco e rete finché non si mette in pari."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点在重新同步缺失的块时不再停顿：恢复更快，但追赶期间磁盘和网络 IO 更多。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードは欠落ブロックを間隔を空けずに再同期します。復旧は速くなりますが、追いつくまでディスクとネットワークの IO が増えます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó ressincroniza os blocos ausentes sem pausas entre eles: recuperação mais rápida, mas mais E/S de disco e rede enquanto ele se atualiza." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел ресинхронизирует недостающие блоки без пауз между ними: восстановление быстрее, но больше дискового и сетевого ввода-вывода, пока узел догоняет." } }
      }
    },
    "The node goes back to Garage's default resync pace, lighter on disk and network IO." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud revient au rythme de resynchro par défaut de Garage, plus léger en E/S disque et réseau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo vuelve al ritmo de resincronización predeterminado de Garage, con menos E/S de disco y red."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол повертається до стандартного темпу ресинхронізації Garage, легшого для дискового й мережевого вводу-виводу."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Knoten kehrt zum Standard-Resync-Tempo von Garage zurück, mit weniger Festplatten- und Netzwerk-I/O."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo torna al ritmo di risincronizzazione predefinito di Garage, più leggero su I/O di disco e rete."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点恢复为 Garage 默认的重新同步节奏，磁盘和网络 IO 负担更轻。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードは Garage のデフォルトの再同期ペースに戻り、ディスクとネットワークの IO 負荷が軽くなります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó volta ao ritmo de ressincronização padrão do Garage, mais leve em E/S de disco e rede." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел возвращается к темпу ресинхронизации Garage по умолчанию, с меньшей нагрузкой на диск и сеть." } }
      }
    },
