        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parando…" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановка…" } }
      }
    },
    "Stops after the drain; the node stays cordoned." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört nach dem Leeren auf; der Knoten bleibt abgesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene tras el drenaje; el nodo sigue acordonado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrête après le drainage ; le nœud reste cordonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma dopo lo svuotamento; il nodo resta isolato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиняється після звільнення; вузол залишається закордонованим."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "排空后停止；节点保持禁止调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ドレイン後に停止します。ノードはスケジュール停止のままです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para após a drenagem; o nó continua isolado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Останавливается после освобождения; планирование на узле остаётся запрещённым." } }
      }
    },
    "The maintenance ended without a result." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wartung endete ohne Ergebnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mantenimiento terminó sin resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maintenance s’est terminée sans résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manutenzione è terminata senza risultato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обслуговування завершилося без результату."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "维护已结束，但没有结果。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メンテナンスは結果なしで終了しました。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A manutenção terminou sem resultado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обслуживание завершилось без результата." } }
      }
    },
    "The node maintenance stops while Ichor is in the background. Open it until the maintenance ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Knotenwartung stoppt, solange Ichor im Hintergrund ist. Öffne die App, bis die Wartung endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mantenimiento del nodo se detiene mientras Ichor está en segundo plano. Ábrelo hasta que termine el mantenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maintenance du nœud s’arrête tant qu’Ichor est en arrière-plan. Ouvrez-le jusqu’à la fin de la maintenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manutenzione del nodo si ferma mentre Ichor è in background. Aprilo finché la manutenzione non finisce."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обслуговування вузла зупиняється, поки Ichor у фоні. Відкрийте його до завершення обслуговування."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Ichor 在后台时节点维护会停止。在维护结束前保持其打开。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor がバックグラウンドにある間、ノードのメンテナンスは停止します。メンテナンスが終わるまで Ichor を開いておいてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A manutenção do nó para enquanto o Ichor está em segundo plano. Mantenha-o aberto até o fim da manutenção." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обслуживание узла останавливается, пока Ichor в фоне. Держите приложение открытым до конца обслуживания." } }
      }
    },
    "The run stops after the current step. %@ stays cordoned: uncordon it from its menu when ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lauf stoppt nach dem aktuellen Schritt. %@ bleibt abgesperrt: Hebe die Sperre in seinem Menü auf, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ejecución se detiene tras el paso actual. %@ sigue acordonado: quita el cordón desde su menú cuando esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exécution s’arrête après l’étape en cours. %@ reste cordonné : levez le cordon depuis son menu une fois prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esecuzione si ferma dopo il passaggio in corso. %@ resta isolato: rimuovi l’isolamento dal suo menu quando sei pronto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виконання зупиниться після поточного кроку. %@ залишиться закордонованим: зніміть кордон з його меню, коли будете готові."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行将在当前步骤后停止。%@ 保持禁止调度：准备就绪后从其菜单中恢复调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行は現在のステップの後に停止します。%@ はスケジュール停止のままなので、準備ができたらメニューからスケジュールを再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A execução para após a etapa atual. %@ continua isolado: libere-o pelo menu dele quando estiver pronto." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выполнение остановится после текущего шага. Для %@ планирование останется запрещённым: когда будете готовы, разрешите его из меню узла." } }
      }
    },
    "These checks concern the reboot or shutdown: a drain alone runs anyway." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Prüfungen betreffen Neustart oder Herunterfahren: Ein reines Leeren läuft trotzdem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas comprobaciones afectan al reinicio o al apagado: un drenaje solo se ejecuta igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces vérifications concernent le redémarrage ou l’arrêt : un simple drainage s’exécute quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi controlli riguardano il riavvio o lo spegnimento: un semplice svuotamento viene eseguito comunque."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці перевірки стосуються перезавантаження чи вимкнення: просте звільнення виконується в будь-якому разі."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些检查针对重启或关机：单独排空仍会执行。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらのチェックは再起動またはシャットダウンに関するものです。ドレインのみの場合はそのまま実行されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Estas verificações se referem à reinicialização ou ao desligamento: uma drenagem isolada é executada mesmo assim." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эти проверки касаются перезагрузки или выключения: одно лишь освобождение выполнится в любом случае." } }
      }
    },
