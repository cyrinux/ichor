        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快照以明文包含所有 Kubernetes Secret。任何拥有该文件的人都能读取它们：请妥善保管，不再需要时将其删除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショットにはすべての Kubernetes Secret が平文で含まれます。ファイルを持つ人は誰でも読み取れます：安全な場所に保管し、不要になったら削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O snapshot contém todos os Secrets do Kubernetes em texto claro. Qualquer pessoa com o arquivo pode lê-los: guarde-o em um lugar seguro e exclua-o quando não for mais necessário." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Снимок содержит все Secret Kubernetes в открытом виде. Любой, у кого есть файл, может их прочитать: храните его в надёжном месте и удалите, когда он больше не нужен." } }
