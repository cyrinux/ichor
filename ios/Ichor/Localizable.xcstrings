        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードが再起動するまで Ichor を開いたままにしてください" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mantenha o Ichor aberto até o nó reiniciar" } },
