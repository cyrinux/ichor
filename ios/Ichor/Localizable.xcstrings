    "%@ installs %@ and reboots: its pods are drained and it is unavailable for several minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ installiert %@ und startet neu: seine Pods werden verdrängt und er ist einige Minuten nicht erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ instala %@ y se reinicia: sus pods se drenan y no está disponible durante varios minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
