    "Images share layers, so the total can exceed the disk space they use." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images teilen sich Layer, daher kann die Summe den belegten Speicherplatz übersteigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes comparten capas, así que el total puede superar el espacio en disco que usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images partagent des couches : le total peut dépasser l'espace disque réellement utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini condividono i livelli, quindi il totale può superare lo spazio su disco usato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Образи мають спільні шари, тож сума може перевищувати фактично зайняте місце."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "镜像之间共享层，因此总大小可能超过其实际占用的磁盘空间。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "イメージはレイヤーを共有するため、合計が実際のディスク使用量を超えることがあります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As imagens compartilham camadas, então o total pode exceder o espaço em disco que usam." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Образы используют общие слои, поэтому сумма может превышать фактически занятое место на диске." } }
      }
    },
