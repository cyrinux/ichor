    "Measures TCP throughput and latency from one node to another with netperf, like cilium connectivity perf. The test runs in a temporary namespace, deleted afterwards." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure le débit et la latence TCP d’un nœud à un autre avec netperf, comme cilium connectivity perf. Le test s’exécute dans un namespace temporaire, supprimé ensuite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide el rendimiento y la latencia TCP de un nodo a otro con netperf, como cilium connectivity perf. La prueba se ejecuta en un namespace temporal que se elimina después."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимірює пропускну здатність і затримку TCP між двома вузлами за допомогою netperf, як cilium connectivity perf. Тест виконується в тимчасовому namespace, який потім видаляється."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst TCP-Durchsatz und -Latenz von einem Node zu einem anderen mit netperf, wie cilium connectivity perf. Der Test läuft in einem temporären Namespace, der danach gelöscht wird."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura throughput e latenza TCP da un nodo a un altro con netperf, come cilium connectivity perf. Il test gira in un namespace temporaneo, eliminato al termine."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 netperf 测量节点之间的 TCP 吞吐量和延迟，类似 cilium connectivity perf。测试在临时命名空间中运行，结束后删除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "cilium connectivity perf と同様に、netperf を使ってノード間の TCP スループットとレイテンシを測定します。テストは一時的な名前空間で実行され、終了後に削除されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mede a vazão e a latência TCP de um nó para outro com o netperf, como o cilium connectivity perf. O teste é executado em um namespace temporário, excluído depois." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Измеряет пропускную способность и задержку TCP между двумя узлами с помощью netperf, как cilium connectivity perf. Тест выполняется во временном пространстве имён, которое затем удаляется." } }
      }
    },
