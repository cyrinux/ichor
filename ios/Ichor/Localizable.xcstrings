    "Its pods in %@ are replaced with a rolling update, like kubectl rollout restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pods in %@ werden schrittweise ersetzt, wie bei kubectl rollout restart."
