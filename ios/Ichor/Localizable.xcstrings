        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviction en cours"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espulsione in corso"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виселення"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驱逐中" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "退避中" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Removendo" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вытесняется" } }
      }
    },
    "Evictions honour PodDisruptionBudgets: a budget that allows no disruption makes the drain wait, it never forces." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdrängungen respektieren PodDisruptionBudgets: Ein Budget, das keine Unterbrechung erlaubt, lässt das Leeren warten, es wird nie erzwungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los desalojos respetan los PodDisruptionBudgets: un presupuesto que no permite interrupciones hace esperar al drenaje, que nunca fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les évictions respectent les PodDisruptionBudgets : un budget qui n’autorise aucune interruption fait attendre le drainage, qui ne force jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le espulsioni rispettano i PodDisruptionBudget: un budget che non consente interruzioni fa attendere lo svuotamento, che non forza mai."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виселення поважає PodDisruptionBudgets: бюджет, що не дозволяє переривань, змушує звільнення чекати, примусу немає."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "驱逐遵循 PodDisruptionBudget：不允许中断的预算会让排空等待，绝不强制执行。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "退避は PodDisruptionBudget に従います。中断を許可しないバジェットがあるとドレインは待機し、強制されることはありません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As remoções respeitam os PodDisruptionBudgets: um budget que não permite nenhuma interrupção faz a drenagem esperar, nunca forçar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вытеснение учитывает PodDisruptionBudgets: если бюджет не допускает прерываний, освобождение ждёт и никогда не действует принудительно." } }
      }
    },
    "Ichor drives every step: in the background iOS pauses it, and the maintenance stalls." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor steuert jeden Schritt: Im Hintergrund pausiert iOS die App und die Wartung stockt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor dirige cada paso: en segundo plano iOS lo pausa y el mantenimiento se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor pilote chaque étape : en arrière-plan iOS le met en pause, et la maintenance se bloque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor guida ogni passaggio: in background iOS lo mette in pausa e la manutenzione si blocca."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor керує кожним кроком: у фоні iOS призупиняє його, і обслуговування зупиняється."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每一步都由 Ichor 驱动：在后台时 iOS 会暂停它，维护也会停滞。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "各ステップは Ichor が実行します。バックグラウンドでは iOS がアプリを一時停止するため、メンテナンスが止まります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Ichor conduz cada etapa: em segundo plano, o iOS o pausa e a manutenção trava." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каждым шагом управляет Ichor: в фоне iOS приостанавливает приложение, и обслуживание останавливается." } }
      }
    },
    "Keep Ichor open until the maintenance ends" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Ichor offen, bis die Wartung endet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Ichor abierto hasta que termine el mantenimiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Ichor ouvert jusqu’à la fin de la maintenance"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Ichor aperto finché la manutenzione non finisce"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте Ichor відкритим до завершення обслуговування"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在维护结束前保持 Ichor 打开" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メンテナンスが終わるまで Ichor を開いたままにしてください" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mantenha o Ichor aberto até o fim da manutenção" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не закрывайте Ichor до конца обслуживания" } }
      }
    },
    "Keep Ichor open until the maintenance ends: in the background iOS pauses the app, and the maintenance with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Ichor offen, bis die Wartung endet: Im Hintergrund pausiert iOS die App und damit die Wartung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Ichor abierto hasta que termine el mantenimiento: en segundo plano iOS pausa la app y el mantenimiento con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Ichor ouvert jusqu’à la fin de la maintenance : en arrière-plan iOS met l’app en pause, et la maintenance avec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Ichor aperto finché la manutenzione non finisce: in background iOS mette in pausa l’app, e la manutenzione con essa."
