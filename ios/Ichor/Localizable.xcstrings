    "netperf pods run on %@ and %@ in a temporary namespace. The link between them is saturated for about %lld seconds, then the namespace is deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des pods netperf tournent sur %@ et %@ dans un namespace temporaire. Le lien entre eux est saturé pendant environ %lld secondes, puis le namespace est supprimé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecutan pods de netperf en %@ y %@ en un namespace temporal. El enlace entre ellos se satura durante unos %lld segundos y luego se elimina el namespace."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поди netperf працюють на %@ і %@ у тимчасовому namespace. З’єднання між ними буде завантажене приблизно %lld секунд, потім namespace видаляється."
          }
        },
        "de" : {
          "stringUnit" : {
