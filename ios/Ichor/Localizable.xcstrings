    "Each node checks its change without applying it; then the upgrade is offered." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nœud vérifie sa modification sans l'appliquer ; la mise à jour est proposée ensuite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada nodo comprueba su cambio sin aplicarlo; después se ofrece la actualización."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Node prüft seine Änderung, ohne sie anzuwenden; danach wird das Update angeboten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni nodo verifica la modifica senza applicarla; poi viene proposto l'aggiornamento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен вузол перевіряє зміну, не застосовуючи її; потім пропонується оновлення."
          }
        },
