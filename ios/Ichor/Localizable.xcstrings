    "Ask your Google Cloud admin for a Desktop app OAuth client (APIs & Services → Credentials) with an Internal consent screen. Sign in then opens your Google account in the browser." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à l'administrateur Google Cloud un client OAuth de type Application de bureau (API et services → Identifiants) avec un écran de consentement Interne. Se connecter ouvre ensuite votre compte Google dans le navigateur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al administrador de Google Cloud un cliente OAuth de tipo Aplicación de escritorio (APIs y servicios → Credenciales) con una pantalla de consentimiento Interna. Iniciar sesión abre después tu cuenta de Google en el navegador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte deine Google-Cloud-Administration um einen OAuth-Client vom Typ Desktop-App (APIs & Dienste → Anmeldedaten) mit internem Zustimmungsbildschirm. Anmelden öffnet dann dein Google-Konto im Browser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi all'amministratore Google Cloud un client OAuth di tipo App desktop (API e servizi → Credenziali) con una schermata di consenso Interna. Accedi apre poi il tuo account Google nel browser."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть адміністратора Google Cloud створити OAuth-клієнт типу «Програма для комп’ютера» (API та сервіси → Облікові дані) з внутрішнім екраном згоди. Вхід відкриє ваш обліковий запис Google у браузері."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "向你的 Google Cloud 管理员索取一个桌面应用类型的 OAuth 客户端（API 和服务 → 凭据），并使用“内部”同意屏幕。之后登录会在浏览器中打开你的 Google 账号。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Google Cloud 管理者に、内部の同意画面を持つデスクトップアプリ用 OAuth クライアント（API とサービス → 認証情報）を依頼してください。サインインすると、ブラウザで Google アカウントが開きます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Peça ao administrador do Google Cloud um cliente OAuth do tipo App para computador (APIs e serviços → Credenciais) com uma tela de consentimento Interna. Entrar então abre sua conta Google no navegador." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Попросите администратора Google Cloud создать OAuth-клиент типа Desktop app (APIs & Services → Credentials) с экраном согласия Internal. Затем при входе в браузере откроется ваш аккаунт Google." } }
      }
    },
