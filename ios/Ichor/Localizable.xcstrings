            "value" : "Перезавантаження, вимкнення, оновлення та експорт конфігурації спершу її запитують."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重启、关机、升级和导出配置前都会先要求验证。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再起動、シャットダウン、アップグレード、構成のエクスポートの前に確認を求めます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reiniciar, desligar, atualizações e exportações de configuração pedem isso antes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перезагрузка, выключение, обновления и экспорт конфигураций сначала требуют подтверждения." } }
