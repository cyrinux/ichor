        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これを使用する Connector とプロキシグループは新しいプロキシを起動できません。kubectl describe proxyclass <name> で無効なフィールドがわかります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os Connectors e proxy groups que a usam não conseguem iniciar novos proxies: kubectl describe proxyclass <name> indica o campo inválido." } },
