        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збирання триває кілька хвилин на вузол. Не закривайте застосунок: екран тим часом залишається ввімкненим."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每个节点的收集需要几分钟。请保持应用打开：在此期间屏幕保持常亮。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "収集にはノードごとに数分かかります。アプリを開いたままにしてください：その間、画面はオンのままです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A coleta leva alguns minutos por nó. Mantenha o app aberto: enquanto isso, a tela fica ligada." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сбор занимает несколько минут на узел. Не закрывайте приложение: пока идёт сбор, экран не гаснет." } }
      }
    },
