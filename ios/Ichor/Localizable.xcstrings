          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігати останній відомий стан"
          }
        }
      }
    },
    "Save the last data fetched from each cluster on this phone, encrypted, so it still shows when the cluster can't be reached. Kept for 24 hours and never backed up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert die zuletzt von jedem Cluster abgerufenen Daten verschlüsselt auf diesem Telefon, damit sie auch angezeigt werden, wenn der Cluster nicht erreichbar ist. 24 Stunden lang aufbewahrt und nie gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda en este teléfono, cifrados, los últimos datos obtenidos de cada clúster, para que se sigan mostrando cuando no se pueda acceder al clúster. Se conservan 24 horas y nunca se incluyen en copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre sur ce téléphone, chiffrées, les dernières données récupérées de chaque cluster, pour qu'elles restent affichées quand le cluster est injoignable. Conservées 24 heures et jamais sauvegardées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva su questo telefono, cifrati, gli ultimi dati recuperati da ogni cluster, così restano visibili quando il cluster non è raggiungibile. Conservati per 24 ore e mai inclusi nei backup."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає на цьому телефоні в зашифрованому вигляді останні дані, отримані з кожного кластера, щоб їх було видно, коли кластер недоступний. Зберігаються 24 години й ніколи не потрапляють до резервних копій."
          }
        }
      }
    },
