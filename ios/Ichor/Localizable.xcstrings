        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止したノードをスキップしました。レイアウトの移行はそれらなしで続行します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nós mortos pulados: a migração do layout continua sem eles." } },
