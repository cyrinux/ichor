        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请明确选择副本。不会自动选择任何副本。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レプリカを明示的に選択してください。自動では選択されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha as réplicas explicitamente. Nenhuma réplica é selecionada automaticamente." } },
