    "Other names Argo CD or Flux use for this server, such as an SSH or in-cluster address. Separate them with commas. The token is still only sent to the host above." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Namen, die Argo CD oder Flux für diesen Server nutzen, etwa eine SSH- oder clusterinterne Adresse. Trennen Sie sie mit Kommas. Das Token wird weiterhin nur an den Host oben gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros nombres que Argo CD o Flux usan para este servidor, como una dirección SSH o interna del clúster. Sepáralos con comas. El token solo se envía al host de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autres noms qu'Argo CD ou Flux utilisent pour ce serveur, comme une adresse SSH ou interne au cluster. Séparez-les par des virgules. Le jeton n'est envoyé qu'à l'hôte ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri nomi che Argo CD o Flux usano per questo server, come un indirizzo SSH o interno al cluster. Separali con virgole. Il token viene inviato solo all'host qui sopra."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інші імена, якими Argo CD чи Flux звертаються до цього сервера, як-от SSH- або внутрішньокластерна адреса. Розділяйте комами. Токен і далі надсилається лише на хост вище."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Argo CD 或 Flux 对此服务器使用的其他名称，例如 SSH 地址或集群内地址。用逗号分隔。令牌仍只会发送到上面的主机。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Argo CD や Flux がこのサーバーに使用する別の名前（SSH アドレスやクラスター内アドレスなど）。カンマで区切ってください。トークンは上記のホストにのみ送信されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Outros nomes que o Argo CD ou o Flux usam para este servidor, como um endereço SSH ou interno ao cluster. Separe-os com vírgulas. O token continua sendo enviado apenas ao host acima." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Другие имена этого сервера, которые используют Argo CD или Flux, например SSH-адрес или адрес внутри кластера. Разделяйте их запятыми. Токен по-прежнему отправляется только на указанный выше хост." } }
      }
