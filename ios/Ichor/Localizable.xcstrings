            "state" : "translated",
            "value" : "%@ se sincroniza con %@ con sus propias opciones de sincronización. No se elimina nada."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ синхронізується до %@ з власними параметрами синхронізації. Нічого не видаляється."
          }
        },
        "de" : {
