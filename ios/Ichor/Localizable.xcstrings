        "pt-BR" : { "variations" : { "plural" : { "one" : { "stringUnit" : { "state" : "translated", "value" : "O Argo CD não vai sincronizar automaticamente nem autorrecuperar %lld app (%@) até %@. As alterações manuais permanecem até lá." } }, "other" : { "stringUnit" : { "state" : "translated", "value" : "O Argo CD não vai sincronizar automaticamente nem autorrecuperar %lld apps (%@) até %@. As alterações manuais permanecem até lá." } } } } },
