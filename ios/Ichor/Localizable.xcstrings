    "Ichor did not create this window: it likely comes from Git. Argo CD may put it back on the next sync of %@, so remove it in Git too." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor hat dieses Fenster nicht erstellt: Es stammt wahrscheinlich aus Git. Argo CD kann es beim nächsten Sync von %@ zurückbringen, entferne es also auch in Git."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor did not create this window: it likely comes from Git. Argo CD may put it back on the next sync of %@, so remove it in Git too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor no creó esta ventana: probablemente viene de Git. Argo CD podría volver a ponerla en la próxima sincronización de %@, así que elimínala también en Git."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor n'a pas créé cette fenêtre : elle vient sans doute de Git. Argo CD pourrait la remettre à la prochaine sync de %@, supprimez-la aussi dans Git."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor non ha creato questa finestra: probabilmente viene da Git. Argo CD potrebbe ripristinarla alla prossima sync di %@, quindi rimuovila anche in Git."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ichor не створював це вікно: імовірно, воно з Git. Argo CD може повернути його під час наступної синхронізації %@, тож видаліть його і в Git."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此窗口不是由 Ichor 创建的：它可能来自 Git。Argo CD 可能在下次同步 %@ 时将其还原，因此也要在 Git 中移除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このウィンドウは Ichor が作成したものではなく、おそらく Git 由来です。%@ の次回同期で Argo CD が元に戻す可能性があるため、Git でも削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Ichor não criou esta janela: provavelmente ela vem do Git. O Argo CD pode restaurá-la na próxima sincronização de %@, então remova-a também no Git." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это окно создано не в Ichor: вероятно, оно из Git. Argo CD может вернуть его при следующей синхронизации %@, поэтому удалите его и в Git." } }
      }
