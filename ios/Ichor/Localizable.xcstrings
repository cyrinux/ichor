    "KEDA scales the workload to this count and stops scaling it until you resume." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA skaliert die Arbeitslast auf diese Anzahl und skaliert sie nicht mehr, bis Sie fortsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA escala la carga a este número y deja de escalarla hasta que la reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA ramène la charge à ce nombre et arrête de la mettre à l’échelle jusqu’à la reprise."
