    "Your talosconfig or kubeconfig holds credentials with direct access to your clusters. Ichor keeps them behind the app lock." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine talosconfig oder kubeconfig enthält Zugangsdaten mit direktem Zugriff auf deine Cluster. Ichor schützt sie mit der App-Sperre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your talosconfig or kubeconfig holds credentials with direct access to your clusters. Ichor keeps them behind the app lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu talosconfig o kubeconfig contiene credenciales con acceso directo a tus clústeres. Ichor las protege con el bloqueo de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre talosconfig ou kubeconfig contient des identifiants qui donnent un accès direct à vos clusters. Ichor les garde derrière le verrouillage de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo talosconfig o kubeconfig contiene credenziali con accesso diretto ai tuoi cluster. Ichor le protegge con il blocco dell'app."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш talosconfig або kubeconfig містить облікові дані з прямим доступом до кластерів. Ichor тримає їх під блокуванням застосунку."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的 talosconfig 或 kubeconfig 包含可直接访问集群的凭据。Ichor 会用应用锁保护它们。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "talosconfig や kubeconfig には、クラスターに直接アクセスできる認証情報が含まれています。Ichor はそれらをアプリのロックで保護します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seu talosconfig ou kubeconfig contém credenciais com acesso direto aos seus clusters. O Ichor as mantém atrás do bloqueio do app." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваш talosconfig или kubeconfig содержит учётные данные с прямым доступом к кластерам. Ichor хранит их под блокировкой приложения." } }
      }
    },
