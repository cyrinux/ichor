    "Delete %@?" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ ?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@?"
          }
        },
        "de" : {
          "stringUnit" : {
