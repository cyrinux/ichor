    "Same node: this measures the node’s own network stack, not a link." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même nœud : cela mesure la pile réseau du nœud, pas un lien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismo nodo: esto mide la pila de red del propio nodo, no un enlace."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той самий вузол: вимірюється власний мережевий стек вузла, а не з’єднання."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Node: Das misst den Netzwerkstack des Nodes, keine Verbindung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesso nodo: misura lo stack di rete del nodo, non un collegamento."
          }
        }
      }
    },
    "Also test the host network" : {
