    "As set, the silence mutes only this alert. Remove a matcher to mute more alerts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So schaltet die Stummschaltung nur diesen Alert stumm. Entferne einen Matcher, um mehr Alerts stummzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así, el silencio solo calla esta alerta. Quita un matcher para callar más alertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel quel, le silence ne fait taire que cette alerte. Retire un matcher pour en faire taire davantage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così il silenzio zittisce solo questo avviso. Rimuovi un matcher per zittirne di più."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так приглушення стосується лише цього сповіщення. Прибери matcher, щоб приглушити більше."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按当前设置，该静默仅屏蔽此告警。移除匹配器可屏蔽更多告警。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の設定では、このサイレンスはこのアラートのみをミュートします。より多くのアラートをミュートするにはマッチャーを削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Da forma como está, o silenciamento silencia apenas este alerta. Remova um matcher para silenciar mais alertas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В текущем виде тишина заглушает только это оповещение. Удалите matcher, чтобы заглушить больше оповещений." } }
