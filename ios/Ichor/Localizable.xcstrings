        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarre immédiatement : les pods et les services ne sont PAS arrêtés. Seulement pour un nœud bloqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavvio immediato: pod e servizi NON vengono arrestati. Solo per un nodo bloccato."
