    "Keep last known state" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzten bekannten Zustand behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar el último estado conocido"
          }
        },
        "fr" : {
          "stringUnit" : {
