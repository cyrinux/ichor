        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 正在关机，并保持禁止调度" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ はシャットダウン中で、スケジュール停止のままです" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ está desligando e continua isolado" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ выключается, планирование остаётся запрещённым" } }
      }
    },
    "%@ is uncordoned: pods can be scheduled on it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist freigegeben: Pods können wieder darauf eingeplant werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitó el cordón de %@: se pueden volver a programar pods en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cordon de %@ est levé : des pods peuvent de nouveau y être planifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’isolamento di %@ è rimosso: i pod possono di nuovo essere pianificati su di esso."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З %@ знято кордон: на ньому знову можна планувати поди."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已恢复调度：Pod 可以再次调度到其上。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のスケジュールを再開しました。再び Pod をスケジュールできます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ foi liberado: pods podem ser agendados nele novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для %@ разрешено планирование: на него снова можно назначать поды." } }
      }
    },
    "A cordoned node gets no new pods; the pods it runs stay. Uncordon it to schedule pods on it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein abgesperrter Knoten bekommt keine neuen Pods; die laufenden bleiben. Hebe die Sperre auf, um wieder Pods darauf einzuplanen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nodo acordonado no recibe pods nuevos; los que ejecuta se quedan. Quita el cordón para volver a programar pods en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nœud cordonné ne reçoit plus de nouveaux pods ; ceux qu’il exécute restent. Levez le cordon pour y planifier de nouveau des pods."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nodo isolato non riceve nuovi pod; quelli in esecuzione restano. Rimuovi l’isolamento per pianificarvi di nuovo dei pod."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закордонований вузол не отримує нових подів; ті, що на ньому працюють, залишаються. Зніміть кордон, щоб знову планувати на ньому поди."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "禁止调度的节点不会接收新 Pod；其上已运行的 Pod 保留。恢复调度后才能再次向其调度 Pod。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スケジュール停止中のノードには新しい Pod が配置されませんが、実行中の Pod はそのまま残ります。再び Pod をスケジュールするには、スケジュールを再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um nó isolado (cordon) não recebe pods novos; os pods que ele executa permanecem. Libere-o para agendar pods nele novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел с запретом планирования не получает новых подов; уже работающие поды остаются. Разрешите планирование, чтобы снова назначать на него поды." } }
      }
