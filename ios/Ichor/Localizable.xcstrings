    "The node applies it now and reverts by itself after %lld min unless you keep it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud l’applique maintenant et revient de lui-même en arrière après %lld min si vous ne la conservez pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo lo aplica ahora y lo revierte solo tras %lld min si no lo conservas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол застосує її зараз і сам скасує через %lld хв, якщо ви її не збережете."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node wendet sie jetzt an und setzt sie nach %lld Min. selbst zurück, wenn du sie nicht behältst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo la applica ora e la annulla da solo dopo %lld min se non la mantieni."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点会立即应用，若你未选择保留，%lld 分钟后会自动还原。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードは今すぐ変更を適用し、維持しない限り%lld分後に自動で元に戻します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó a aplica agora e reverte sozinho após %lld min, a menos que você a mantenha." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел применит его сейчас и сам откатит через %lld мин, если вы его не сохраните." } }
