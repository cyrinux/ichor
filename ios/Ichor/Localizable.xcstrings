    "%@ rolled back: its pods update when deleted (OnDelete)." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ ramené en arrière : ses pods se mettent à jour quand on les supprime (OnDelete)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ revertido: sus pods se actualizan al eliminarlos (OnDelete)." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "%@ відкочено: його поди оновлюються після видалення (OnDelete)." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ zurückgerollt: Seine Pods werden beim Löschen aktualisiert (OnDelete)." } },
