    "The helm-controller found objects that no longer match the release. A forced upgrade applies the release again now and puts them back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der helm-controller hat Objekte gefunden, die nicht mehr zum Release passen. Ein erzwungenes Upgrade wendet das Release jetzt erneut an und stellt sie wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El helm-controller encontró objetos que ya no coinciden con la release. Una actualización forzada vuelve a aplicar la release ahora y los restaura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le helm-controller a trouvé des objets qui ne correspondent plus à la release. Une mise à niveau forcée réapplique la release maintenant et les remet en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'helm-controller ha trovato oggetti che non corrispondono più alla release. Un aggiornamento forzato riapplica ora la release e li ripristina."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "helm-controller знайшов об'єкти, які більше не відповідають релізу. Примусове оновлення знову застосовує реліз зараз і повертає їх."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "helm-controller 发现有对象与 release 不再一致。强制升级会立即重新应用 release 并将其恢复。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "helm-controller がリリースと一致しなくなったオブジェクトを検出しました。強制アップグレードを行うと、今すぐリリースを再適用して元に戻します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O helm-controller encontrou objetos que não correspondem mais à release. Uma atualização forçada aplica a release novamente agora e os restaura." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "helm-controller обнаружил объекты, которые больше не соответствуют релизу. Принудительное обновление сразу повторно применит релиз и вернёт их на место." } }
