    "Cordon the node and evict its pods before its upgrade, so they move before it reboots." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isoler le nœud et évincer ses pods avant sa mise à jour, pour qu'ils partent avant le redémarrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordonar el nodo y desalojar sus pods antes de su actualización, para que se muevan antes del reinicio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Node absperren und seine Pods vor dem Update verdrängen, damit sie vor dem Neustart umziehen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isola il nodo e sfratta i suoi pod prima dell'aggiornamento, così si spostano prima del riavvio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ізолювати вузол і виселити його поди перед оновленням, щоб вони переїхали до перезавантаження."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "升级前对节点禁止调度并驱逐其 Pod，使它们在节点重启前迁移。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップグレード前にノードをスケジュール停止して Pod を退避させ、再起動前に移動させます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Isolar o nó e remover seus pods antes da atualização, para que eles saiam antes de ele reiniciar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запретить планирование на узле и вытеснить его поды перед обновлением, чтобы они переехали до перезагрузки." } }
      }
    },
