          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo no confía en el certificado del registro: añade su CA a la configuración de máquina o corrige el certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud ne fait pas confiance au certificat du registre : ajoutez son CA à la configuration machine, ou corrigez le certificat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo non si fida del certificato del registro: aggiungi la sua CA alla configurazione macchina o correggi il certificato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол не довіряє сертифікату реєстру: додайте його CA до конфігурації машини або виправте сертифікат."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点不信任镜像仓库的证书：将其 CA 添加到机器配置中，或修复证书。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードがレジストリの証明書を信頼していません。その CA をマシン構成に追加するか、証明書を修正してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O nó não confia no certificado do registry: adicione a CA dele à configuração da máquina ou corrija o certificado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел не доверяет сертификату реестра: добавьте его CA в конфигурацию машины или исправьте сертификат." } }
      }
    },
    "The node cannot reach the registry: check its DNS and egress, or use a mirror it can reach." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Knoten erreicht die Registry nicht: DNS und Ausgang prüfen oder einen erreichbaren Mirror nutzen."
