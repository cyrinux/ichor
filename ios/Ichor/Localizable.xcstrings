          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiare i segreti del cluster?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラスターのシークレットをコピーしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
