          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "netperf Pod 将在临时命名空间中运行于 %@ 和 %@ 上。两者之间的链路将饱和约 %lld 秒，之后删除该命名空间。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "一時的な名前空間で、netperf の Pod が %@ と %@ で実行されます。両者間のリンクは約%lld秒間飽和し、その後名前空間は削除されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pods do netperf são executados em %@ e %@ em um namespace temporário. O link entre eles fica saturado por cerca de %lld segundos e depois o namespace é excluído." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Поды netperf запускаются на %@ и %@ во временном пространстве имён. Канал между ними будет полностью загружен примерно %lld с, затем пространство имён удаляется." } }
      }
    },
