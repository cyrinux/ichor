    "VPN only: without a VPN connected the app does not try the cluster, and background checks wait for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN uniquement : sans VPN connecté, l'app n'essaie pas de joindre le cluster et les vérifications en arrière-plan l'attendent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo VPN: sin una VPN conectada la app no intenta alcanzar el clúster y las comprobaciones en segundo plano la esperan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише VPN: без підключеного VPN застосунок не звертається до кластера, а фонові перевірки чекають на нього."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur VPN: ohne verbundenes VPN versucht die App den Cluster nicht zu erreichen, und Hintergrundprüfungen warten darauf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo VPN: senza una VPN connessa l'app non prova a raggiungere il cluster e i controlli in background la attendono."
          }
        }
      }
    },
    "This cluster is set to be reached over a VPN only, and no VPN is connected. Connect it: this screen reloads by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce cluster est configuré pour n'être joint que via un VPN, et aucun VPN n'est connecté. Connectez-le : cet écran se recharge tout seul."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este clúster está configurado para alcanzarse solo por VPN y no hay ninguna VPN conectada. Conéctala: esta pantalla se recarga sola."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей кластер налаштовано лише для доступу через VPN, а VPN не підключено. Підключіть його: цей екран оновиться сам."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Cluster ist nur über ein VPN erreichbar eingestellt, und kein VPN ist verbunden. Verbinde es: dieser Bildschirm lädt dann von selbst neu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cluster è impostato per essere raggiunto solo tramite VPN e nessuna VPN è connessa. Connettila: questa schermata si ricarica da sola."
          }
        }
      }
    },
