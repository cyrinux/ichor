    "Upgrades are done with Helm or your GitOps tool. From the history, the release can be rolled back to an older revision." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrades erfolgen mit Helm oder Ihrem GitOps-Werkzeug. Im Verlauf lässt sich das Release auf eine ältere Revision zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones se hacen con Helm o su herramienta GitOps. Desde el historial, la release puede volver a una revisión anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour se font avec Helm ou votre outil GitOps. Depuis l'historique, la release peut revenir à une révision antérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti si fanno con Helm o con lo strumento GitOps. Dalla cronologia, la release può tornare a una revisione precedente."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення робляться через Helm або ваш GitOps-інструмент. З історії реліз можна відкотити до старішої ревізії."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "升级通过 Helm 或你的 GitOps 工具完成。可以从历史记录将 release 回滚到较早的修订版本。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップグレードは Helm または GitOps ツールで行います。履歴から、リリースを古いリビジョンにロールバックできます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As atualizações são feitas com o Helm ou sua ferramenta de GitOps. A partir do histórico, a release pode ser revertida para uma revisão anterior." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновления выполняются через Helm или ваш инструмент GitOps. Из истории релиз можно откатить к более старой ревизии." } }
      }
    },
