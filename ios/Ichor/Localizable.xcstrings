      }
    },
    "Requests wait in queues, or a share of the answers are server errors." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des requêtes attendent en file, ou une part des réponses sont des erreurs serveur."
