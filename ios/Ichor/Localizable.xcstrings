    "Talos reads it at the next boot. A wrong value can keep the node from booting." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos la lit au prochain démarrage. Une valeur fausse peut empêcher le nœud de démarrer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos la lee en el próximo arranque. Un valor incorrecto puede impedir que el nodo arranque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos liest ihn beim nächsten Boot. Ein falscher Wert kann den Boot des Nodes verhindern."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos la legge al prossimo avvio. Un valore sbagliato può impedire l'avvio del nodo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos прочитає його під час наступного завантаження. Неправильне значення може завадити вузлу завантажитися."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Talos 会在下次启动时读取它。错误的值可能导致节点无法启动。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Talos は次回の起動時にこの値を読み取ります。値が誤っているとノードが起動できなくなる可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Talos o lê no próximo boot. Um valor errado pode impedir o boot do nó." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Talos прочитает его при следующей загрузке. Неверное значение может помешать узлу загрузиться." } }
      }
    },
    "Talos no longer finds this value at the next boot." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talos ne trouve plus cette valeur au prochain démarrage."
          }
