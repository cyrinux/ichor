    "Flux applies %@ now from the revision its source already fetched, instead of waiting for its interval." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux wendet %@ jetzt mit der Revision an, die seine Quelle bereits geholt hat, statt auf sein Intervall zu warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux aplica %@ ahora a partir de la revisión que su origen ya obtuvo, en lugar de esperar a su intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux applique %@ maintenant à partir de la révision déjà récupérée par sa source, au lieu d'attendre son intervalle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux applica %@ ora dalla revisione già scaricata dalla sua origine, invece di attendere il suo intervallo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux застосовує %@ зараз із ревізії, яку джерело вже отримало, замість чекати на свій інтервал."
          }
        }
      }
    },
    "Flux fetches the source first (a new commit or chart), then applies %@ from it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux holt zuerst die Quelle (einen neuen Commit oder Chart) und wendet dann %@ daraus an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux obtiene primero el origen (un nuevo commit o chart) y luego aplica %@ a partir de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux récupère d'abord la source (un nouveau commit ou chart), puis applique %@ à partir de celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux scarica prima l'origine (un nuovo commit o chart), poi applica %@ da essa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux спершу отримує джерело (новий коміт або чарт), а потім застосовує з нього %@."
          }
        }
      }
    },
    "Flux stops reconciling %@: changes in Git are not applied and drift is not corrected until you resume it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux gleicht %@ nicht mehr ab: Änderungen in Git werden nicht angewendet und Abweichungen nicht korrigiert, bis du es fortsetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux deja de reconciliar %@: los cambios en Git no se aplican y las desviaciones no se corrigen hasta que lo reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux arrête de réconcilier %@ : les changements dans Git ne sont pas appliqués et les dérives ne sont pas corrigées jusqu'à sa reprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux smette di riconciliare %@: le modifiche in Git non vengono applicate e le derive non vengono corrette finché non lo riprendi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux припиняє узгоджувати %@: зміни в Git не застосовуються, а відхилення не виправляються, доки ви його не відновите."
          }
        }
      }
    },
    "Flux reconciles %@ again at once, then at every interval." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux gleicht %@ sofort wieder ab, danach in jedem Intervall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux vuelve a reconciliar %@ de inmediato y luego en cada intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux réconcilie de nouveau %@ immédiatement, puis à chaque intervalle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux riconcilia di nuovo %@ subito, poi a ogni intervallo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux одразу знову узгоджує %@, а далі — з кожним інтервалом."
          }
        }
      }
    },
    "The helm-controller runs a Helm upgrade of %@ now, even with nothing changed: its pods may restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der helm-controller führt jetzt ein Helm-Upgrade von %@ aus, auch ohne Änderungen: Seine Pods können neu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El helm-controller ejecuta ahora una actualización de Helm de %@, aunque nada haya cambiado: sus pods pueden reiniciarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le helm-controller lance maintenant une mise à jour Helm de %@, même sans changement : ses pods peuvent redémarrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'helm-controller esegue ora un aggiornamento Helm di %@, anche senza modifiche: i suoi pod potrebbero riavviarsi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "helm-controller зараз виконує оновлення Helm для %@, навіть якщо нічого не змінилося: його поди можуть перезапуститися."
          }
        }
      }
    },
    "Flux forgets the failed attempts of %@ and retries the install or upgrade from scratch, with its retries counted again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux vergisst die fehlgeschlagenen Versuche von %@ und wiederholt Installation oder Upgrade von vorn, mit neu gezählten Wiederholungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux olvida los intentos fallidos de %@ y reintenta la instalación o la actualización desde cero, volviendo a contar sus reintentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux oublie les tentatives échouées de %@ et relance l'installation ou la mise à jour depuis le début, avec ses nouvelles tentatives recomptées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux dimentica i tentativi falliti di %@ e riprova l'installazione o l'aggiornamento da zero, ricontando i tentativi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux забуває невдалі спроби %@ і повторює встановлення або оновлення з нуля, знову рахуючи повторні спроби."
          }
        }
      }
    },
