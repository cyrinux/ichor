    "Graceful stop, then a full firmware reboot instead of kexec." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguläres Stoppen, dann ein vollständiger Firmware-Neustart statt kexec."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parada ordenada y luego un reinicio completo del firmware en lugar de kexec."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt normal, puis redémarrage complet par le firmware au lieu de kexec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresto ordinato, poi un riavvio completo del firmware invece di kexec."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавна зупинка, потім повне перезавантаження через прошивку замість kexec."
          }
        }
      }
    },
    "Grants cluster access with these roles until it expires; it cannot be revoked short of rotating the cluster CA." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewährt bis zum Ablauf Zugriff auf den Cluster mit diesen Rollen; widerrufen lässt sie sich nur durch Austausch der Cluster-CA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da acceso al clúster con estos roles hasta que caduque; solo se puede revocar rotando la CA del clúster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne accès au cluster avec ces rôles jusqu'à son expiration ; il ne peut être révoqué qu'en renouvelant la CA du cluster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede l'accesso al cluster con questi ruoli fino alla scadenza; si può revocare solo ruotando la CA del cluster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надає доступ до кластера з цими ролями до спливу терміну; відкликати його можна лише заміною CA кластера."
          }
        }
      }
    },
