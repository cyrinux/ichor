    "%@ gives up etcd leadership and another member is elected. Writes pause briefly during the election." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gibt die etcd-Führung ab und ein anderes Mitglied wird gewählt. Schreibvorgänge pausieren kurz während der Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cede el liderazgo de etcd y se elige a otro miembro. Las escrituras se detienen brevemente durante la elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cède le leadership etcd et un autre membre est élu. Les écritures sont brièvement suspendues pendant l'élection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cede la leadership di etcd e viene eletto un altro membro. Le scritture si fermano brevemente durante l'elezione."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ передає лідерство etcd, і обирається інший учасник. Під час виборів запис ненадовго призупиняється."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 将放弃 etcd 领导权，并选举另一个成员。选举期间写入会短暂暂停。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ が etcd のリーダーを譲り、別のメンバーが選出されます。選出中は書き込みが一時的に停止します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ abre mão da liderança do etcd e outro membro é eleito. As gravações pausam brevemente durante a eleição." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ отказывается от лидерства в etcd, и выбирается другой участник. Во время выборов запись ненадолго приостанавливается." } }
      }
    },
