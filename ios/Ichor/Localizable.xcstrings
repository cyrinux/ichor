    "Face ID / Touch ID, or the device passcode, to open the app and before reboot or shutdown. Also hides the app in the app switcher." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID oder der Gerätecode, um die App zu öffnen und vor Neustart oder Herunterfahren. Verbirgt die App auch im App-Umschalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID, o el código del dispositivo, para abrir la app y antes de reiniciar o apagar. También oculta la app en el selector de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID, ou le code de l'appareil, pour ouvrir l'app et avant un redémarrage ou un arrêt. Masque aussi l'app dans le sélecteur d'apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID, o il codice del dispositivo, per aprire l'app e prima di riavvio o spegnimento. Nasconde anche l'app nel selettore app."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID або код-пароль пристрою, щоб відкрити застосунок і перед перезавантаженням чи вимкненням. Також приховує застосунок у перемикачі програм."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开应用以及重启或关机前，需要 Face ID / Touch ID 或设备密码。同时会在应用切换器中隐藏应用内容。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリを開くときと、再起動やシャットダウンの前に Face ID / Touch ID またはデバイスのパスコードを要求します。アプリスイッチャーでもアプリの内容を隠します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Face ID / Touch ID, ou o código do dispositivo, para abrir o app e antes de reiniciar ou desligar. Também oculta o app no seletor de apps." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Face ID / Touch ID или код-пароль устройства для открытия приложения и перед перезагрузкой или выключением. Также скрывает приложение в переключателе приложений." } }
      }
    },
