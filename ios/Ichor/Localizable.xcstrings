    "Issue talosconfig" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "talosconfig ausstellen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitir talosconfig"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émettre un talosconfig"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emetti talosconfig"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Випуск talosconfig"
          }
        }
      }
    },
    "Issues a new certificate with the same roles and replaces this context's credentials on this device. Other contexts are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt ein neues Zertifikat mit denselben Rollen aus und ersetzt die Zugangsdaten dieses Kontexts auf diesem Gerät. Andere Kontexte bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emite un nuevo certificado con los mismos roles y sustituye las credenciales de este contexto en este dispositivo. Los demás contextos se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émet un nouveau certificat avec les mêmes rôles et remplace les identifiants de ce contexte sur cet appareil. Les autres contextes sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emette un nuovo certificato con gli stessi ruoli e sostituisce le credenziali di questo contesto sul dispositivo. Gli altri contesti restano invariati."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Випускає новий сертифікат з тими самими ролями й замінює облікові дані цього контексту на пристрої. Інші контексти зберігаються."
          }
        }
      }
    },
    "Issues a separate talosconfig for another device or person, to scan as a QR code or save as a file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt eine eigene talosconfig für ein anderes Gerät oder eine andere Person aus, als QR-Code zum Scannen oder als Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emite un talosconfig aparte para otro dispositivo o persona, para escanear como código QR o guardar como archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émet un talosconfig distinct pour un autre appareil ou une autre personne, à scanner en QR code ou à enregistrer dans un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emette un talosconfig separato per un altro dispositivo o persona, da scansionare come codice QR o salvare come file."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Випускає окремий talosconfig для іншого пристрою чи людини: відскануйте QR-код або збережіть файл."
          }
        }
      }
    },
    "It grants access to the cluster with %@ until %@, and cannot be revoked short of rotating the cluster CA." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gewährt Zugriff auf den Cluster mit %@ bis %@ und lässt sich nur durch Austausch der Cluster-CA widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da acceso al clúster con %@ hasta el %@ y solo se puede revocar rotando la CA del clúster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il donne accès au cluster avec %@ jusqu'au %@ et ne peut être révoqué qu'en renouvelant la CA du cluster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede l'accesso al cluster con %@ fino al %@ e si può revocare solo ruotando la CA del cluster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він надає доступ до кластера з %@ до %@, і відкликати його можна лише заміною CA кластера."
          }
        }
      }
    },
    "It is added to the clusters already on this device. A cluster imported before (same name and CA) is updated." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zu den Clustern auf diesem Gerät hinzugefügt. Ein bereits importierter Cluster (gleicher Name und gleiche CA) wird aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade a los clústeres que ya están en este dispositivo. Un clúster ya importado (mismo nombre y misma CA) se actualiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’ajoute aux clusters déjà présents sur cet appareil. Un cluster déjà importé (même nom et même CA) est mis à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene aggiunto ai cluster già presenti su questo dispositivo. Un cluster già importato (stesso nome e stessa CA) viene aggiornato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його буде додано до кластерів, які вже є на цьому пристрої. Уже імпортований кластер (та сама назва й той самий CA) буде оновлено."
          }
        }
      }
    },
    "It is free and open source. If it saves you time, you can support its development." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist kostenlos und quelloffen. Wenn sie dir Zeit spart, kannst du ihre Entwicklung unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es libre y gratuita. Si te ahorra tiempo, puedes apoyar su desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est libre et gratuite. Si elle vous fait gagner du temps, vous pouvez soutenir son développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È gratuita e open source. Se ti fa risparmiare tempo, puoi sostenerne lo sviluppo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він безкоштовний і з відкритим кодом. Якщо він заощаджує вам час, ви можете підтримати його розробку."
          }
        }
      }
    },
    "It stays off until someone powers it on (Wake-on-LAN, IPMI or physically)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt aus, bis ihn jemand einschaltet (Wake-on-LAN, IPMI oder vor Ort)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanece apagado hasta que alguien lo encienda (Wake-on-LAN, IPMI o físicamente)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste éteint jusqu'à ce que quelqu'un le rallume (Wake-on-LAN, IPMI ou physiquement)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta spento finché qualcuno non lo riaccende (Wake-on-LAN, IPMI o fisicamente)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він залишається вимкненим, доки хтось його не ввімкне (Wake-on-LAN, IPMI або фізично)."
          }
        }
      }
    },
