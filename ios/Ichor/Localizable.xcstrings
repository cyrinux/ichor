        "ja" : { "stringUnit" : { "state" : "translated", "value" : "1行に1つの age 公開鍵（age1…）を入力します。ファイルは対応する age 鍵でのみ、コンピューター上で開けます。この端末では復元できません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma chave pública age (age1…) por linha. Somente as chaves age correspondentes abrem o arquivo, em um computador: este telefone não pode restaurá-lo." } },
