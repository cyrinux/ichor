    "Only this phone can open the forwarded port, and only while Ichor stays open: nothing listens on the network the phone is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul ce téléphone peut ouvrir le port redirigé, et seulement tant qu'Ichor reste ouvert : rien n'écoute sur le réseau du téléphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo este teléfono puede abrir el puerto reenviado, y solo mientras Ichor siga abierto: nada escucha en la red del teléfono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieses Telefon kann den weitergeleiteten Port öffnen, und nur solange Ichor geöffnet bleibt: Im Netzwerk des Telefons lauscht nichts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo questo telefono può aprire la porta inoltrata, e solo finché Ichor resta aperta: nulla è in ascolto sulla rete del telefono."
