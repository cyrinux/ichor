        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вытеснить реплики с %@?" } }
      }
    },
    "Longhorn copies every replica on %@ to other nodes, then removes them. Scheduling stays off until you turn it back on." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn copie chaque réplique de %@ sur d’autres nœuds, puis les supprime. La planification reste désactivée jusqu’à ce que vous la réactiviez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn copia cada réplica de %@ a otros nodos y luego las elimina. La programación queda desactivada hasta que la vuelvas a activar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn копіює кожну репліку з %@ на інші вузли, а потім видаляє їх. Планування залишається вимкненим, доки ви його знову не увімкнете."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn kopiert jedes Replikat auf %@ auf andere Nodes und entfernt sie dann. Die Planung bleibt aus, bis du sie wieder einschaltest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn copia ogni replica di %@ su altri nodi, poi le rimuove. La pianificazione resta disattivata finché non la riattivi."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn 会将 %@ 上的每个副本复制到其他节点，然后将其移除。调度会保持关闭，直到你重新开启。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn は %@ 上のすべてのレプリカを他のノードにコピーしてから削除します。スケジューリングは再度オンにするまでオフのままです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Longhorn copia cada réplica de %@ para outros nós e depois as remove. O agendamento permanece desativado até você reativá-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn копирует каждую реплику с %@ на другие узлы, затем удаляет их. Планирование остаётся выключенным, пока вы не включите его снова." } }
      }
    },
    "Replicas now: %lld wanted, %lld healthy." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répliques actuelles : %lld voulues, %lld saines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réplicas ahora: %lld deseadas, %lld sanas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз реплік: потрібно %lld, справних %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replikate derzeit: %lld gewünscht, %lld gesund."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repliche ora: %lld richieste, %lld integre."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前副本：期望 %lld 个，健康 %lld 个。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のレプリカ：必要数%lld、正常%lld。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Réplicas agora: %lld desejadas, %lld íntegras." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Реплики сейчас: нужно %lld, исправно %lld." } }
      }
    },
    "Longhorn builds the new replicas from a healthy one: disk and network IO while it copies." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn construit les nouvelles répliques à partir d’une réplique saine : E/S disque et réseau pendant la copie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn crea las réplicas nuevas a partir de una sana: E/S de disco y red mientras copia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn створює нові репліки зі справної: навантаження на диск і мережу під час копіювання."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn baut die neuen Replikate aus einem gesunden auf: Festplatten- und Netzwerk-IO während des Kopierens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn crea le nuove repliche da una integra: I/O su disco e rete durante la copia."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn 会从一个健康副本构建新副本：复制期间会产生磁盘和网络 IO。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn は正常なレプリカから新しいレプリカを作成します。コピー中はディスクとネットワークの IO が発生します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Longhorn cria as novas réplicas a partir de uma íntegra: E/S de disco e rede durante a cópia." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn создаёт новые реплики из исправной: во время копирования нагружаются диск и сеть." } }
      }
    },
    "Longhorn removes the extra replicas: fewer copies survive a node or disk failure." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn supprime les répliques en trop : moins de copies survivent à la panne d’un nœud ou d’un disque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn elimina las réplicas sobrantes: menos copias sobreviven a un fallo de nodo o de disco."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn видаляє зайві репліки: менше копій переживе збій вузла чи диска."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn entfernt die überzähligen Replikate: weniger Kopien überstehen einen Node- oder Festplattenausfall."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longhorn rimuove le repliche in eccesso: meno copie sopravvivono a un guasto di nodo o disco."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn 会移除多余的副本：节点或磁盘故障时可存活的副本更少。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn は余分なレプリカを削除します。ノードやディスクの障害時に残るコピーが少なくなります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Longhorn remove as réplicas extras: menos cópias sobrevivem a uma falha de nó ou disco." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Longhorn удаляет лишние реплики: при отказе узла или диска уцелеет меньше копий." } }
      }
    },
    "With a single replica, losing its node or disk loses the data." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une seule réplique, perdre son nœud ou son disque fait perdre les données."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una sola réplica, perder su nodo o su disco supone perder los datos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З однією реплікою втрата її вузла чи диска означає втрату даних."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit nur einem Replikat gehen beim Verlust seines Nodes oder seiner Festplatte die Daten verloren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una sola replica, perdere il suo nodo o disco significa perdere i dati."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有一个副本时，其节点或磁盘丢失就会丢失数据。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レプリカが 1 つだけの場合、そのノードまたはディスクを失うとデータも失われます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Com uma única réplica, perder seu nó ou disco significa perder os dados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "С одной репликой потеря её узла или диска означает потерю данных." } }
