    },
    "For images without a shell (distroless): adds a temporary container that sees this pod's processes. Kubernetes keeps it in the pod until the pod is deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Images ohne Shell (distroless): fügt einen temporären Container hinzu, der die Prozesse dieses Pods sieht. Kubernetes behält ihn im Pod, bis der Pod gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para imágenes sin shell (distroless): añade un contenedor temporal que ve los procesos de este pod. Kubernetes lo mantiene en el pod hasta que se elimina el pod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les images sans shell (distroless) : ajoute un conteneur temporaire qui voit les processus de ce pod. Kubernetes le garde dans le pod jusqu’à la suppression du pod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per immagini senza shell (distroless): aggiunge un container temporaneo che vede i processi di questo pod. Kubernetes lo mantiene nel pod finché il pod non viene eliminato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для образів без оболонки (distroless): додає тимчасовий контейнер, який бачить процеси цього пода. Kubernetes зберігає його в поді, доки под не буде видалено."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适用于没有 shell 的镜像（distroless）：添加一个能看到此 Pod 进程的临时容器。Kubernetes 会将其保留在 Pod 中，直到 Pod 被删除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "シェルのないイメージ（distroless）向け：この Pod のプロセスを参照できる一時コンテナを追加します。Kubernetes は Pod が削除されるまでこのコンテナを Pod 内に保持します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para imagens sem shell (distroless): adiciona um contêiner temporário que vê os processos deste pod. O Kubernetes o mantém no pod até que o pod seja excluído." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для образов без оболочки (distroless): добавляет временный контейнер, который видит процессы этого пода. Kubernetes хранит его в поде до удаления пода." } }
      }
    },
