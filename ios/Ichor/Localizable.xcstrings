    "Background checks are off, so no cluster is checked and this list stays as it is. Turn on alerts to fill it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vérifications en arrière-plan sont désactivées : aucun cluster n'est vérifié et cette liste ne change pas. Activez les alertes pour la remplir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comprobaciones en segundo plano están desactivadas: no se comprueba ningún clúster y esta lista no cambia. Activa las alertas para llenarla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фонові перевірки вимкнено: жоден кластер не перевіряється, і цей список не змінюється. Увімкніть сповіщення, щоб заповнити його."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundprüfungen sind aus: Kein Cluster wird geprüft und diese Liste bleibt, wie sie ist. Schalte die Alarme ein, um sie zu füllen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I controlli in background sono disattivati: nessun cluster viene controllato e questo elenco resta com'è. Attiva gli avvisi per riempirlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台检查已关闭：不会检查任何集群，此列表保持不变。开启告警即可填充它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドの確認がオフのため、どのクラスターも確認されず、この一覧は変わりません。アラートをオンにすると一覧が埋まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As verificações em segundo plano estão desligadas: nenhum cluster é verificado e esta lista fica como está. Ative os alertas para preenchê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновые проверки выключены: ни один кластер не проверяется, и этот список не меняется. Включите оповещения, чтобы заполнить его."
          }
        }
      }
    },
