    "Opens a terminal in the running container of %@, like kubectl exec -it. Leave the command empty to run bash, or sh when the image has no bash." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet ein Terminal im laufenden Container von %@, wie kubectl exec -it. Lass den Befehl leer, um bash zu starten, oder sh, wenn das Image kein bash hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un terminal en el contenedor en ejecución de %@, como kubectl exec -it. Deja el comando vacío para ejecutar bash, o sh si la imagen no tiene bash."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre un terminal dans le conteneur en cours d'exécution de %@, comme kubectl exec -it. Laissez la commande vide pour lancer bash, ou sh si l'image n'a pas bash."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre un terminale nel container in esecuzione di %@, come kubectl exec -it. Lascia vuoto il comando per avviare bash, o sh se l'immagine non ha bash."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває термінал у запущеному контейнері %@, як kubectl exec -it. Залиште команду порожньою, щоб запустити bash, або sh, якщо в образі немає bash."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 %@ 运行中的容器里打开终端，类似 kubectl exec -it。命令留空则运行 bash；镜像中没有 bash 时运行 sh。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "kubectl exec -it と同様に、%@の実行中のコンテナでターミナルを開きます。コマンドを空にすると bash を実行し、イメージに bash がない場合は sh を実行します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre um terminal no contêiner em execução de %@, como kubectl exec -it. Deixe o comando vazio para executar bash, ou sh quando a imagem não tiver bash." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает терминал в работающем контейнере %@, как kubectl exec -it. Оставьте команду пустой, чтобы запустить bash, или sh, если в образе нет bash." } }
