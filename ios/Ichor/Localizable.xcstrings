    "Boot the new machine from the Talos ISO: it waits in maintenance mode and its console shows its IP address. Your phone must be on the same network, or on a VPN that reaches it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez la nouvelle machine sur l'ISO Talos : elle attend en mode maintenance et sa console affiche son adresse IP. Votre téléphone doit être sur le même réseau, ou sur un VPN qui l'atteint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranca la nueva máquina con la ISO de Talos: espera en modo mantenimiento y su consola muestra su dirección IP. Tu teléfono debe estar en la misma red o en una VPN que llegue a ella."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Maschine vom Talos-ISO starten: Sie wartet im Wartungsmodus, ihre Konsole zeigt ihre IP-Adresse. Das Telefon muss im selben Netz sein oder in einem VPN, das sie erreicht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia la nuova macchina dalla ISO di Talos: attende in modalità manutenzione e la sua console mostra il suo indirizzo IP. Il telefono deve essere sulla stessa rete o su una VPN che la raggiunge."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажте нову машину з ISO Talos: вона чекає в режимі обслуговування, а її консоль показує її IP-адресу. Телефон має бути в тій самій мережі або у VPN, що до неї дістається."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用 Talos ISO 启动新机器：它会在维护模式下等待，控制台会显示其 IP 地址。你的手机必须在同一网络中，或通过能访问它的 VPN 连接。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマシンを Talos ISO から起動してください。メンテナンスモードで待機し、コンソールに IP アドレスが表示されます。スマートフォンが同じネットワーク上、またはそこに到達できる VPN 上にある必要があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Inicialize a nova máquina com a ISO do Talos: ela aguarda em modo de manutenção e o console mostra o endereço IP. Seu telefone precisa estar na mesma rede ou em uma VPN que a alcance." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузите новую машину с ISO Talos: она ждёт в режиме обслуживания, а её консоль показывает IP-адрес. Телефон должен быть в той же сети или в VPN, через который она доступна." } }
      }
    },
