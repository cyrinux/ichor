    "Offset of each node's clock from its NTP server. Drift breaks etcd and certificate checks: warning from 500 ms, critical from 5 s." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abweichung der Uhr jedes Knotens von seinem NTP-Server. Abweichungen stören etcd und Zertifikatsprüfungen: Warnung ab 500 ms, kritisch ab 5 s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfase del reloj de cada nodo respecto a su servidor NTP. La deriva afecta a etcd y a la validación de certificados: aviso desde 500 ms, crítico desde 5 s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décalage de l'horloge de chaque nœud par rapport à son serveur NTP. Une dérive perturbe etcd et la vérification des certificats : alerte dès 500 ms, critique dès 5 s."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarto dell'orologio di ogni nodo rispetto al suo server NTP. La deriva compromette etcd e la verifica dei certificati: avviso da 500 ms, critico da 5 s."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зсув годинника кожного вузла відносно його NTP-сервера. Дрейф ламає etcd і перевірку сертифікатів: попередження від 500 мс, критично від 5 с."
          }
        }
      }
    },
