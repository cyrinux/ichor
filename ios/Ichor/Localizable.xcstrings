    "%@ gets the pod template of revision %lld back: its pods are replaced with a rolling update, like kubectl rollout undo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bekommt die Pod-Vorlage von Revision %lld zurück: Seine Pods werden per Rolling Update ersetzt, wie bei kubectl rollout undo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recupera la plantilla de pod de la revisión %lld: sus pods se reemplazan con una actualización gradual, como kubectl rollout undo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reprend le modèle de pod de la révision %lld : ses pods sont remplacés par une mise à jour progressive, comme kubectl rollout undo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ riprende il modello di pod della revisione %lld: i suoi pod vengono sostituiti con un aggiornamento graduale, come kubectl rollout undo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ повертає шаблон подів ревізії %lld: його поди замінюються поступовим оновленням, як kubectl rollout undo."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 将恢复修订版本 %lld 的 Pod 模板：其 Pod 会通过滚动更新替换，等同于 kubectl rollout undo。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ はリビジョン %lld の Pod テンプレートに戻ります。kubectl rollout undo と同様に、Pod はローリングアップデートで置き換えられます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ volta ao template de pod da revisão %lld: seus pods são substituídos com uma atualização gradual, como kubectl rollout undo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ возвращает шаблон пода ревизии %lld: поды заменяются поэтапным обновлением, как с kubectl rollout undo." } }
