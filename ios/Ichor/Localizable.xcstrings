        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Detener el mantenimiento?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter la maintenance ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermare la manutenzione?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупинити обслуговування?"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止维护？" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メンテナンスを停止しますか？" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar a manutenção?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановить обслуживание?" } }
      }
    },
    "Stopping leaves the node cordoned." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Stoppen bleibt der Knoten abgesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener deja el nodo acordonado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter laisse le nœud cordonné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermare lascia il nodo isolato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупинка залишає вузол закордонованим."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止后节点将保持禁止调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止すると、ノードはスケジュール停止のままになります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Interromper deixa o nó isolado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "После остановки планирование на узле остаётся запрещённым." } }
      }
    },
    "Stopping, or a failure, leaves the node cordoned. Keep Ichor open until the maintenance ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stopp oder ein Fehler lässt den Knoten abgesperrt. Lass Ichor offen, bis die Wartung endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenerlo, o un fallo, deja el nodo acordonado. Mantén Ichor abierto hasta que termine el mantenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arrêt, ou un échec, laisse le nœud cordonné. Gardez Ichor ouvert jusqu’à la fin de la maintenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arresto, o un errore, lascia il nodo isolato. Tieni Ichor aperto finché la manutenzione non finisce."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупинка або збій залишають вузол закордонованим. Тримайте Ichor відкритим до завершення обслуговування."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止或失败都会让节点保持禁止调度。在维护结束前保持 Ichor 打开。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止または失敗した場合、ノードはスケジュール停止のままになります。メンテナンスが終わるまで Ichor を開いたままにしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma interrupção, ou uma falha, deixa o nó isolado. Mantenha o Ichor aberto até o fim da manutenção." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "После остановки или сбоя планирование на узле остаётся запрещённым. Не закрывайте Ichor до конца обслуживания." } }
      }
    },
