    "The Flux HelmRelease %@ manages this release: it is suspended first, otherwise Flux would upgrade it straight back. Fix the version in Git, then resume it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Flux-HelmRelease %@ verwaltet dieses Release: Es wird zuerst angehalten, sonst würde Flux sofort wieder aktualisieren. Korrigieren Sie die Version in Git und setzen Sie es dann fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La HelmRelease de Flux %@ gestiona esta release: primero se suspende, si no Flux la volvería a actualizar enseguida. Corrija la versión en Git y luego reanúdela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La HelmRelease Flux %@ gère cette release : elle est d'abord suspendue, sinon Flux la remettrait aussitôt à jour. Corrigez la version dans Git, puis reprenez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La HelmRelease di Flux %@ gestisce questa release: viene prima sospesa, altrimenti Flux la aggiornerebbe subito di nuovo. Correggi la versione in Git, poi riprendila."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flux HelmRelease %@ керує цим релізом: спершу його призупинено, інакше Flux одразу оновить його назад. Виправте версію в Git, потім відновіть."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 release 由 Flux HelmRelease %@ 管理：会先将其暂停，否则 Flux 会立即重新升级。在 Git 中修正版本后再恢复它。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリリースは Flux HelmRelease %@が管理しています。先に一時停止しないと、Flux がすぐにアップグレードし直してしまいます。Git でバージョンを修正してから再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O HelmRelease %@ do Flux gerencia esta release: ele é suspenso primeiro, senão o Flux a atualizaria de volta na hora. Corrija a versão no Git e depois retome-o." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Этим релизом управляет HelmRelease Flux %@: сначала он приостанавливается, иначе Flux сразу же обновит релиз обратно. Исправьте версию в Git, затем возобновите его." } }
      }
    },
    "Cannot roll back" : {
      "extractionState" : "manual",
