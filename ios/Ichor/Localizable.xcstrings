    "Read its failure, then the Machines and infrastructure under it: clusterctl describe cluster <name> -n <namespace>." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen Sie den Fehler, dann die Machines und die Infrastruktur darunter: clusterctl describe cluster <name> -n <namespace>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee su fallo y luego las Machines y la infraestructura que tiene debajo: clusterctl describe cluster <name> -n <namespace>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez son échec, puis les Machines et l’infrastructure en dessous : clusterctl describe cluster <name> -n <namespace>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi il suo errore, poi le Machine e l’infrastruttura sottostante: clusterctl describe cluster <name> -n <namespace>."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте збій, потім Machines та інфраструктуру під ним: clusterctl describe cluster <name> -n <namespace>."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看其失败原因，然后查看其下的 Machine 和基础设施：clusterctl describe cluster <name> -n <namespace>。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "失敗内容を確認し、その配下の Machine とインフラストラクチャを確認してください：clusterctl describe cluster <name> -n <namespace>。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Leia a falha dele e depois as Machines e a infraestrutura abaixo dele: clusterctl describe cluster <name> -n <namespace>." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прочитайте его ошибку, затем проверьте Machines и инфраструктуру под ним: clusterctl describe cluster <name> -n <namespace>." } }
      }
    },
    "Something under it never became ready: clusterctl describe cluster <name> -n <namespace> shows which part waits (infrastructure, control plane or a Machine)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas darunter wurde nie bereit: clusterctl describe cluster <name> -n <namespace> zeigt, welcher Teil wartet (Infrastruktur, Control Plane oder eine Machine)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo debajo nunca llegó a estar listo: clusterctl describe cluster <name> -n <namespace> muestra qué parte espera (infraestructura, plano de control o una Machine)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose en dessous n’est jamais devenu prêt : clusterctl describe cluster <name> -n <namespace> montre quelle partie attend (infrastructure, plan de contrôle ou une Machine)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa sotto non è mai diventato pronto: clusterctl describe cluster <name> -n <namespace> mostra quale parte attende (infrastruttura, control plane o una Machine)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось під ним так і не стало готовим: clusterctl describe cluster <name> -n <namespace> показує, яка частина чекає (інфраструктура, площина керування чи Machine)."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其下有部分始终未就绪：clusterctl describe cluster <name> -n <namespace> 会显示哪一部分在等待（基础设施、控制平面或某个 Machine）。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "配下の何かが準備完了になっていません。clusterctl describe cluster <name> -n <namespace> で、どの部分（インフラストラクチャ、コントロールプレーン、Machine）が待機中かを確認できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Algo abaixo dele nunca ficou pronto: clusterctl describe cluster <name> -n <namespace> mostra qual parte está aguardando (infraestrutura, control plane ou uma Machine)." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Что-то под ним так и не стало готовым: clusterctl describe cluster <name> -n <namespace> покажет, какая часть ждёт (инфраструктура, control plane или Machine)." } }
      }
    },
    "Its infrastructure could not be provisioned. Read kubectl describe machine -n <namespace> <name>, then delete it so its MachineSet or control plane makes a new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Infrastruktur konnte nicht bereitgestellt werden. Lesen Sie kubectl describe machine -n <namespace> <name> und löschen Sie sie, damit ihr MachineSet oder die Control Plane eine neue anlegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo aprovisionar su infraestructura. Lee kubectl describe machine -n <namespace> <name> y luego bórrala para que su MachineSet o plano de control cree otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son infrastructure n’a pas pu être provisionnée. Lisez kubectl describe machine -n <namespace> <name>, puis supprimez-la pour que son MachineSet ou son plan de contrôle en crée une nouvelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile predisporre la sua infrastruttura. Leggi kubectl describe machine -n <namespace> <name>, poi eliminala perché il suo MachineSet o il control plane ne crei una nuova."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її інфраструктуру не вдалося підготувати. Прочитайте kubectl describe machine -n <namespace> <name>, потім видаліть її, щоб MachineSet або площина керування створили нову."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其基础设施无法置备。查看 kubectl describe machine -n <namespace> <name>，然后删除它，让其 MachineSet 或控制平面创建新的。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "インフラストラクチャをプロビジョニングできませんでした。kubectl describe machine -n <namespace> <name> を確認してから削除すると、MachineSet またはコントロールプレーンが新しく作成します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível provisionar a infraestrutura dela. Leia kubectl describe machine -n <namespace> <name> e depois exclua-a para que o MachineSet ou o control plane dela crie uma nova." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось подготовить её инфраструктуру. Прочитайте kubectl describe machine -n <namespace> <name>, затем удалите её, чтобы её MachineSet или control plane создал новую." } }
      }
    },
    "Its infrastructure or bootstrap never finished (no free server, PXE never answered, no bootstrap Secret): kubectl describe machine -n <namespace> <name>." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infrastruktur oder Bootstrap wurden nie fertig (kein freier Server, PXE ohne Antwort, kein Bootstrap-Secret): kubectl describe machine -n <namespace> <name>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su infraestructura o su bootstrap nunca terminó (ningún servidor libre, PXE sin respuesta, sin Secret de bootstrap): kubectl describe machine -n <namespace> <name>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son infrastructure ou son bootstrap n’a jamais fini (aucun serveur libre, PXE sans réponse, pas de Secret de bootstrap) : kubectl describe machine -n <namespace> <name>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua infrastruttura o il bootstrap non sono mai finiti (nessun server libero, PXE senza risposta, nessun Secret di bootstrap): kubectl describe machine -n <namespace> <name>."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її інфраструктура чи bootstrap так і не завершилися (немає вільного сервера, PXE не відповів, немає bootstrap Secret): kubectl describe machine -n <namespace> <name>."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其基础设施或引导始终未完成（没有空闲服务器、PXE 无响应、没有引导 Secret）：kubectl describe machine -n <namespace> <name>。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "インフラストラクチャまたはブートストラップが完了していません（空きサーバーがない、PXE が応答しない、ブートストラップ Secret がない）：kubectl describe machine -n <namespace> <name>。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A infraestrutura ou o bootstrap dela nunca terminou (nenhum servidor livre, o PXE nunca respondeu, nenhum Secret de bootstrap): kubectl describe machine -n <namespace> <name>." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Её инфраструктура или bootstrap так и не завершились (нет свободного сервера, PXE не ответил, нет bootstrap Secret): kubectl describe machine -n <namespace> <name>." } }
      }
    },
    "Some of its Machines are not available: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, then the servers free for them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige ihrer Machines sind nicht verfügbar: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, dann die dafür freien Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas de sus Machines no están disponibles: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name> y luego los servidores libres para ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines de ses Machines ne sont pas disponibles : kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, puis les serveurs libres pour elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune sue Machine non sono disponibili: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, poi i server liberi per loro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі її Machines недоступні: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, потім вільні для них сервери."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "其部分 Machine 不可用：kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>，然后检查可供它们使用的空闲服务器。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部の Machine が利用できません：kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name> を実行し、割り当て可能な空きサーバーを確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Algumas das Machines dele não estão disponíveis: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, e depois os servidores livres para elas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Часть его Machines недоступна: kubectl get machines -n <namespace> -l cluster.x-k8s.io/deployment-name=<name>, затем проверьте свободные для них серверы." } }
      }
    },
    "A workload cluster node is down. Power it on from its BMC, or check the BMC credentials Sidero uses: kubectl describe server <name>." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Knoten eines Workload-Clusters ist ausgefallen. Schalten Sie ihn über sein BMC ein oder prüfen Sie die BMC-Zugangsdaten von Sidero: kubectl describe server <name>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nodo de un clúster está caído. Enciéndelo desde su BMC o revisa las credenciales de BMC que usa Sidero: kubectl describe server <name>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nœud d’un cluster est hors service. Allumez-le depuis son BMC, ou vérifiez les identifiants BMC qu’utilise Sidero : kubectl describe server <name>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nodo di un cluster è giù. Accendilo dal suo BMC o controlla le credenziali BMC che usa Sidero: kubectl describe server <name>."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вузол робочого кластера не працює. Увімкніть його через BMC або перевірте облікові дані BMC, які використовує Sidero: kubectl describe server <name>."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "某个工作负载集群节点已宕机。从其 BMC 开机，或检查 Sidero 使用的 BMC 凭据：kubectl describe server <name>。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ワークロードクラスターのノードがダウンしています。BMC から電源を入れるか、Sidero が使用する BMC の認証情報を確認してください：kubectl describe server <name>。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um nó de um cluster de carga de trabalho está fora do ar. Ligue-o pelo BMC dele ou verifique as credenciais de BMC que o Sidero usa: kubectl describe server <name>." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узел рабочего кластера не работает. Включите его через BMC или проверьте учётные данные BMC, которые использует Sidero: kubectl describe server <name>." } }
      }
    },
    "Sidero does not use it until it is accepted: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidero nutzt ihn erst, wenn er angenommen ist: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidero no lo usa hasta que se acepta: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidero ne l’utilise pas tant qu’il n’est pas accepté : kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidero non lo usa finché non è accettato: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidero не використовує його, доки його не прийнято: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在被接受之前 Sidero 不会使用它：kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "承認されるまで Sidero はこのサーバーを使用しません：kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Sidero não o usa até que seja aceito: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Sidero не использует сервер, пока он не принят: kubectl patch server <name> --type merge -p '{\"spec\":{\"accepted\":true}}'." } }
      }
    },
