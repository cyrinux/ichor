        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la sincronización automática para revertir: si no, Argo CD vuelve enseguida a la última revisión."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиніть автосинхронізацію, щоб відкотитися: інакше Argo CD одразу синхронізує останню ревізію."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere Auto-Sync, um zurückzurollen: sonst synchronisiert Argo CD sofort wieder auf die neueste Revision."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa la sincronizzazione automatica per tornare indietro: altrimenti Argo CD risincronizza subito l'ultima revisione."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "回滚前需暂停自动同步：否则 Argo CD 会立即同步回最新修订版本。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロールバックするには自動同期を一時停止してください。停止しないと Argo CD がすぐに最新リビジョンへ同期し直します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pause a sincronização automática para reverter: caso contrário, o Argo CD sincroniza de volta imediatamente para a revisão mais recente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для отката приостановите автосинхронизацию: иначе Argo CD сразу вернёт последнюю ревизию." } }
      }
    },
