        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta build recebe atualizações da App Store, ou do TestFlight no caso de uma beta." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта сборка получает обновления из App Store или из TestFlight для бета-версий." } }
      }
    },
    "This build cannot update itself: install each new release from GitHub again, with Sideloadly or AltStore." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne peut pas se mettre à jour elle-même : installez chaque nouvelle release depuis GitHub, avec Sideloadly ou AltStore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión no puede actualizarse sola: instala cada nueva versión desde GitHub con Sideloadly o AltStore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build kann sich nicht selbst aktualisieren: Installiere jedes neue Release von GitHub erneut, mit Sideloadly oder AltStore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build non può aggiornarsi da sola: installa di nuovo ogni nuova release da GitHub, con Sideloadly o AltStore."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця збірка не може оновлюватися сама: встановлюйте кожен новий реліз із GitHub заново через Sideloadly чи AltStore."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此版本无法自动更新：每个新版本都需要用 Sideloadly 或 AltStore 从 GitHub 重新安装。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このビルドは自動でアップデートできません。新しいリリースごとに、Sideloadly または AltStore を使って GitHub から再インストールしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta build não se atualiza sozinha: instale cada nova versão do GitHub novamente, com o Sideloadly ou o AltStore." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта сборка не обновляется сама: устанавливайте каждый новый релиз с GitHub заново через Sideloadly или AltStore." } }
      }
    },
    "Add a cluster imports a talosconfig or a kubeconfig. The clusters already stored are kept." : {
