    "No CSI VolumeSnapshots. Longhorn’s own snapshots are under each Longhorn volume." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun VolumeSnapshot CSI. Les snapshots propres à Longhorn sont sous chaque volume Longhorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay VolumeSnapshots CSI. Los snapshots propios de Longhorn están en cada volumen de Longhorn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine CSI-VolumeSnapshots. Longhorns eigene Snapshots stehen bei jedem Longhorn-Volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun VolumeSnapshot CSI. Gli snapshot propri di Longhorn sono sotto ogni volume Longhorn."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає CSI VolumeSnapshot. Власні знімки Longhorn — у кожному томі Longhorn."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有 CSI VolumeSnapshot。Longhorn 自身的快照位于每个 Longhorn 卷下。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "CSI VolumeSnapshot はありません。Longhorn 独自のスナップショットは各 Longhorn ボリュームの下にあります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum VolumeSnapshot CSI. Os snapshots próprios do Longhorn ficam em cada volume do Longhorn." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет CSI VolumeSnapshot. Собственные снимки Longhorn находятся в каждом томе Longhorn." } }
      }
    },
    "Restoring creates the backup's objects again. Target namespaces that do not exist are created; ones that exist get the backup's objects merged in, overwriting them with update." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration recrée les objets de la sauvegarde. Les espaces de noms qui n'existent pas sont créés ; ceux qui existent reçoivent les objets de la sauvegarde, qui les écrasent avec la mise à jour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar se vuelven a crear los objetos de la copia. Los espacios de nombres que no existen se crean; los que existen reciben los objetos de la copia, y con actualizar se sobrescriben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen werden die Objekte des Backups neu angelegt. Namespaces, die es nicht gibt, werden erstellt; bestehende erhalten die Objekte des Backups, mit Aktualisieren werden sie überschrieben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino ricrea gli oggetti del backup. I namespace che non esistono vengono creati; quelli esistenti ricevono gli oggetti del backup, che con l'aggiornamento li sovrascrivono."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення знову створює об'єкти резервної копії. Простори імен, яких не існує, буде створено; наявні отримують об'єкти копії, і з оновленням їх перезаписано."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复会重新创建备份中的对象。不存在的目标命名空间会被创建；已存在的命名空间会合并备份中的对象，选择更新时会覆盖它们。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元すると、バックアップのオブジェクトが再作成されます。存在しない復元先の名前空間は作成され、既存の名前空間にはバックアップのオブジェクトがマージされ、更新を選択した場合は上書きされます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A restauração recria os objetos do backup. Namespaces de destino que não existem são criados; nos que existem, os objetos do backup são mesclados, sobrescrevendo-os com a atualização." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Восстановление заново создаёт объекты из резервной копии. Несуществующие целевые пространства имён создаются; в существующие добавляются объекты из копии, а при «обновить» они перезаписываются." } }
      }
    },
    "Pick at least one namespace to restore" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez au moins un espace de noms à restaurer"
