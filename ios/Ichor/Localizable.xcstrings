            "value" : "Ohne einen davon lassen sich die gespeicherten Konfigurationen nicht lesen. Lösche sie, um neu zu beginnen und deine talosconfig erneut zu importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
