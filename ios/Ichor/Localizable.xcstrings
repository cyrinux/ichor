    "Shown on this device only, the talosconfig keeps %@. Leave empty to use it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf diesem Gerät angezeigt, die talosconfig behält %@. Leer lassen, um ihn wieder zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestra en este dispositivo, el talosconfig conserva %@. Déjalo vacío para volver a usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché sur cet appareil uniquement, le talosconfig garde %@. Laisser vide pour le reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato solo su questo dispositivo, il talosconfig mantiene %@. Lascia vuoto per usarlo di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується лише на цьому пристрої, talosconfig зберігає %@. Залиште порожнім, щоб повернути її."
          }
        }
      }
    },
