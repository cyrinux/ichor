    "A security key is required: alerts and the widget pause when iOS has closed Ichor, until you unlock it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sicherheitsschlüssel ist erforderlich: Warnungen und das Widget pausieren, wenn iOS Ichor geschlossen hat, bis du es wieder entsperrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se exige una llave de seguridad: las alertas y el widget se pausan cuando iOS ha cerrado Ichor, hasta que lo desbloquees de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé de sécurité est exigée : les alertes et le widget s'arrêtent quand iOS a fermé Ichor, jusqu'à ce que vous le déverrouilliez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È richiesta una chiave di sicurezza: avvisi e widget si fermano quando iOS ha chiuso Ichor, finché non lo sblocchi di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимагається ключ безпеки: сповіщення та віджет призупиняються, коли iOS закрив Ichor, доки ви не розблокуєте його знову."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要安全密钥：当 iOS 关闭 Ichor 后，告警和小组件会暂停，直到你再次解锁。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "セキュリティキーが必要です。iOS が Ichor を終了すると、再びロック解除するまでアラートとウィジェットは一時停止します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma chave de segurança é exigida: os alertas e o widget pausam quando o iOS fecha o Ichor, até você desbloqueá-lo de novo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Требуется ключ безопасности: оповещения и виджет приостанавливаются, когда iOS закрывает Ichor, пока вы снова его не разблокируете." } }
      }
    },
