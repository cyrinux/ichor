    "Captures can contain sensitive traffic: share them with care." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitschnitte können sensiblen Verkehr enthalten: nur mit Bedacht teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas pueden contener tráfico sensible: compártelas con cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures peuvent contenir du trafic sensible : partagez-les avec prudence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le catture possono contenere traffico sensibile: condividile con cautela."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоплення можуть містити чутливий трафік: діліться ними обережно."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "抓包可能包含敏感流量：分享时请谨慎。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャプチャには機密性の高いトラフィックが含まれる場合があります：共有には注意してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As capturas podem conter tráfego sensível: compartilhe-as com cuidado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Захваты могут содержать конфиденциальный трафик: делитесь ими с осторожностью." } }
      }
    },
    "Captures can contain sensitive traffic (tokens, internal names). They are kept on this phone only, out of backups: delete them when done." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitschnitte können sensiblen Verkehr enthalten (Tokens, interne Namen). Sie bleiben nur auf diesem Telefon, außerhalb von Backups: danach löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas pueden contener tráfico sensible (tokens, nombres internos). Se guardan solo en este teléfono, fuera de las copias de seguridad: elimínalas al terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures peuvent contenir du trafic sensible (jetons, noms internes). Elles restent sur ce téléphone, hors sauvegardes : supprimez-les une fois terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le catture possono contenere traffico sensibile (token, nomi interni). Restano solo su questo telefono, fuori dai backup: eliminale quando hai finito."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захоплення можуть містити чутливий трафік (токени, внутрішні імена). Вони зберігаються лише на цьому телефоні, поза резервними копіями: видаліть їх, коли закінчите."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "抓包可能包含敏感流量（令牌、内部名称）。它们仅保存在这部手机上，不会进入备份：用完后请删除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャプチャには機密性の高いトラフィック（トークン、内部名）が含まれる場合があります。このスマートフォンにのみ保存され、バックアップには含まれません：使い終わったら削除してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As capturas podem conter tráfego sensível (tokens, nomes internos). Elas ficam somente neste telefone, fora dos backups: exclua-as quando terminar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Захваты могут содержать конфиденциальный трафик (токены, внутренние имена). Они хранятся только на этом телефоне и не попадают в резервные копии: удалите их, когда закончите." } }
      }
    },
