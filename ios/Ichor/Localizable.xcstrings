    "%@ is back and uncordoned" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist zurück und nicht mehr abgesperrt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha vuelto y ya no está acordonado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est de retour et n’est plus cordonné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è tornato e non è più isolato"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ повернувся, кордон знято"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已恢复并恢复调度" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ が復帰し、スケジュールを再開しました" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ voltou e foi liberado" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ снова в строю, планирование разрешено" } }
      }
    },
    "%@ is cordoned and its pods are evicted. It stays cordoned: uncordon it from its menu when ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird abgesperrt und seine Pods werden verdrängt. Er bleibt abgesperrt: Hebe die Sperre in seinem Menü auf, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se acordona y sus pods se desalojan. Sigue acordonado: quita el cordón desde su menú cuando esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est cordonné et ses pods sont évincés. Il reste cordonné : levez le cordon depuis son menu une fois prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene isolato e i suoi pod vengono espulsi. Resta isolato: rimuovi l’isolamento dal suo menu quando sei pronto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ буде закордоновано, а його поди виселено. Він залишиться закордонованим: зніміть кордон з його меню, коли будете готові."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已禁止调度，其 Pod 已被驱逐。它会保持禁止调度：准备就绪后从其菜单中恢复调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のスケジュールを停止し、Pod を退避します。スケジュール停止のままになるため、準備ができたらメニューからスケジュールを再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ é isolado (cordon) e seus pods são removidos. Ele continua isolado: libere-o pelo menu dele quando estiver pronto." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для %@ запрещено планирование, его поды вытеснены. Запрет сохраняется: когда будете готовы, разрешите планирование из меню узла." } }
      }
    },
    "%@ is cordoned, its pods are evicted, then it reboots and is uncordoned once Ready again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird abgesperrt, seine Pods werden verdrängt, dann startet er neu und wird freigegeben, sobald er wieder Ready ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se acordona, sus pods se desalojan, luego se reinicia y se quita el cordón cuando vuelve a estar Ready."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est cordonné, ses pods sont évincés, puis il redémarre et le cordon est levé une fois de nouveau Ready."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene isolato, i suoi pod vengono espulsi, poi si riavvia e l’isolamento viene rimosso quando torna Ready."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ буде закордоновано, його поди виселено, потім він перезавантажиться, і кордон знімуть, щойно він знову стане Ready."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 将被禁止调度，其 Pod 被驱逐，然后重启，并在再次 Ready 后恢复调度。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のスケジュールを停止して Pod を退避した後、再起動し、再び Ready になった時点でスケジュールを再開します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ é isolado (cordon), seus pods são removidos, depois ele reinicia e é liberado assim que estiver Ready novamente." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для %@ запрещается планирование, его поды вытесняются, затем он перезагружается, и планирование снова разрешается, когда он станет Ready." } }
      }
    },
    "%@ is cordoned, its pods are evicted, then it shuts down. It stays cordoned and off until someone powers it on." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird abgesperrt, seine Pods werden verdrängt, dann fährt er herunter. Er bleibt abgesperrt und aus, bis ihn jemand einschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se acordona, sus pods se desalojan y luego se apaga. Sigue acordonado y apagado hasta que alguien lo encienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est cordonné, ses pods sont évincés, puis il s’éteint. Il reste cordonné et éteint jusqu’à ce que quelqu’un le rallume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene isolato, i suoi pod vengono espulsi, poi si spegne. Resta isolato e spento finché qualcuno non lo riaccende."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ буде закордоновано, його поди виселено, потім він вимкнеться. Він залишиться закордонованим і вимкненим, доки хтось його не ввімкне."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 将被禁止调度，其 Pod 被驱逐，然后关机。它会保持禁止调度和关机状态，直到有人重新开机。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のスケジュールを停止して Pod を退避した後、シャットダウンします。誰かが電源を入れるまで、スケジュール停止かつ電源オフのままです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ é isolado (cordon), seus pods são removidos e depois ele é desligado. Ele continua isolado e desligado até alguém ligá-lo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для %@ запрещается планирование, его поды вытесняются, затем он выключается. Запрет планирования сохраняется, а узел остаётся выключенным, пока его не включат." } }
      }
    },
    "%@ is cordoned: no new pods are scheduled on it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist abgesperrt: Es werden keine neuen Pods darauf eingeplant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está acordonado: no se programan nuevos pods en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est cordonné : aucun nouveau pod n’y est planifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è isolato: nessun nuovo pod viene pianificato su di esso."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закордоновано: нові поди на ньому не плануються."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 已禁止调度：不会再有新 Pod 调度到其上。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ はスケジュール停止中です。新しい Pod はスケジュールされません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ está isolado (cordon): nenhum pod novo é agendado nele." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для %@ запрещено планирование: новые поды на него не назначаются." } }
      }
    },
    "%@ is drained and stays cordoned" : {
      "extractionState" : "manual",
      "localizations" : {
