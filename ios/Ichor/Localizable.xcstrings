    "It is removed from %@ after its grace period. No controller owns it: it will not come back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird nach seiner Schonfrist aus %@ entfernt. Kein Controller verwaltet ihn: Er kommt nicht zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se retira de %@ tras su periodo de gracia. Ningún controlador lo gestiona: no volverá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est retiré de %@ après son délai de grâce. Aucun contrôleur ne le gère : il ne reviendra pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene rimosso da %@ dopo il periodo di grazia. Nessun controller lo gestisce: non tornerà."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його буде видалено з %@ після пільгового періоду. Жоден контролер ним не керує: він не повернеться."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宽限期结束后，它将从 %@ 中移除。没有控制器管理它：它不会重新出现。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "猶予期間の後に %@ から削除されます。管理するコントローラーがないため、再作成されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ele é removido de %@ após o período de tolerância. Nenhum controlador o gerencia: ele não voltará." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Он будет удалён из %@ по истечении периода ожидания. Им не управляет ни один контроллер: он не вернётся." } }
      }
    },
    "It is removed from %@ after its grace period; %@ starts a new one." : {
