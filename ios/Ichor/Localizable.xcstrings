    "The memory request grows to %@%% of its limit. CAST AI keeps limits as they are, so the pod has little room before it is OOM-killed." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête mémoire atteint %@ %% de sa limite. CAST AI garde les limites telles quelles : le pod a peu de marge avant d'être tué pour manque de mémoire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de memoria llega al %@ %% de su límite. CAST AI mantiene los límites, así que el pod tiene poco margen antes de un OOM kill."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicher-Request steigt auf %@ %% des Limits. CAST AI lässt die Limits unverändert, dem Pod bleibt wenig Luft bis zum OOM-Kill."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta di memoria sale al %@%% del limite. CAST AI mantiene i limiti, quindi il pod ha poco margine prima di un OOM kill."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запит пам'яті зростає до %@%% від ліміту. CAST AI не змінює ліміти, тож поду лишається мало запасу до OOM kill."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内存 request 增加到其 limit 的 %@%%。CAST AI 不会修改 limits，因此该 Pod 在被 OOM 终止前几乎没有余量。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "メモリリクエストがリミットの%@%%まで増加します。CAST AI はリミットを変更しないため、Pod は OOM で強制終了されるまでの余裕がほとんどありません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O request de memória sobe para %@%% do limite. O CAST AI mantém os limites como estão, então o pod tem pouca margem antes de ser encerrado por OOM." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запрос памяти вырастает до %@%% от лимита. CAST AI не меняет лимиты, поэтому у пода остаётся мало запаса до завершения по OOM." } }
      }
