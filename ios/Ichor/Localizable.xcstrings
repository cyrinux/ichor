        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存しても何も実行されません。プランから実行し、破壊的なステップごとに確認します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mantê-lo não executa nada: você o executa a partir do plano, com uma confirmação por etapa destrutiva." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранение ничего не запускает: вы запускаете ранбук из его плана, с подтверждением каждого разрушительного шага." } }
