    "No load balancer controller and no LoadBalancer Service: install MetalLB, turn on Cilium’s LB IPAM, or use kube-vip or a cloud’s load balancer." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun contrôleur de répartition de charge ni Service LoadBalancer : installez MetalLB, activez le LB IPAM de Cilium, ou utilisez kube-vip ou le répartiteur d’un cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún controlador de balanceo de carga ni Service LoadBalancer: instala MetalLB, activa el LB IPAM de Cilium, o usa kube-vip o el balanceador de una nube."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Load-Balancer-Controller und kein LoadBalancer-Service: Installieren Sie MetalLB, aktivieren Sie Ciliums LB IPAM oder nutzen Sie kube-vip oder den Load Balancer einer Cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun controller di bilanciamento né Service LoadBalancer: installa MetalLB, attiva il LB IPAM di Cilium, oppure usa kube-vip o il bilanciatore di un cloud."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає контролера балансування й жодного Service LoadBalancer: встановіть MetalLB, увімкніть LB IPAM у Cilium або скористайтеся kube-vip чи балансувальником хмари."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有负载均衡控制器，也没有 LoadBalancer Service：安装 MetalLB、开启 Cilium 的 LB IPAM，或使用 kube-vip 或云厂商的负载均衡器。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロードバランサーのコントローラーも LoadBalancer Service もありません。MetalLB をインストールするか、Cilium の LB IPAM を有効にするか、kube-vip またはクラウドのロードバランサーを使用してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum controlador de load balancer e nenhum Service LoadBalancer: instale o MetalLB, ative o LB IPAM do Cilium ou use o kube-vip ou o load balancer de um provedor de nuvem." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет контроллера балансировки нагрузки и нет Service типа LoadBalancer: установите MetalLB, включите LB IPAM в Cilium или используйте kube-vip либо облачный балансировщик." } }
      }
    },
