    "Installs during the reboot instead of before it, for nodes whose files in use block the upgrade." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert während des Neustarts statt davor, für Knoten, bei denen belegte Dateien das Upgrade blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala durante el reinicio en lugar de antes, para nodos cuyos archivos en uso bloquean la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe pendant le redémarrage plutôt qu'avant, pour les nœuds dont des fichiers ouverts bloquent la mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa durante il riavvio invece che prima, per i nodi i cui file in uso bloccano l'aggiornamento."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлює під час перезавантаження, а не перед ним, для вузлів, де файли, що використовуються, блокують оновлення."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在重启过程中而非重启前安装，适用于正在使用的文件阻碍升级的节点。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再起動前ではなく再起動中にインストールします。使用中のファイルがアップグレードを妨げるノード向けです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Instala durante a reinicialização em vez de antes, para nós cujos arquivos em uso bloqueiam a atualização." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установка во время перезагрузки, а не до неё — для узлов, у которых используемые файлы блокируют обновление." } }
      }
