        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レジストリにそのイメージまたはタグがありません。名前やタグを修正するか、不足しているタグを公開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O registry não tem essa imagem ou tag: corrija o nome ou a tag, ou publique a tag que falta." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В реестре нет такого образа или тега: исправьте имя или тег либо опубликуйте недостающий тег." } }
      }
    },
    "The registry refused the pull: add or renew the pod's pull secret (imagePullSecrets) for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Registry hat den Pull abgelehnt: Pull-Secret des Pods (imagePullSecrets) hinzufügen oder erneuern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro rechazó la descarga: añade o renueva el secreto de pull del pod (imagePullSecrets)."
