    "Its schedule starts again in %@. Missed runs may start at once, depending on its starting deadline." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Zeitplan läuft in %@ wieder an. Verpasste Läufe können sofort starten, je nach Startfrist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su programación se reanuda en %@. Las ejecuciones perdidas pueden empezar enseguida, según su plazo de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa planification reprend dans %@. Des exécutions manquées peuvent démarrer aussitôt, selon son délai de démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua pianificazione riparte in %@. Le esecuzioni perse possono partire subito, a seconda della scadenza di avvio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його розклад знову діє в %@. Пропущені запуски можуть стартувати одразу, залежно від граничного терміну запуску."
          }
        }
      }
    },
