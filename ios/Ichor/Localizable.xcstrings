    "Nothing recreates them once evicted. Left alone, they keep the node from being fully drained." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Verdrängung erstellt sie nichts neu. Bleiben sie, wird der Knoten nicht vollständig geleert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada los vuelve a crear una vez desalojados. Si se dejan, impiden drenar el nodo por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne les recrée une fois évincés. Laissés en place, ils empêchent de drainer complètement le nœud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta espulsi nulla li ricrea. Se lasciati, impediscono di svuotare completamente il nodo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після виселення їх ніщо не створить знову. Якщо їх залишити, вузол не буде повністю звільнено."
          }
        }
      }
    },
    "PDB %@: %lld allowed" : {
