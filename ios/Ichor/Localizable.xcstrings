        "ja" : { "stringUnit" : { "state" : "translated", "value" : "kubectl rollout restart と同様に、%@ 内の Pod がローリングアップデートで置き換えられます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seus pods em %@ são substituídos com uma atualização gradual, como kubectl rollout restart." } },
