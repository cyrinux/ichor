    "Cores run well below their top speed under the performance governor, or a sensor is above its max." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerne laufen unter dem Governor performance deutlich unter ihrem Höchsttakt, oder ein Sensor liegt über seinem Maximum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay núcleos muy por debajo de su velocidad máxima con el gobernador performance, o un sensor supera su máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des cœurs tournent bien sous leur vitesse maximale avec le gouverneur performance, ou un capteur dépasse son maximum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni core girano ben sotto la velocità massima con il governor performance, o un sensore supera il suo massimo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ядра працюють значно нижче максимальної частоти з регулятором performance, або датчик перевищує свій максимум."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 performance 调速器下，核心运行速度远低于其最高频率，或某个传感器超过其最大值。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "performance ガバナー下でコアが最高速度を大きく下回って動作しているか、センサーが最大値を超えています。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os núcleos rodam bem abaixo da velocidade máxima com o governor performance, ou um sensor está acima do máximo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ядра работают значительно ниже максимальной частоты при governor performance, или датчик превышает свой максимум." } }
