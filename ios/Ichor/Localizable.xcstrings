        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "集群已响应，但拒绝了此 talosconfig：其证书、CA 或角色可能有误或已过期。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラスターは応答しましたが、この talosconfig を拒否しました。証明書、CA、またはロールが誤っているか期限切れの可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O cluster respondeu, mas recusou este talosconfig: o certificado, a CA ou o papel podem estar errados ou expirados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Кластер ответил, но отклонил этот talosconfig: его сертификат, CA или роль, возможно, неверны или истекли." } }
