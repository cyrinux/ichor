      }
    },
    "Import a model file" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Importer un fichier de modèle" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Importar un archivo de modelo" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Імпортувати файл моделі" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modelldatei importieren" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Importa un file di modello" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入模型文件" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデルファイルをインポート" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Importar um arquivo de modelo" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импортировать файл модели" } }
      }
    },
    "The model answers on the phone: nothing is sent. A download starts only when you tap, on Wi-Fi unless you allow mobile data, never in Low Data Mode. A small model is often wrong: check its answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le modèle répond sur le téléphone : rien n’est envoyé. Un téléchargement ne démarre que quand vous appuyez, en Wi-Fi sauf si vous autorisez les données cellulaires, jamais en mode données réduites. Un petit modèle se trompe souvent : vérifiez sa réponse." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El modelo responde en el teléfono: no se envía nada. Una descarga solo empieza cuando tocas, por Wi-Fi salvo que permitas los datos móviles, nunca en el modo de datos reducidos. Un modelo pequeño se equivoca a menudo: comprueba su respuesta." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Модель відповідає на телефоні: нічого не надсилається. Завантаження починається лише після вашого натискання, через Wi-Fi, якщо не дозволено мобільні дані, ніколи в режимі низького трафіку. Мала модель часто помиляється: перевіряйте її відповідь." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Modell antwortet auf dem Telefon: Nichts wird gesendet. Ein Download beginnt nur auf deinen Tipp, über WLAN, außer du erlaubst mobile Daten, nie im Datensparmodus. Ein kleines Modell irrt sich oft: Prüfe seine Antwort." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il modello risponde sul telefono: non viene inviato nulla. Un download parte solo quando tocchi, in Wi-Fi a meno che tu non consenta i dati cellulare, mai in modalità Dati ridotti. Un modello piccolo sbaglia spesso: verifica la sua risposta." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型在手机上作答：不会发送任何数据。只有在你点按后才会开始下载，除非允许使用移动数据，否则仅通过 Wi-Fi 下载，低数据模式下从不下载。小模型经常出错：请核对其回答。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデルはスマートフォン上で応答し、何も送信されません。ダウンロードはタップしたときにのみ開始され、モバイルデータ通信を許可しない限り Wi-Fi 接続時のみ、省データモードでは開始されません。小さなモデルは間違えることが多いため、回答を確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O modelo responde no celular: nada é enviado. Um download só começa quando você toca, no Wi-Fi a menos que permita dados móveis, nunca no Modo Pouco Dados. Um modelo pequeno erra com frequência: confira a resposta." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Модель отвечает прямо на телефоне: ничего не отправляется. Загрузка начинается только по нажатию, по Wi-Fi, если вы не разрешили мобильные данные, и никогда в режиме экономии данных. Маленькая модель часто ошибается: проверяйте её ответ." } }
      }
    },
    "Needs a phone with more memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demande un téléphone avec plus de mémoire" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesita un teléfono con más memoria" } },
