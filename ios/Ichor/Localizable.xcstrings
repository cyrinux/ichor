        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证复制延迟。提升可能导致数据丢失。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レプリケーション遅延を確認できませんでした。昇格するとデータが失われる可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível verificar o atraso de replicação. A promoção pode perder dados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось проверить отставание репликации. При повышении возможна потеря данных." } }
      }
    },
    "Promotion switches the primary and interrupts connections. Data that has not reached the replica may be lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promotion switches the primary and interrupts connections. Data that has not reached the replica may be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La promotion change le primaire et interrompt les connexions. Les données qui n’ont pas atteint la réplique peuvent être perdues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La promoción cambia el primario e interrumpe las conexiones. Los datos que no hayan llegado a la réplica pueden perderse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підвищення змінює основний екземпляр і перериває з’єднання. Дані, що не досягли репліки, можуть бути втрачені."
          }
