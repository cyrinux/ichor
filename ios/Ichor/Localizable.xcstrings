    "The server turns requests away (429): a client sends more than its share." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur refuse des requêtes (429) : un client envoie plus que sa part."
          }
        },
        "es" : {
