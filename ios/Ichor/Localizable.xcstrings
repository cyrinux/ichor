    "An age file opens on a computer with the age command (age -d). Sealed with a passphrase, it also restores in Ichor on iOS or Android." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier age s’ouvre sur un ordinateur avec la commande age (age -d). Chiffré avec une phrase secrète, il se restaure aussi dans Ichor sur iOS ou Android."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo age se abre en un ordenador con el comando age (age -d). Cifrado con una frase de contraseña, también se restaura en Ichor en iOS o Android."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine age-Datei lässt sich auf einem Computer mit dem Befehl age (age -d) öffnen. Mit einer Passphrase verschlüsselt, lässt sie sich auch in Ichor auf iOS oder Android wiederherstellen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file age si apre su un computer con il comando age (age -d). Cifrato con una passphrase, si ripristina anche in Ichor su iOS o Android."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл age відкривається на комп’ютері командою age (age -d). Зашифрований парольною фразою, він також відновлюється в Ichor на iOS або Android."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "age 文件可在电脑上用 age 命令（age -d）打开。若使用密码短语加密，也可在 iOS 或 Android 版 Ichor 中恢复。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "age ファイルはコンピューターで age コマンド（age -d）を使って開けます。パスフレーズで暗号化した場合は、iOS または Android の Ichor でも復元できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um arquivo age é aberto em um computador com o comando age (age -d). Protegido por uma senha, ele também pode ser restaurado no Ichor no iOS ou Android." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Файл age открывается на компьютере командой age (age -d). Если он защищён парольной фразой, его также можно восстановить в Ichor на iOS или Android." } }
      }
    },
    "One age public key (age1…) per line. Only the matching age keys open the file, on a computer: this phone cannot restore it." : {
