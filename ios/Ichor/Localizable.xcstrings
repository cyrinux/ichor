    "Like helm rollback --force: each changed object is written whole, for when a patch cannot bring it back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie helm rollback --force: Jedes geänderte Objekt wird vollständig geschrieben, wenn ein Patch nicht reicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como helm rollback --force: cada objeto cambiado se escribe entero, cuando un parche no basta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme helm rollback --force : chaque objet modifié est réécrit en entier, quand un patch ne suffit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come helm rollback --force: ogni oggetto modificato viene riscritto per intero, quando una patch non basta."
