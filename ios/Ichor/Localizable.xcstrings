          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Ichor 在后台时 Kubernetes 升级会停止。在所有节点完成前保持其打开。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ichor がバックグラウンドにある間、Kubernetes のアップグレードは停止します。すべてのノードが完了するまで開いておいてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A atualização do Kubernetes para enquanto o Ichor está em segundo plano. Mantenha-o aberto até todos os nós serem concluídos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновление Kubernetes останавливается, пока Ichor в фоне. Держите приложение открытым, пока все узлы не будут обработаны." } }
      }
