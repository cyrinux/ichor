    "Skip the Kubernetes cordon/drain, e.g. when the API is down. Pods and services are still stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Kubernetes-Cordon/Drain, z. B. wenn die API ausgefallen ist. Pods und Dienste werden trotzdem gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite el cordon/drain de Kubernetes, por ejemplo cuando la API no responde. Los pods y servicios se detienen igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore le cordon/drain Kubernetes, par exemple quand l'API est en panne. Les pods et les services sont quand même arrêtés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta il cordon/drain di Kubernetes, ad esempio quando l'API non risponde. Pod e servizi vengono comunque arrestati."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропускає cordon/drain Kubernetes, наприклад коли API недоступний. Поди й сервіси все одно зупиняються."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过 Kubernetes 禁止调度/排空，例如在 API 宕机时。Pod 和服务仍会被停止。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Kubernetes のスケジュール停止とドレインをスキップします（API がダウンしている場合など）。Pod とサービスは停止されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pula o cordon/drain do Kubernetes, por exemplo quando a API está fora do ar. Pods e serviços ainda são parados." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пропустить cordon/drain в Kubernetes, например когда API не работает. Поды и сервисы всё равно останавливаются." } }
      }
    },
