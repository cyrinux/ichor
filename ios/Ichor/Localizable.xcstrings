    "A stored config could not be read. Nothing is changed until it can be." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une config enregistrée n'a pas pu être lue. Rien n'est modifié tant qu'elle ne peut pas l'être."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer una configuración guardada. No se cambia nada hasta que se pueda leer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати збережену конфігурацію. Нічого не змінюється, доки її не вдасться прочитати."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gespeicherte Konfiguration konnte nicht gelesen werden. Nichts wird geändert, bis sie lesbar ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere una configurazione salvata. Nulla viene modificato finché non sarà leggibile."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取已保存的配置。在能够读取之前不会做任何更改。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された構成を読み取れませんでした。読み取れるようになるまで何も変更されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ler uma configuração salva. Nada é alterado até que ela possa ser lida." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось прочитать сохранённую конфигурацию. Ничего не изменится, пока её не удастся прочитать." } }
      }
    },
