    "Snapshot %@ of %@ is deleted and its space given back. Backups taken from it stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshot %1$@ of %2$@ is deleted and its space given back. Backups taken from it stay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le snapshot %1$@ de %2$@ est supprimé et son espace libéré. Les sauvegardes faites à partir de lui restent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El snapshot %1$@ de %2$@ se elimina y su espacio se libera. Las copias hechas a partir de él se conservan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshot %1$@ von %2$@ wird gelöscht und sein Speicher freigegeben. Daraus erstellte Backups bleiben erhalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo snapshot %1$@ di %2$@ viene eliminato e il suo spazio liberato. I backup creati da esso restano."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімок %1$@ тому %2$@ буде видалено, а його місце звільнено. Резервні копії з нього залишаться."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%2$@ 的快照 %1$@ 将被删除并释放空间。基于它创建的备份会保留。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%2$@ のスナップショット %1$@ が削除され、その領域が解放されます。そこから作成したバックアップは残ります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O snapshot %1$@ de %2$@ é excluído e o espaço dele é liberado. Os backups feitos a partir dele permanecem." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Снимок %1$@ тома %2$@ будет удалён, а его место освобождено. Сделанные из него резервные копии сохранятся." } }
      }
    },
