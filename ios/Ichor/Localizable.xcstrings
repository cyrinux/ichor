    "Stop pods and services, then reboot (kexec fast reboot when available)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt Pods und Dienste und startet dann neu (schneller kexec-Neustart, falls verfügbar)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene los pods y servicios y luego reinicia (reinicio rápido kexec si está disponible)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête les pods et les services, puis redémarre (redémarrage rapide kexec si disponible)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arresta pod e servizi, poi riavvia (riavvio rapido kexec se disponibile)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиняє поди й сервіси, потім перезавантажує (швидке перезавантаження kexec, якщо доступне)."
          }
        }
      }
    },
    "Stops and starts the service on this node." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
