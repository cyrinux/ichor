    "A draining version waits on a node that is down (%@). Bring it back, or skip it with garage layout skip-dead-nodes." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version en cours de vidage attend un nœud hors service (%@). Remettez-le en marche, ou passez-le avec garage layout skip-dead-nodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versión en drenaje espera a un nodo caído (%@). Recupérelo, o sáltelo con garage layout skip-dead-nodes."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версія, що спорожнюється, чекає на вимкнений вузол (%@). Поверніть його або пропустіть командою garage layout skip-dead-nodes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine auslaufende Version wartet auf einen ausgefallenen Knoten (%@). Holen Sie ihn zurück oder überspringen Sie ihn mit garage layout skip-dead-nodes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una versione in svuotamento attende un nodo fermo (%@). Riportalo in linea, o saltalo con garage layout skip-dead-nodes."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一个正在排空的版本在等待已宕机的节点（%@）。恢复该节点，或使用 garage layout skip-dead-nodes 跳过它。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ドレイン中のバージョンがダウンしているノード（%@）を待っています。ノードを復旧させるか、garage layout skip-dead-nodes でスキップしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma versão em drenagem aguarda um nó que está fora do ar (%@). Traga-o de volta ou pule-o com garage layout skip-dead-nodes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выводимая версия ждёт неработающий узел (%@). Верните его или пропустите через garage layout skip-dead-nodes." } }
      }
    },
