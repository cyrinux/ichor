      }
    },
    "The node reverts by itself unless you keep the change." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud revient en arrière tout seul si vous ne conservez pas la modification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nodo se revierte solo si no conservas el cambio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node setzt sich selbst zurück, wenn du die Änderung nicht behältst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nodo torna indietro da solo se non mantieni la modifica."
          }
        },
        "uk" : {
