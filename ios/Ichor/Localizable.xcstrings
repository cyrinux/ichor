    "MetalLB hands out this pool’s addresses but nothing announces them: add an L2Advertisement or a BGPAdvertisement that selects it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalLB distribue les adresses de ce pool mais rien ne les annonce : ajoutez une L2Advertisement ou une BGPAdvertisement qui le sélectionne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalLB reparte las direcciones de este pool pero nada las anuncia: añade un L2Advertisement o un BGPAdvertisement que lo seleccione."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalLB vergibt die Adressen dieses Pools, aber nichts kündigt sie an: Fügen Sie ein L2Advertisement oder BGPAdvertisement hinzu, das ihn auswählt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalLB assegna gli indirizzi di questo pool ma nulla li annuncia: aggiungi un L2Advertisement o un BGPAdvertisement che lo selezioni."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalLB роздає адреси цього пулу, але ніщо їх не оголошує: додайте L2Advertisement або BGPAdvertisement, що його вибирає."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "MetalLB 分配了此地址池的地址，但没有任何对象通告它们：添加一个选择该地址池的 L2Advertisement 或 BGPAdvertisement。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "MetalLB はこのプールのアドレスを割り当てていますが、アナウンスしているものがありません。このプールを選択する L2Advertisement または BGPAdvertisement を追加してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O MetalLB distribui os endereços deste pool, mas nada os anuncia: adicione um L2Advertisement ou um BGPAdvertisement que o selecione." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "MetalLB выдаёт адреса этого пула, но никто их не анонсирует: добавьте L2Advertisement или BGPAdvertisement, который его выбирает." } }
      }
    },
    "MetalLB refused its configuration" : {
