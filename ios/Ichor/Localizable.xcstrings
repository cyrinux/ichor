    "Argo CD syncs %@ now. Auto-sync stays paused, so the app stays on it until you sync again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argo CD synchronise %@ maintenant. La synchronisation auto reste en pause : l'app y reste jusqu'à votre prochaine synchronisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argo CD sincroniza %@ ahora. La sincronización automática sigue en pausa, así que la app se queda ahí hasta que vuelvas a sincronizar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argo CD зараз синхронізує %@. Автосинхронізація залишається призупиненою, тож застосунок лишається на цій версії, доки ви не синхронізуєте знову."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argo CD synchronisiert jetzt %@. Auto-Sync bleibt pausiert, die App bleibt also dort, bis du erneut synchronisierst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argo CD sincronizza ora %@. La sincronizzazione automatica resta in pausa, quindi l'app resta lì finché non sincronizzi di nuovo."
          }
        }
      }
    },
