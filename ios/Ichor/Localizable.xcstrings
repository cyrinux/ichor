        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復号できるまで、この Kustomization の内容は何も適用されません。spec.decryption.secretRef で指定された Secret に、ファイルの暗号化に使われた age または PGP キーが含まれていることを確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nada nesta Kustomization é aplicado até ela ser descriptografada. Verifique se o Secret indicado em spec.decryption.secretRef contém a chave age ou PGP com a qual os arquivos foram criptografados." } },
