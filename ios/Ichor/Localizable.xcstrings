    "Images share layers, so the total can exceed the disk space they use." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images teilen sich Layer, daher kann die Summe den belegten Speicherplatz übersteigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes comparten capas, así que el total puede superar el espacio en disco que usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images partagent des couches : le total peut dépasser l'espace disque réellement utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini condividono i livelli, quindi il totale può superare lo spazio su disco usato."
