    "Reference: first reachable node of each role. Save a baseline to track changes on the same nodes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reference: first reachable node of each role. Save a baseline to track changes on the same nodes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Référence : premier nœud joignable de chaque rôle. Enregistrez une référence pour suivre les changements sur les mêmes nœuds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referencia: primer nodo accesible de cada rol. Guarda una referencia para seguir los cambios en los mismos nodos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еталон: перший доступний вузол кожної ролі. Збережіть еталон, щоб відстежувати зміни на тих самих вузлах."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referenz: erster erreichbarer Knoten jeder Rolle. Speichern Sie einen Referenzstand, um Änderungen derselben Knoten zu verfolgen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riferimento: primo nodo raggiungibile di ogni ruolo. Salva un riferimento per seguire le modifiche sugli stessi nodi."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参照：每种角色中第一个可访问的节点。保存基线以跟踪同一批节点上的变化。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "基準：各ロールで最初に到達可能なノード。同じノードの変化を追跡するにはベースラインを保存してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Referência: primeiro nó acessível de cada papel. Salve uma referência para acompanhar mudanças nos mesmos nós." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Образец: первый доступный узел каждой роли. Сохраните эталон, чтобы отслеживать изменения на тех же узлах." } }
      }
