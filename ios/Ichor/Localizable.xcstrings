    "This talosconfig lists no address to reach the cluster. Search the networks around the phone for its nodes, or add a node's address." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce talosconfig n'indique aucune adresse pour joindre le cluster. Cherchez ses nœuds sur les réseaux autour du téléphone, ou ajoutez l'adresse d'un nœud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este talosconfig no indica ninguna dirección para llegar al clúster. Busca sus nodos en las redes cercanas al teléfono o añade la dirección de un nodo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей talosconfig не містить адреси для доступу до кластера. Знайдіть його вузли в мережах навколо телефона або додайте адресу вузла."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese talosconfig nennt keine Adresse, um den Cluster zu erreichen. Suche seine Nodes in den Netzwerken um das Telefon oder füge die Adresse eines Nodes hinzu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo talosconfig non indica alcun indirizzo per raggiungere il cluster. Cerca i suoi nodi nelle reti intorno al telefono, o aggiungi l'indirizzo di un nodo."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 talosconfig 未列出可访问集群的地址。在手机周围的网络中搜索其节点，或添加节点地址。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この talosconfig にはクラスターに接続するアドレスが記載されていません。スマートフォン周辺のネットワークでノードを検索するか、ノードのアドレスを追加してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este talosconfig não lista nenhum endereço para acessar o cluster. Procure os nós dele nas redes ao redor do telefone ou adicione o endereço de um nó." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В этом talosconfig нет адреса для доступа к кластеру. Найдите его узлы в сетях вокруг телефона или добавьте адрес узла." } }
