    "A step the cluster refuses would stop the run: let it through with Continue on error to run the rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape refusée par le cluster arrêterait l'exécution : laissez-la passer avec Continuer en cas d'erreur pour exécuter le reste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paso que el clúster rechaza detendría la ejecución: déjalo pasar con Continuar si hay error para ejecutar el resto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schritt, den der Cluster ablehnt, würde den Lauf stoppen: lass ihn mit Bei Fehler fortfahren durch, um den Rest auszuführen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passaggio rifiutato dal cluster fermerebbe l'esecuzione: lascialo passare con Continua in caso di errore per eseguire il resto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крок, який кластер відхиляє, зупинить виконання: пропустіть його через «Продовжити при помилці», щоб виконати решту."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "被集群拒绝的步骤会中止运行：为其开启“出错时继续”即可运行其余步骤。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラスターが拒否したステップがあると実行が停止します。「エラー時に続行」で通過させると、残りを実行できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma etapa recusada pelo cluster interromperia a execução: deixe-a passar com Continuar em caso de erro para executar o restante." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Шаг, который отклонит кластер, остановит выполнение: включите «Продолжать при ошибке», чтобы выполнить остальные." } }
      }
    },
