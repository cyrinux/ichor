          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La promozione cambia il primario e interrompe le connessioni. I dati che non hanno raggiunto la replica possono andare persi."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提升会切换主库并中断连接。尚未同步到副本的数据可能丢失。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "昇格するとプライマリが切り替わり、接続が中断されます。レプリカに届いていないデータは失われる可能性があります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A promoção troca o primário e interrompe as conexões. Dados que não chegaram à réplica podem ser perdidos." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повышение меняет primary и прерывает соединения. Данные, не дошедшие до реплики, могут быть потеряны." } }
