    "Opens the serial console of %@, like virtctl console." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la console série de %@, comme virtctl console."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la consola serie de %@, como virtctl console."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die serielle Konsole von %@, wie virtctl console."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la console seriale di %@, come virtctl console."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває послідовну консоль %@, як virtctl console."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 %@ 的串行控制台，等同于 virtctl console。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "virtctl console と同様に、%@ のシリアルコンソールを開きます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre o console serial de %@, como virtctl console." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает последовательную консоль %@, как virtctl console." } }
      }
    },
    "The guest must send its console to ttyS0 (or hvc0) for anything to show. One viewer at a time: opening it elsewhere disconnects this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invité doit envoyer sa console sur ttyS0 (ou hvc0) pour que quelque chose s’affiche. Un seul spectateur à la fois : l’ouvrir ailleurs déconnecte celui-ci."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El invitado debe enviar su consola a ttyS0 (o hvc0) para que se muestre algo. Un solo espectador a la vez: abrirla en otro lugar desconecta esta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gast muss seine Konsole auf ttyS0 (oder hvc0) ausgeben, damit etwas erscheint. Nur ein Betrachter gleichzeitig: Wird sie anderswo geöffnet, wird diese getrennt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il guest deve inviare la sua console su ttyS0 (o hvc0) perché si veda qualcosa. Un solo utente alla volta: aprirla altrove disconnette questa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гість має виводити консоль на ttyS0 (або hvc0), щоб щось з’явилося. Лише один глядач одночасно: відкриття деінде від’єднує цей."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客户机必须将控制台输出到 ttyS0（或 hvc0）才会显示内容。一次只能有一个查看者：在其他地方打开会断开此连接。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "何か表示させるには、ゲストがコンソールを ttyS0（または hvc0）に出力する必要があります。同時に表示できるのは1人だけで、別の場所で開くとこちらは切断されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O convidado precisa enviar o console para ttyS0 (ou hvc0) para algo aparecer. Um visualizador por vez: abrir em outro lugar desconecta este." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чтобы что-то отображалось, гостевая система должна выводить консоль на ttyS0 (или hvc0). Только один зритель за раз: открытие в другом месте отключит этот." } }
      }
    },
