    "Set a passcode (and optionally Face ID or Touch ID) in the Settings app, then come back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege in den Einstellungen einen Code fest (optional Face ID oder Touch ID) und komm dann zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a passcode (and optionally Face ID or Touch ID) in the Settings app, then come back."
          }
        },
