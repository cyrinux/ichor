        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加密存储在此设备上，并保存在你的加密备份中。建议使用具有只读权限的专用身份。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このデバイス上と暗号化されたバックアップ内に封印して保存されます。読み取り専用アクセスの専用 ID を推奨します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Armazenado de forma selada neste dispositivo e nos seus backups criptografados. Prefira uma identidade dedicada com acesso somente leitura." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хранится в защищённом виде на этом устройстве и в ваших зашифрованных резервных копиях. Лучше используйте отдельную учётную запись с доступом только на чтение." } }
