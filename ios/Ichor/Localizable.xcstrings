          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在排空的布局将不再等待 %@：Garage 会将它们标记为已确认版本 %lld，迁移会在没有它们的情况下继续。此操作无法撤销；仅用于不会再恢复的节点。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ドレイン中のレイアウトは%@の待機をやめます。Garage はそれらのノードがバージョン%lldを確認済みとしてマークし、移行はそれらなしで続行されます。元に戻すことはできません。復旧しないノードにのみ使用してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O layout em drenagem para de aguardar %@: o Garage os marca como tendo confirmado a versão %lld, e a migração continua sem eles. Não há como desfazer; use apenas para nós que não vão voltar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выводимая схема перестаёт ждать %@: Garage отмечает, что они подтвердили версию %lld, и миграция продолжается без них. Отменить это нельзя; используйте только для узлов, которые не вернутся." } }
      }
    },
    "This version offers no model to download. Import a model file (GGUF) instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette version ne propose aucun modèle à télécharger. Importez plutôt un fichier de modèle (GGUF)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta versión no ofrece ningún modelo para descargar. Importa un archivo de modelo (GGUF)." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ця версія не пропонує моделей для завантаження. Натомість імпортуйте файл моделі (GGUF)." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Version bietet kein Modell zum Herunterladen. Importiere stattdessen eine Modelldatei (GGUF)." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Questa versione non offre modelli da scaricare. Importa invece un file di modello (GGUF)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此版本不提供可下载的模型。请改为导入模型文件（GGUF）。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このバージョンにはダウンロードできるモデルがありません。代わりにモデルファイル（GGUF）をインポートしてください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta versão não oferece nenhum modelo para baixar. Em vez disso, importe um arquivo de modelo (GGUF)." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта версия не предлагает моделей для скачивания. Импортируйте файл модели (GGUF)." } }
      }
    },
    "Imported file" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fichier importé" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Archivo importado" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Імпортований файл" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Importierte Datei" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "File importato" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已导入的文件" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "インポートしたファイル" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Arquivo importado" } },
