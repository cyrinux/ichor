          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your talosconfig holds client keys with direct access to your nodes. Ichor keeps them behind the app lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu talosconfig contiene claves de cliente con acceso directo a tus nodos. Ichor las protege con el bloqueo de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre talosconfig contient des clés client qui donnent un accès direct à vos nœuds. Ichor les garde derrière le verrouillage de l'app."
