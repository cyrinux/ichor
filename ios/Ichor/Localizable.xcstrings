    "Tap to run. Commands ending with … are only typed, so you can add the target." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour lancer. Les commandes finissant par … sont seulement tapées, pour ajouter la cible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para ejecutar. Los comandos que terminan en … solo se escriben, para añadir el destino."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться, щоб виконати. Команди з … в кінці лише вводяться, щоб додати ціль."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Ausführen tippen. Befehle mit … am Ende werden nur eingetippt, um das Ziel zu ergänzen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per eseguire. I comandi che finiscono con … vengono solo digitati, per aggiungere la destinazione."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点按即可运行。以 … 结尾的命令只会输入而不执行，以便你添加目标。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "タップして実行します。… で終わるコマンドは入力のみ行われるため、ターゲットを追加できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Toque para executar. Os comandos que terminam com … são apenas digitados, para que você possa adicionar o destino." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нажмите, чтобы выполнить. Команды, оканчивающиеся на …, только вводятся, чтобы вы могли добавить цель." } }
