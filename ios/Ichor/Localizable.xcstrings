    "Checks the images these pods run, by digest, for known vulnerabilities with %@. It runs as a Job in the %@ namespace, which deletes itself afterwards." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the images these pods run, by digest, for known vulnerabilities with %1$@. It runs as a Job in the %2$@ namespace, which deletes itself afterwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les vulnérabilités connues des images de ces pods, par digest, avec %1$@. Il tourne en Job dans le namespace %2$@ et se supprime ensuite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca vulnerabilidades conocidas en las imágenes de estos pods, por digest, con %1$@. Se ejecuta como Job en el namespace %2$@ y luego se elimina."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die Images dieser Pods per Digest mit %1$@ auf bekannte Schwachstellen. Läuft als Job im Namespace %2$@, der sich danach selbst löscht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca vulnerabilità note nelle immagini di questi pod, per digest, con %1$@. Gira come Job nel namespace %2$@ e poi si elimina."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє образи цих подів (за digest) на відомі вразливості за допомогою %1$@. Запускається як Job у просторі імен %2$@ і потім видаляє себе."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 %1$@ 按摘要检查这些 Pod 所运行镜像中的已知漏洞。它以 Job 形式在 %2$@ 命名空间中运行，完成后自动删除。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@を使い、これらの Pod が実行するイメージをダイジェスト単位で既知の脆弱性についてチェックします。%2$@名前空間で Job として実行され、終了後に自動で削除されます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verifica vulnerabilidades conhecidas nas imagens que estes pods executam, por digest, com %1$@. Roda como um Job no namespace %2$@, que se exclui depois." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверяет образы этих подов (по digest) на известные уязвимости с помощью %1$@. Запускается как Job в пространстве имён %2$@ и затем удаляет себя." } }
      }
    },
