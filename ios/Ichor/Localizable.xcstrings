        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approchez une YubiKey ou une autre clé FIDO2 de l’iPhone, ou branchez-la, pour ouvrir Ichor sans Face ID. Jusqu’à deux clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvicina una YubiKey o un’altra chiave FIDO2 all’iPhone, oppure collegala, per aprire Ichor senza Face ID. Fino a due chiavi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться YubiKey або іншим ключем FIDO2 iPhone чи підключіть його, щоб відкривати Ichor без Face ID. До двох ключів."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将 YubiKey 或其他 FIDO2 密钥轻触 iPhone 或插入，即可不用 Face ID 打开 Ichor。最多两个密钥。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey などの FIDO2 キーを iPhone にタッチするか接続すると、Face ID なしで Ichor を開けます。キーは2個まで登録できます。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aproxime uma YubiKey ou outra chave FIDO2 do iPhone, ou conecte-a, para abrir o Ichor sem Face ID. Até duas chaves." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Приложите YubiKey или другой ключ FIDO2 к iPhone или подключите его, чтобы открывать Ichor без Face ID. Не более двух ключей." } }
      }
    },
