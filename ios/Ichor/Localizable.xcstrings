    "Node debug shell" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell de débogage des nœuds"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell de depuración de nodos"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налагоджувальна оболонка вузла"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug-Shell für Knoten"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell di debug dei nodi"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点调试 Shell" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードのデバッグシェル" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Shell de depuração do nó" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отладочная оболочка узла" } }
      }
    },
    "On clusters without Talos, adds “Debug shell…” to a node’s menu: a privileged pod in the node’s namespaces gives a root shell on the node. The pod is deleted when the shell closes. Off by default." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur les clusters sans Talos, ajoute « Shell de débogage… » au menu d’un nœud : un pod privilégié dans les namespaces du nœud donne un shell root sur le nœud. Le pod est supprimé à la fermeture du shell. Désactivé par défaut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En clústeres sin Talos, añade «Shell de depuración…» al menú de un nodo: un pod privilegiado en los namespaces del nodo da una shell root en el nodo. El pod se borra al cerrar la shell. Desactivado por defecto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На кластерах без Talos додає «Налагоджувальна оболонка…» до меню вузла: привілейований под у просторах імен вузла дає root-оболонку на вузлі. Под видаляється, коли оболонку закрито. Вимкнено за замовчуванням."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Clustern ohne Talos fügt dies „Debug-Shell…“ zum Menü eines Knotens hinzu: Ein privilegierter Pod in den Namespaces des Knotens gibt eine Root-Shell auf dem Knoten. Der Pod wird beim Schließen der Shell gelöscht. Standardmäßig aus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sui cluster senza Talos, aggiunge «Shell di debug…» al menu di un nodo: un pod privilegiato nei namespace del nodo dà una shell root sul nodo. Il pod viene eliminato alla chiusura della shell. Disattivato per impostazione predefinita."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在非 Talos 集群上，为节点菜单添加“调试 Shell…”：在节点命名空间中运行的特权 Pod 可提供该节点的 root Shell。Shell 关闭时 Pod 会被删除。默认关闭。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Talos 以外のクラスターで、ノードのメニューに「デバッグシェル…」を追加します。ノードの名前空間内で動く特権 Pod により、ノード上の root シェルを利用できます。シェルを閉じると Pod は削除されます。デフォルトはオフです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Em clusters sem Talos, adiciona “Shell de depuração…” ao menu de um nó: um pod privilegiado nos namespaces do nó oferece um shell root no nó. O pod é excluído quando o shell é fechado. Desativado por padrão." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В кластерах без Talos добавляет «Отладочная оболочка…» в меню узла: привилегированный под в пространствах имён узла даёт root-оболочку на узле. Под удаляется при закрытии оболочки. По умолчанию выключено." } }
      }
    },
    "Debug shell…" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
