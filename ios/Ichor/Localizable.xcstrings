        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cancelar a atualização do Kubernetes?" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отменить обновление Kubernetes?" } }
      }
    },
    "It stops after the node being changed, which is finished and waited for. The nodes done keep the new version; start again later to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s'arrête après le nœud en cours de modification, qui est terminé et attendu. Les nœuds faits gardent la nouvelle version ; relancez plus tard pour continuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene tras el nodo que se está cambiando, que termina y se espera. Los nodos hechos conservan la nueva versión; vuelve a empezar más tarde para continuar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hält nach dem Node an, der gerade geändert wird; dieser wird fertig und abgewartet. Fertige Nodes behalten die neue Version; starte später erneut, um weiterzumachen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma dopo il nodo in corso di modifica, che viene completato e atteso. I nodi fatti mantengono la nuova versione; ricomincia più tardi per continuare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиняється після вузла, що змінюється: його буде завершено й дочекано. Готові вузли зберігають нову версію; почніть знову пізніше, щоб продовжити."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将在当前正在变更的节点完成并等待其就绪后停止。已完成的节点保留新版本；稍后重新开始即可继续。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "変更中のノードの処理が完了するのを待ってから停止します。完了したノードは新しいバージョンのままです。続けるには後で再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ela para depois do nó em alteração, que é concluído e aguardado. Os nós já feitos mantêm a nova versão; inicie de novo mais tarde para continuar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановка произойдёт после текущего узла: его изменение завершится, и приложение дождётся его готовности. Уже обработанные узлы сохранят новую версию; запустите снова позже, чтобы продолжить." } }
      }
    },
