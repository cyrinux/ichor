        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "2. 用其令牌和当前上下文的服务器生成 kubeconfig-phone：" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "2. 現在のコンテキストのサーバーを使い、そのトークンから kubeconfig-phone を作成します：" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "2. Gere o kubeconfig-phone a partir do token, com o servidor do seu contexto atual:" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "2. Соберите kubeconfig-phone из его токена с сервером вашего текущего контекста:" } }
      }
    },
    "3. Bring kubeconfig-phone to the phone and import it, then delete the other copies: the token is a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Bring kubeconfig-phone aufs Telefon und importiere es, lösche dann die anderen Kopien: Das Token ist ein Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Lleva kubeconfig-phone al teléfono e impórtalo, luego borra las demás copias: el token es una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Transférez kubeconfig-phone sur le téléphone et importez-le, puis supprimez les autres copies : le jeton est un mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Porta kubeconfig-phone sul telefono e importalo, poi elimina le altre copie: il token è una password."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Перенесіть kubeconfig-phone на телефон та імпортуйте його, потім видаліть інші копії: токен — це пароль."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3. 将 kubeconfig-phone 传到手机并导入，然后删除其他副本：令牌相当于密码。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "3. kubeconfig-phone をスマートフォンに転送してインポートし、他のコピーは削除します。トークンはパスワードと同じです。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "3. Leve o kubeconfig-phone para o telefone e importe-o; depois exclua as outras cópias: o token é uma senha." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "3. Перенесите kubeconfig-phone на телефон и импортируйте его, затем удалите остальные копии: токен — это пароль." } }
      }
    },
    "KEDA scales %@ to 0: every pod stops, and nothing serves until you resume." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA skaliert %@ auf 0: jeder Pod stoppt, und nichts antwortet, bis Sie fortsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA escala %@ a 0: todos los pods se detienen y nada responde hasta que lo reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA ramène %@ à 0 : chaque pod s’arrête, et rien ne répond jusqu’à la reprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA porta %@ a 0: ogni pod si ferma e nulla risponde finché non riprendi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEDA масштабує %@ до 0: кожен под зупиняється, і ніщо не відповідає, доки ви не відновите."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "KEDA 将 %@ 缩容到 0：所有 Pod 都会停止，恢复之前不提供任何服务。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "KEDA が %@ を0にスケールします。すべての Pod が停止し、再開するまでサービスは提供されません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O KEDA escala %@ para 0: todos os pods param e nada responde até você retomar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "KEDA масштабирует %@ до 0: все поды остановятся, и ничего не будет обслуживаться, пока вы не возобновите работу." } }
      }
    },
