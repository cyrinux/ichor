    "It stops before the next node: a node being upgraded finishes first. The nodes upgraded stay upgraded; start again later to continue with the others." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s'arrête avant le nœud suivant : un nœud en cours de mise à jour termine d'abord. Les nœuds mis à jour le restent ; relancez plus tard pour continuer avec les autres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene antes del siguiente nodo: un nodo en actualización termina primero. Los nodos actualizados siguen así; vuelve a empezar más tarde para continuar con los demás."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hält vor dem nächsten Node an: Ein Node im Update wird zuerst fertig. Aktualisierte Nodes bleiben aktualisiert; starte später erneut, um mit den anderen weiterzumachen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma prima del nodo successivo: un nodo in aggiornamento termina prima. I nodi aggiornati restano tali; ricomincia più tardi per continuare con gli altri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиняється перед наступним вузлом: вузол, що оновлюється, спершу завершить. Оновлені вузли такими й залишаться; почніть знову пізніше, щоб продовжити з іншими."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将在下一个节点前停止：正在升级的节点会先完成。已升级的节点保持升级状态；稍后重新开始即可继续升级其余节点。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のノードの前で停止します。アップグレード中のノードは先に完了します。アップグレード済みのノードはそのままです。残りを続けるには後で再開してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ela para antes do próximo nó: um nó em atualização termina primeiro. Os nós atualizados continuam atualizados; inicie de novo mais tarde para continuar com os outros." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановка произойдёт перед следующим узлом: обновляемый узел сначала завершит обновление. Обновлённые узлы останутся обновлёнными; запустите снова позже, чтобы продолжить с остальными." } }
      }
    },
