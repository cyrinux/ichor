    "Serves the network boot (DHCP proxy and TFTP) from a Linux machine of the same network. Then power on the new machine with network boot." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert le démarrage réseau (proxy DHCP et TFTP) depuis une machine Linux du même réseau. Allumez ensuite la nouvelle machine en démarrage réseau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve el arranque por red (proxy DHCP y TFTP) desde una máquina Linux de la misma red. Luego enciende la máquina nueva con arranque por red."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt den Netzwerkstart (DHCP-Proxy und TFTP) von einem Linux-Rechner im selben Netz bereit. Dann die neue Maschine per Netzwerkstart einschalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve l'avvio di rete (proxy DHCP e TFTP) da una macchina Linux della stessa rete. Poi accendi la nuova macchina con avvio di rete."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Роздає мережеве завантаження (DHCP-проксі та TFTP) з Linux-машини в тій самій мережі. Потім увімкніть нову машину з мережевим завантаженням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从同一网络中的 Linux 机器提供网络启动（DHCP 代理和 TFTP）。然后以网络启动方式开启新机器。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じネットワーク上の Linux マシンからネットワークブート（DHCP プロキシと TFTP）を提供します。その後、新しいマシンをネットワークブートで起動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a inicialização pela rede (proxy DHCP e TFTP) a partir de uma máquina Linux da mesma rede. Depois ligue a nova máquina com inicialização pela rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздаёт сетевую загрузку (DHCP-прокси и TFTP) с Linux-машины в той же сети. Затем включите новую машину с сетевой загрузкой."
          }
        }
      }
    },
