        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロードバランサーにアドレスがありません。kube-vip の kubevip ConfigMap（cidr-global、または名前空間用の範囲）と、kube-vip が実行中であることを確認してください。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um load balancer está sem endereço: verifique a ConfigMap kubevip do kube-vip (cidr-global ou um intervalo para o namespace dele) e se o kube-vip está em execução." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У балансировщика нагрузки нет адреса: проверьте ConfigMap kubevip в kube-vip (cidr-global или диапазон для его пространства имён) и что kube-vip запущен." } }
