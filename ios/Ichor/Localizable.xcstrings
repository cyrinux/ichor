        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Негайне перезавантаження: поди й сервіси НЕ зупиняються. Лише для вузла, що завис."
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即重启：不会停止 Pod 和服务。仅用于卡住的节点。" } },
